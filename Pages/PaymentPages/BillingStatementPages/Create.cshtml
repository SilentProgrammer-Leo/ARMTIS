@page
@model ARMTIS_Capstone_Project.Pages.BillingStatementPages.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<div class="billing-container">
    <div class="billing-card">
        <h2 class="title">Create Billing Statement</h2>

        <form method="post">
             <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="col-md-6 mb-3">
                <label asp-for="BillingStatement.UnitID"></label>

                <select asp-for="BillingStatement.UnitID"
                        asp-items="ViewBag.UnitID"
                        class="form-control"
                        id="UnitID">
                    <option value="">-- Select Unit --</option>
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label>Tenant Name</label>

                <input id="TenantName"
                       class="form-control"
                       readonly />
            </div>
            <input asp-for="BillingStatement.TenantID" type="hidden" />
            <div class="col-md-6 mb-3">
                <span class="text-danger">*</span>
                <label asp-for="BillingStatement.BillingNo" class="control-label"></label>
                <input asp-for="BillingStatement.BillingNo" class="form-control auto-field" readonly aria-required="true"/>
                <span asp-validation-for="BillingStatement.BillingNo" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <span class="text-danger">*</span>
                <label asp-for="BillingStatement.BillingMonth" class="control-label"></label>
                <input asp-for="BillingStatement.BillingMonth" class="form-control auto-field" aria-required="true"/>
                <span asp-validation-for="BillingStatement.BillingMonth" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <span class="text-danger">*</span>
                <label asp-for="BillingStatement.DueDate" class="control-label"></label>
                <input asp-for="BillingStatement.DueDate" class="form-control auto-field" readonly aria-required="true"/>
                <span asp-validation-for="BillingStatement.DueDate" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <span class="text-danger">*</span>
                <label asp-for="BillingStatement.MonthlyRent" class="control-label"></label>
                <input asp-for="BillingStatement.MonthlyRent"  class="form-control auto-field" readonly aria-required="true"/>
                <span asp-validation-for="BillingStatement.MonthlyRent" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="BillingStatement.PenaltyAmount" class="control-label"></label>
                <input asp-for="BillingStatement.PenaltyAmount" class="form-control" />
                <span asp-validation-for="BillingStatement.PenaltyAmount" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="BillingStatement.UtilityCharges" class="control-label"></label>
                <input asp-for="BillingStatement.UtilityCharges" class="form-control" />
                <span asp-validation-for="BillingStatement.UtilityCharges" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <span class="text-danger">*</span>
                <label asp-for="BillingStatement.TotalAmountDue" class="control-label"></label>
                <input asp-for="BillingStatement.TotalAmountDue" class="form-control auto-field" readonly aria-required="true"/>
                <span asp-validation-for="BillingStatement.TotalAmountDue" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <span class="text-danger">*</span>
                <label asp-for="BillingStatement.BillingStatus" class="control-label"></label>
                <input asp-for="BillingStatement.BillingStatus" class="form-control auto-field" readonly aria-required="true"/>
                <span asp-validation-for="BillingStatement.BillingStatus" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="BillingStatement.Remarks" class="control-label"></label>
                <input asp-for="BillingStatement.Remarks" class="form-control" />
                <span asp-validation-for="BillingStatement.Remarks" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="BillingStatement.DateGenerated" class="control-label"></label>
                <input asp-for="BillingStatement.DateGenerated" class="form-control auto-field" readonly />
                <span asp-validation-for="BillingStatement.DateGenerated" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>      
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>
@section Scripts{
@{
    <partial name="_ValidationScriptsPartial" />
}

    <script>
        document.getElementById("UnitID").addEventListener("change", async function() {

            const unitId = this.value;

            if (!unitId)
                return;

            const response = await fetch(`?handler=UnitInfo&unitId=${unitId}`);

            const data = await response.json();

            document.getElementById("TenantName").value = data.tenantName;

            document.getElementById("BillingStatement_TenantID").value = data.tenantID;

            document.getElementById("BillingStatement_BillingMonth").value = data.billingMonth;

            document.getElementById("BillingStatement_DueDate").value = data.dueDate;

            document.getElementById("BillingStatement_MonthlyRent").value = data.monthlyRent;

            calculateTotal();
        });

        function calculateTotal() {

            const rent = parseFloat(document.getElementById("BillingStatement_MonthlyRent").value) || 0;

            const utility = parseFloat(document.getElementById("BillingStatement_UtilityCharges").value) || 0;

            const penalty = parseFloat(document.getElementById("BillingStatement_PenaltyAmount").value) || 0;

            document.getElementById("BillingStatement_TotalAmountDue").value =
                (rent + utility + penalty).toFixed(2);
        }

        document.getElementById("BillingStatement_UtilityCharges")
            .addEventListener("input", calculateTotal);

        document.getElementById("BillingStatement_PenaltyAmount")
            .addEventListener("input", calculateTotal);
    </script>
}

