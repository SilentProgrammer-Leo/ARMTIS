@page
@model ARMTIS_Capstone_Project.Pages.PaymentPages.BillingStatementPages.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>BillingStatement</h4>
<hr />
<div class="row">
    <div class="col-md-4">
