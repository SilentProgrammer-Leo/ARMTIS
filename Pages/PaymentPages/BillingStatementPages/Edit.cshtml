                <label asp-for="BillingStatement.TenantID" class="control-label"></label>
                <input asp-for="BillingStatement.TenantID" class="form-control" aria-required="true"/>
                <span asp-validation-for="BillingStatement.TenantID" class="text-danger"></span>
            </div>

            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="BillingStatement.BillingNo" class="control-label"></label>
