@page
@model ARMTIS_Capstone_Project.Pages.PaymentPages.BillingStatementPages.GenerateModel
@{
}

<form method="get" class="row mb-4">

    <div class="col-md-3">
        <label class="form-label">Month</label>


        <select asp-for="SelectedMonth"
                class="form-select"
                required>

            <option value="">-- Select Month --</option>

            @for (int month = 1; month <= 12; month++)
            {
                <option value="@month">
                    @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)
                </option>
            }
        </select>
    </div>

    <div class="col-md-3">
        <label class="form-label">Year</label>

        <select asp-for="SelectedYear"
                class="form-select"
                required>

            <option value="">-- Select Year --</option>

            @for (int year = DateTime.Now.Year - 2;
                 year <= DateTime.Now.Year + 5;
                 year++)
            {
                <option value="@year">@year</option>
            }
        </select>
    </div>

    <div class="col-md-3 d-flex align-items-end">
        <button type="submit" class="btn btn-primary">
            Load Billing
        </button>
    </div>

   <div class="col-md-3 d-flex align-items-end">
    <a asp-page="/UtilityReadingPages/Index" class="btn btn-primary">
        Add Utility Charges
    </a>
    </div>

</form>

@if (Model.Bills.Any())
{
    <form method="post"
          asp-page-handler="GenerateAll"
          id="generateAllForm">

        <input type="hidden"
               name="selectedMonth"
               value="@Model.SelectedMonth" />

        <input type="hidden"
               name="selectedYear"
               value="@Model.SelectedYear" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Unit</th>
                    <th>Tenant</th>
                    <th>Monthly Rent</th>
                    <th>Utilities</th>
                    <th>Total Preview</th>
                    <th>Utility Status</th>
                    <th>Billing Status</th>
                </tr>
            </thead>

            <tbody>
                @if (!Model.Bills.Any())
                {
                    <tr>
                        <td colspan="7"
                            class="text-center">

                            Select a month and year,
                            then click Load Billing.

                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model.Bills)
                    {
                        <tr>
                            <td>
                                @item.UnitNumber
                            </td>

                            <td>
                                @item.TenantName
                            </td>

                            <td>
                                ₱@item.MonthlyRent.ToString("N2")
                            </td>

                            <td>
                                ₱@item.UtilityTotal.ToString("N2")
                            </td>

                            <td>
                                ₱@((item.MonthlyRent + item.UtilityTotal).ToString("N2"))
                            </td>

                            <td>
                                @if (item.HasUtilityReading)
                                {
                                    <span class="badge bg-success">
                                        Ready
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Missing
                                    </span>
                                }
                            </td>

                            <td>
                                @if (item.BillingAlreadyExists)
                                {
                                    <span class="badge bg-secondary">
                                        Already Generated
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Not Generated
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div class="text-end">
            <button type="submit"
                    class="btn btn-success"
                    onclick="return confirm(
                'Generate billing statements for all listed tenants?');">

                <i class="bi bi-receipt"></i>
                Generate All Billing Statements
            </button>
        </div>
    </form>
}
else if (Model.SelectedMonth.HasValue &&
         Model.SelectedYear.HasValue)
{
    <div class="alert alert-info">
        No active tenants were found for the selected billing period.
    </div>
}
else
{
    <div class="alert alert-secondary">
        Select a month and year, then click
        <strong>Load Billing</strong>.
    </div>
}

<div class="modal fade"
     id="utilityModal"
     tabindex="-1"
     aria-labelledby="utilityModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title"
                    id="utilityModalLabel">
                    Utility Charges
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="SelectedRowIndex" />

                <div class="mb-3">
                    <label class="form-label">Unit</label>
                    <input id="ModalUnitNumber"
                           class="form-control"
                           readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">Tenant</label>
                    <input id="ModalTenantName"
                           class="form-control"
                           readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">Electricity</label>
                    <input id="ModalElectricity"
                           type="number"
                           min="0"
                           step="0.01"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Water</label>
                    <input id="ModalWater"
                           type="number"
                           min="0"
                           step="0.01"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Internet</label>
                    <input id="ModalInternet"
                           type="number"
                           min="0"
                           step="0.01"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Total Utilities
                    </label>

                    <input id="ModalUtilityTotal"
                           class="form-control"
                           readonly />
                </div>

            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-primary"
                        id="saveUtility">
                    Save Utilities
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {

            const modalElement =
                document.getElementById("utilityModal");

            const utilityModal =
                new bootstrap.Modal(modalElement);

            const electricityInput =
                document.getElementById("ModalElectricity");

            const waterInput =
                document.getElementById("ModalWater");

            const internetInput =
                document.getElementById("ModalInternet");

            const totalInput =
                document.getElementById("ModalUtilityTotal");

            function calculateUtilityTotal() {
                const electricity =
                    parseFloat(electricityInput.value) || 0;

                const water =
                    parseFloat(waterInput.value) || 0;

                const internet =
                    parseFloat(internetInput.value) || 0;

                totalInput.value =
                    (electricity + water + internet).toFixed(2);
            }

            document.querySelectorAll(".utilityBtn")
                .forEach(button => {

                    button.addEventListener("click", function() {

                        const index = this.dataset.index;

                        document.getElementById(
                            "SelectedRowIndex").value = index;

                        document.getElementById(
                            "ModalUnitNumber").value =
                            this.dataset.unit;

                        document.getElementById(
                            "ModalTenantName").value =
                            this.dataset.tenant;

                        // Load previously entered values.
                        electricityInput.value =
                            document.getElementById(
                                `Electricity-${index}`).value || "";

                        waterInput.value =
                            document.getElementById(
                                `Water-${index}`).value || "";

                        internetInput.value =
                            document.getElementById(
                                `Internet-${index}`).value || "";

                        calculateUtilityTotal();

                        utilityModal.show();
                    });
                });

            electricityInput.addEventListener(
                "input",
                calculateUtilityTotal);

            waterInput.addEventListener(
                "input",
                calculateUtilityTotal);

            internetInput.addEventListener(
                "input",
                calculateUtilityTotal);

            document.getElementById("saveUtility")
                .addEventListener("click", function() {

                    const index =
                        document.getElementById(
                            "SelectedRowIndex").value;

                    document.getElementById(
                        `Electricity-${index}`).value =
                        parseFloat(electricityInput.value) || 0;

                    document.getElementById(
                        `Water-${index}`).value =
                        parseFloat(waterInput.value) || 0;

                    document.getElementById(
                        `Internet-${index}`).value =
                        parseFloat(internetInput.value) || 0;

                    const status =
                        document.getElementById(
                            `utilityStatus-${index}`);

                    status.textContent =
                        `₱${totalInput.value}`;

                    status.classList.remove("bg-secondary");
                    status.classList.add("bg-success");

                    utilityModal.hide();
                });
        });
    </script>
}