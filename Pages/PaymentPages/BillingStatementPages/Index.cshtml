@page
@model ARMTIS_Capstone_Project.Pages.BillingStatementPages.IndexModel

@{
    ViewData["Title"] = "Billing Statement";
}

<h1>Billing Statements</h1>

    <p>
        <a asp-page="/PaymentPages/BillingStatementPages/Generate" class="btn btn-success">
        <i class="bi bi-receipt"></i>
        Generate Billing
            </a>
    </p>
    @if (TempData["SuccessMessage"] != null) 
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }
    <form id="antiForgeryForm" class="d-none">
        @Html.AntiForgeryToken()
    </form>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Unit</th>
            <th>Tenant</th>
             <th>Billing Month</th>
            @* <th>Total Amount Due</th> *@
            <th>Due Date</th>
            @* <th>Penalty</th> *@
            <th>Status</th>
            <th>Billing Statement</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.BillingStatement)
        {
             var utility =
             Model.UtilityReadingsByBillingId
            .GetValueOrDefault(item.BillingStatementID);

            <tr class="@(item.BillingStatus == "Overdue" ? "table-danger" : "")">

                <!-- UNIT -->
                <td>
                    @(item.Unit?.UnitNumber ?? "N/A")
                </td>


                <!-- TENANT -->
                <td>
                    @if (item.Tenant != null)
                    {
                        @($"{item.Tenant.FirstName} {item.Tenant.LastName}")
                    }
                    else
                    {
                        <span>N/A</span>
                    }
                </td>

                <!-- BILLING MONTH-->
                <td>
                    <span class="badge bg-primary">
                        @item.BillingMonth.ToString("MMMM yyyy")
                    </span> 
                </td>   

                @* <!-- TOTAL AMOUNT DUE -->
                <td class="fw-bold">
                    ₱@item.TotalAmountDue.ToString("N2")
                </td> *@


                <!-- DUE DATE -->
                <td>
                    @item.DueDate.ToString("MMMM dd, yyyy")
                </td>


               @*  <!-- PENALTY -->
                <td>
                    @if (item.PenaltyAmount > 0)
                    {
                        <span class="text-danger fw-bold">
                            ₱@item.PenaltyAmount.ToString("N2")
                        </span>
                    }
                    else
                    {
                        <span>₱0.00</span>
                    }
                </td> *@


                <!-- STATUS -->
                <td>
                    @if (item.BillingStatus == "Paid")
                    {
                        <span class="badge bg-success">
                            Paid
                        </span>
                    }
                    else if (item.BillingStatus == "Overdue")
                    {
                        <span class="badge bg-danger">
                            Overdue
                        </span>
                    }
                    else if (item.BillingStatus == "Unpaid")
                    {
                        <span class="badge bg-warning text-dark">
                            Unpaid
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">
                            Pending
                        </span>
                    }
                </td>


                <!-- VIEW BILLING STATEMENT -->
                <td>
                    <button type="button"
                            class="btn btn-outline-success btn-sm viewBillingBtn"
                            data-billingid="@item.BillingStatementID"
                            data-billingno="@item.BillingNo"
                            data-tenant="@(item.Tenant != null
                                        ? item.Tenant.FirstName + " " + item.Tenant.LastName
                                        : "N/A")"
                            data-unit="@(item.Unit?.UnitNumber ?? "N/A")"
                            data-billingmonth="@item.BillingMonth.ToString("MMMM yyyy")"
                            data-duedate="@item.DueDate.ToString("MMMM dd, yyyy")"
                            data-monthlyrent="@item.MonthlyRent.ToString(
                                        "0.00",
                                        System.Globalization.CultureInfo.InvariantCulture
                                    )"
                            data-previouselectric="@(utility?.PreviousElectricReading.ToString(
                                        "0.00",
                                        System.Globalization.CultureInfo.InvariantCulture
                                    ) ?? "0.00")"
                            data-currentelectric="@(utility?.CurrentElectricReading.ToString(
                                        "0.00",
                                        System.Globalization.CultureInfo.InvariantCulture
                                    ) ?? "0.00")"
                            data-electricconsumption="@(utility?.ElectricConsumption.ToString(
                                        "0.00",
                                        System.Globalization.CultureInfo.InvariantCulture
                                    ) ?? "0.00")"
                            data-electricrate="@(utility?.ElectricRate.ToString(
                                        "0.00",
                                        System.Globalization.CultureInfo.InvariantCulture
                                    ) ?? "0.00")"
                            data-previouswater="@(utility?.PreviousWaterReading.ToString(
                                        "0.00",
                                        System.Globalization.CultureInfo.InvariantCulture
                                    ) ?? "0.00")"
                            data-currentwater="@(utility?.CurrentWaterReading.ToString(
                                        "0.00",
                                        System.Globalization.CultureInfo.InvariantCulture
                                    ) ?? "0.00")"
                            data-waterconsumption="@(utility?.WaterConsumption.ToString(
                                        "0.00",
                                        System.Globalization.CultureInfo.InvariantCulture
                                    ) ?? "0.00")"
                            data-waterrate="@(utility?.WaterRate.ToString(
                                                                "0.00",
                                                                System.Globalization.CultureInfo.InvariantCulture
                                                            ) ?? "0.00")"
                            data-water="@item.Water.ToString(
                                        "0.00",
                                        System.Globalization.CultureInfo.InvariantCulture
                                    )"
                            data-electricity="@item.Electricity.ToString(
                                        "0.00",
                                        System.Globalization.CultureInfo.InvariantCulture
                                    )"
                            data-internet="@item.Internet.ToString(
                                        "0.00",
                                        System.Globalization.CultureInfo.InvariantCulture
                                    )"
                            data-utilities="@item.UtilityCharges.ToString(
                                        "0.00",
                                        System.Globalization.CultureInfo.InvariantCulture
                                    )"
                            data-penalty="@item.PenaltyAmount.ToString(
                                        "0.00",
                                        System.Globalization.CultureInfo.InvariantCulture
                                    )"
                            data-total="@item.TotalAmountDue.ToString(
                                        "0.00",
                                        System.Globalization.CultureInfo.InvariantCulture
                                    )"
                            data-status="@item.BillingStatus"
                            data-remarks="@(item.Remarks ?? "None")"
                            data-generated="@item.DateGenerated.ToString("MMMM dd, yyyy")">

                        <i class="bi bi-receipt"></i>
                        View

                    </button>
                </td>


                <!-- ACTIONS -->
                <td>
                    <div class="d-flex flex-wrap gap-1">

                        @if (item.BillingStatus != "Paid")
                        {
                            <!-- RECORD PAYMENT -->
                            <button type="button"
                                    class="btn btn-success btn-sm paymentBtn"
                                    data-billingid="@item.BillingStatementID"
                                    data-billingno="@item.BillingNo"
                                    data-tenantid="@item.TenantID"
                                    data-tenant="@(item.Tenant != null
                                                                    ? item.Tenant.FirstName + " " + item.Tenant.LastName
                                                                    : "N/A")"
                                    data-total="@item.TotalAmountDue.ToString(
                                                                    "0.00",
                                                                    System.Globalization.CultureInfo.InvariantCulture
                                                                )"
                                    data-penalty="@item.PenaltyAmount.ToString(
                                                                    "0.00",
                                                                    System.Globalization.CultureInfo.InvariantCulture
                                                                )"
                                    data-status="@item.BillingStatus">

                                <i class="bi bi-cash-stack"></i>
                                Record Payment
                            </button>
                        }


                        @if (item.BillingStatus == "Paid" || item.BillingStatus == "Partially Paid")
                        {
                            <button type="button"
                                    class="btn btn-outline-primary btn-sm viewPaymentBtn"
                                    data-billingid="@item.BillingStatementID"
                                    data-billingno="@item.BillingNo">

                                <i class="bi bi-eye"></i>
                                View Payment

                            </button>
                        }


                        <!-- DELETE -->
                        <a asp-page="./Delete"
                           asp-route-billingstatementid="@item.BillingStatementID"
                           class="btn btn-outline-danger btn-sm">

                            <i class="bi bi-trash"></i>
                            Delete
                        </a>

                    </div>
                </td>

            </tr>
        }
    </tbody>
</table>

@* Billing Statement Modal *@

