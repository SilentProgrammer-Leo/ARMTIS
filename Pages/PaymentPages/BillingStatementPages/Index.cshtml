<!--CSS for Billing Statement Modal Modal-->

    <style>
        .billing-statement {
            background: white;
            padding: 25px;
        }

        @@media print {
            body * {
                visibility: hidden !important;
            }

            #billingPrintArea,
            #billingPrintArea * {
                visibility: visible !important;
            }

            #billingPrintArea {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                padding: 30px;
                background: white;
            }

                #billingPrintArea .table {
                    border-collapse: collapse !important;
                    width: 100% !important;
                }

                    #billingPrintArea .table th,
                    #billingPrintArea .table td {
                        border: 1px solid black !important;
                        padding: 10px !important;
                    }

            @@page {
                size: A4;
                margin: 15mm;
            }
        }
    </style>

    @Html.AntiForgeryToken()

    @*Modal for Recording Payment*@
    <div class="modal fade"
         id="paymentModal"
         tabindex="-1"
         aria-labelledby="paymentModalLabel"
         aria-hidden="true">

        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title"
                        id="paymentModalLabel">
                        Record Payment
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">

                    <input type="hidden" id="PaymentBillingID" />
                    <input type="hidden" id="PaymentTenantID" />

                    <div class="mb-3">
                        <label class="form-label">
                            Billing Number
                        </label>

                        <input type="text"
                               id="PaymentBillingNo"
                               class="form-control"
                               readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Tenant
                        </label>

                        <input type="text"
                               id="PaymentTenant"
                               class="form-control"
                               readonly />
                    </div>

                <div class="mb-3">
                    <label class="form-label">
                        Total Amount Due
                    </label>

                    <input type="number"
                           id="PaymentTotal"
                           class="form-control"
                           readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Already Paid
                    </label>

                    <input type="number"
                           id="PaymentAlreadyPaid"
                           class="form-control"
                           readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Remaining Balance
                    </label>

                    <input type="number"
                           id="PaymentRemainingBalance"
                           class="form-control fw-bold"
                           readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Amount to Pay
                    </label>

                    <input type="number"
                           id="PaymentAmountPaid"
                           min="0.01"
                           step="0.01"
                           class="form-control"
                           required />
                </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Payment Method
                        </label>

                        <select id="PaymentMethod"
                                class="form-select"
                                required>
                            <option value="">-- Select Method --</option>
                            <option value="Cash">Cash</option>
                            <option value="GCash">GCash</option>
                            <option value="Bank Transfer">
                                Bank Transfer
                            </option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Payment Date
                        </label>

                        <input type="date"
                               id="PaymentDate"
                               class="form-control"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Remarks
                        </label>

                        <textarea id="PaymentRemarks"
                                  class="form-control"
                                  rows="3">
                    </textarea>
                    </div>

                    <div id="paymentError"
                         class="alert alert-danger d-none">
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="button"
                            class="btn btn-success"
                            id="savePayment">

                        <i class="bi bi-check-circle"></i>
                        Record Payment
                    </button>
                </div>

            </div>
        </div>
    </div>

<style>
    @@media print {

        body * {
            visibility: hidden !important;
        }

        #billingPrintArea,
        #billingPrintArea * {
            visibility: visible !important;
        }

        #billingPrintArea {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            padding: 20px 30px;
            background: white !important;
            color: black !important;
        }

        .modal,
        .modal-dialog,
        .modal-content,
        .modal-body {
            position: static !important;
            width: 100% !important;
            max-width: none !important;
            overflow: visible !important;
            height: auto !important;
            max-height: none !important;
            transform: none !important;
        }

        .modal-header,
        .modal-footer,
        .btn,
        .no-print {
            display: none !important;
        }

        .card {
            break-inside: avoid;
            box-shadow: none !important;
        }

        table {
            width: 100% !important;
        }

        tr,
        td,
        th {
            break-inside: avoid;
        }

        @@page {
            size: A4;
            margin: 12mm;
        }
    }
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {

            // BILLING STATEMENT MODAL    

            const billingModalElement =
                document.getElementById("billingStatementModal");

            const billingModal =
                billingModalElement
                    ? bootstrap.Modal.getOrCreateInstance(billingModalElement)
                    : null;

            let currentBillingStatementId = null;
            let currentPaymentId = 0;

            // PAYMENT MODAL

            const paymentModalElement =
                document.getElementById("paymentModal");

            const paymentModal =
                paymentModalElement
                    ? bootstrap.Modal.getOrCreateInstance(paymentModalElement)
                    : null;


            // VIEW PAYMENT MODAL

            const viewPaymentModalElement =
                document.getElementById("viewPaymentModal");

            const viewPaymentModal =
                viewPaymentModalElement
                    ? bootstrap.Modal.getOrCreateInstance(viewPaymentModalElement)
                    : null;


            // HELPER FUNCTION

            function setModalText(id, value, fallback = "N/A") {

                const element = document.getElementById(id);

                if (!element) {
                    return;
                }

                if (
                    value !== null &&
                    value !== undefined &&
                    String(value).trim() !== ""
                ) {
                    element.textContent = value;
                }
                else {
                    element.textContent = fallback;
                }
            }

            // VIEW BILLING STATEMENT

            document.querySelectorAll(".viewBillingBtn")
                .forEach(function(button) {

                    button.addEventListener("click", function() {

                        currentBillingStatementId =
                            this.dataset.billingid;

                        // BASIC INFORMATION

                        setModalText(
                            "ModalBillingNo",
                            this.dataset.billingno
                        );

                        setModalText(
                            "ModalTenant",
                            this.dataset.tenant
                        );

                        setModalText(
                            "ModalUnit",
                            this.dataset.unit
                        );

                        setModalText(
                            "ModalBillingMonth",
                            this.dataset.billingmonth
                        );

                        setModalText(
                            "ModalDueDate",
                            this.dataset.duedate
                        );

                        setModalText(
                            "ModalDateGenerated",
                            this.dataset.generated
                        );


                        // MONTHLY RENT

                        setModalText(
                            "ModalMonthlyRent",
                            this.dataset.monthlyrent,
                            "0.00"
                        );


                        // ELECTRICITY

                        setModalText(
                            "ModalPreviousElectric",
                            this.dataset.previouselectric,
                            "0.00"
                        );

                        setModalText(
                            "ModalCurrentElectric",
                            this.dataset.currentelectric,
                            "0.00"
                        );

                        setModalText(
                            "ModalElectricConsumption",
                            this.dataset.electricconsumption,
                            "0.00"
                        );

                        setModalText(
                            "ModalElectricRate",
                            this.dataset.electricrate,
                            "0.00"
                        );

                        setModalText(
                            "ModalElectricity",
                            this.dataset.electricity,
                            "0.00"
                        );

                        setModalText(
                            "ModalElectricitySummary",
                            this.dataset.electricity,
                            "0.00"
                        );


                        // WATER

                        setModalText(
                            "ModalPreviousWater",
                            this.dataset.previouswater,
                            "0.00"
                        );

                        setModalText(
                            "ModalCurrentWater",
                            this.dataset.currentwater,
                            "0.00"
                        );

                        setModalText(
                            "ModalWaterConsumption",
                            this.dataset.waterconsumption,
                            "0.00"
                        );

                        setModalText(
                            "ModalWaterRate",
                            this.dataset.waterrate,
                            "0.00"
                        );

                        setModalText(
                            "ModalWater",
                            this.dataset.water,
                            "0.00"
                        );

                        setModalText(
                            "ModalWaterSummary",
                            this.dataset.water,
                            "0.00"
                        );


                        // INTERNET AND UTILITIES

                        setModalText(
                            "ModalInternet",
                            this.dataset.internet,
                            "0.00"
                        );

                        setModalText(
                            "ModalUtilities",
                            this.dataset.utilities,
                            "0.00"
                        );


                        // BEFORE PENALTY

                        const monthlyRent =
                            parseFloat(this.dataset.monthlyrent) || 0;

                        const utilityTotal =
                            parseFloat(this.dataset.utilities) || 0;

                        const amountBeforePenalty =
                            monthlyRent + utilityTotal;

                        setModalText(
                            "ModalBeforePenalty",
                            amountBeforePenalty.toFixed(2),
                            "0.00"
                        );


                        // PENALTY

                        setModalText(
                            "ModalPenalty",
                            this.dataset.penalty,
                            "0.00"
                        );


                        // TOTAL

                        setModalText(
                            "ModalTotal",
                            this.dataset.total,
                            "0.00"
                        );


                        // REMARKS

                        setModalText(
                            "ModalRemarks",
                            this.dataset.remarks,
                            "None"
                        );


                        // STATUS

                        const statusElement =
                            document.getElementById("ModalStatus");

                        const status =
                            this.dataset.status || "Pending";

                        if (statusElement) {

                            statusElement.textContent = status;

                            statusElement.classList.remove(
                                "bg-success",
                                "bg-warning",
                                "bg-danger",
                                "bg-secondary",
                                "text-dark",
                                "text-white"
                            );

                            switch (status.toLowerCase()) {

                                case "paid":

                                    statusElement.classList.add(
                                        "bg-success",
                                        "text-white"
                                    );

                                    break;

                                case "pending":

                                    statusElement.classList.add(
                                        "bg-warning",
                                        "text-dark"
                                    );

                                    break;

                                case "overdue":

                                    statusElement.classList.add(
                                        "bg-danger",
                                        "text-white"
                                    );

                                    break;

                                case "unpaid":

                                    statusElement.classList.add(
                                        "bg-warning",
                                        "text-dark"
                                    );

                                    break;

                                case "partially paid":

                                    statusElement.classList.add(
                                        "bg-info",
                                        "text-dark"
                                    );

                                    break;

                                default:

                                    statusElement.classList.add(
                                        "bg-secondary",
                                        "text-white"
                                    );

                                    break;
                            }
                        }


                        // OPEN BILLING MODAL

                        if (billingModal) {
                            billingModal.show();
                        }
                        else {
                            console.error(
                                "Billing Statement modal was not initialized."
                            );
                        }

                    });

                });

            // PRINT BILLING STATEMENT

            const printBillingButton =
                document.getElementById("printBillingStatement");

            if (printBillingButton) {

                printBillingButton.addEventListener(
                    "click",
                    function() {

                        if (!currentBillingStatementId) {

                            alert(
                                "Unable to identify the billing statement."
                            );

                            return;
                        }

                        window.print();

                    }
                );
            }

            // RECORD PAYMENT

            document.querySelectorAll(".paymentBtn")
                .forEach(function(button) {

                    button.addEventListener(
                        "click",
                        async function() {

                            const billingID =
                                this.dataset.billingid;

                            const tenantID =
                                this.dataset.tenantid;

                            const billingNo =
                                this.dataset.billingno;

                            const tenantName =
                                this.dataset.tenant;

                            const totalAmount =
                                this.dataset.total;

                            const status =
                                this.dataset.status || "";


                            if (
                                !billingID ||
                                Number(billingID) <= 0
                            ) {

                                alert(
                                    "Invalid billing statement ID."
                                );

                                return;
                            }


                            if (
                                status.toLowerCase() === "paid"
                            ) {

                                alert(
                                    "This billing statement is already paid."
                                );

                                return;
                            }


                            // GET MODAL ELEMENTS

                            const billingIDInput = document.getElementById("PaymentBillingID");

                            const tenantIDInput =
                                document.getElementById(
                                    "PaymentTenantID"
                                );

                            const billingNoInput =
                                document.getElementById(
                                    "PaymentBillingNo"
                                );

                            const tenantInput =
                                document.getElementById(
                                    "PaymentTenant"
                                );

                            const totalInput =
                                document.getElementById(
                                    "PaymentTotal"
                                );

                            const alreadyPaidInput =
                                document.getElementById(
                                    "PaymentAlreadyPaid"
                                );

                            const remainingInput =
                                document.getElementById(
                                    "PaymentRemainingBalance"
                                );

                            const amountInput =
                                document.getElementById(
                                    "PaymentAmountPaid"
                                );

                            const methodInput =
                                document.getElementById(
                                    "PaymentMethod"
                                );

                            const dateInput =
                                document.getElementById(
                                    "PaymentDate"
                                );

                            const remarksInput =
                                document.getElementById(
                                    "PaymentRemarks"
                                );


                            // CHECK ELEMENTS

                            if (
                                !billingIDInput ||
                                !tenantIDInput ||
                                !billingNoInput ||
                                !tenantInput ||
                                !totalInput ||
                                !amountInput ||
                                !methodInput
                            ) {

                                console.error(
                                    "Payment modal elements are missing."
                                );

                                alert(
                                    "Payment modal is not configured correctly."
                                );

                                return;
                            }


                            // SET INFORMATION

                            billingIDInput.value =
                                billingID;

                            tenantIDInput.value =
                                tenantID || "";

                            billingNoInput.value =
                                billingNo || "";

                            tenantInput.value =
                                tenantName || "N/A";

                            totalInput.value =
                                Number(totalAmount || 0)
                                    .toFixed(2);

                            amountInput.value = "";

                            methodInput.value = "";


                            if (remarksInput) {
                                remarksInput.value = "";
                            }


                            if (dateInput) {

                                const today =
                                    new Date()
                                        .toISOString()
                                        .split("T")[0];

                                dateInput.value = today;
                            }


                            // GET PAYMENT SUMMARY

                            try {

                                const response =
                                    await fetch(
                                        "?handler=PaymentSummary&billingStatementId=" +
                                        encodeURIComponent(billingID)
                                    );


                                if (!response.ok) {

                                    throw new Error(
                                        "Unable to load payment summary."
                                    );
                                }


                                const data =
                                    await response.json();


                                if (!data.success) {

                                    throw new Error(
                                        data.message ||
                                        "Unable to load payment information."
                                    );
                                }


                                if (alreadyPaidInput) {

                                    alreadyPaidInput.value =
                                        Number(
                                            data.totalPaid || 0
                                        ).toFixed(2);
                                }


                                if (remainingInput) {

                                    remainingInput.value =
                                        Number(
                                            data.remainingBalance || 0
                                        ).toFixed(2);
                                }


                                if (
                                    Number(
                                        data.remainingBalance || 0
                                    ) <= 0
                                ) {

                                    alert(
                                        "This billing statement has already been fully paid."
                                    );

                                    return;
                                }


                                // SHOW PAYMENT MODAL

                                if (paymentModal) {

                                    paymentModal.show();

                                }
                                else {

                                    console.error(
                                        "Payment modal was not initialized."
                                    );

                                    alert(
                                        "Unable to open payment modal."
                                    );
                                }

                            }
                            catch (error) {

                                console.error(
                                    "Payment summary error:",
                                    error
                                );

                                alert(
                                    error.message ||
                                    "An error occurred while loading payment information."
                                );
                            }

                        }
                    );

                });

                // SAVE / RECORD PAYMENT

                const savePaymentBtn =
    document.getElementById("savePayment");

if (savePaymentBtn) {

    savePaymentBtn.addEventListener("click", async function () {

        // GET PAYMENT VALUES
        const billingStatementID =
            document.getElementById("PaymentBillingID")?.value;

        const tenantID =
            document.getElementById("PaymentTenantID")?.value;

        const amountPaid =
            document.getElementById("PaymentAmountPaid")?.value;

        const paymentMethod =
            document.getElementById("PaymentMethod")?.value;

        const paymentDate =
            document.getElementById("PaymentDate")?.value;

        const remarks =
            document.getElementById("PaymentRemarks")?.value || "";


        // ==========================================
        // VALIDATION
        // ==========================================

        if (!billingStatementID) {
            alert("Billing statement ID is missing.");
            return;
        }

        if (!amountPaid || Number(amountPaid) <= 0) {
            alert("Please enter a valid payment amount.");
            return;
        }

        if (!paymentMethod) {
            alert("Please select a payment method.");
            return;
        }

        if (!paymentDate) {
            alert("Please select a payment date.");
            return;
        }


        // ==========================================
        // CONFIRM PAYMENT
        // ==========================================

        const confirmed = confirm(
            "Are you sure you want to record this payment?"
        );

        if (!confirmed) {
            return;
        }


        // ==========================================
        // DISABLE BUTTON
        // ==========================================

        savePaymentBtn.disabled = true;

        savePaymentBtn.innerHTML =
            '<span class="spinner-border spinner-border-sm"></span> Recording...';


        try {

            // ==========================================
            // GET ANTI-FORGERY TOKEN
            // ==========================================

            const token =
                document.querySelector(
                    'input[name="__RequestVerificationToken"]'
                )?.value;


            // ==========================================
            // SEND PAYMENT TO SERVER
            // ==========================================

            const response = await fetch(
                "?handler=RecordPayment",
                {
                    method: "POST",

                    headers: {
                        "Content-Type": "application/json",

                        "RequestVerificationToken":
                            token || ""
                    },

                    body: JSON.stringify({

                        BillingStatementID:
                            Number(billingStatementID),

                        TenantID:
                            Number(tenantID || 0),

                        AmountPaid:
                            Number(amountPaid),

                        PaymentMethod:
                            paymentMethod,

                        PaymentDate:
                            paymentDate,

                        Remarks:
                            remarks
                    })
                }
            );


            // ==========================================
            // READ SERVER RESPONSE
            // ==========================================

            const data =
                await response.json();


            // ==========================================
            // CHECK FOR SERVER ERROR
            // ==========================================

            if (!response.ok || !data.success) {

                throw new Error(
                    data.message ||
                    "Unable to record payment."
                );
            }


            // ==========================================
            // SUCCESS MESSAGE
            // ==========================================

            let successMessage =
                "Payment recorded successfully.\n\n" +
                "Receipt No: " +
                data.receiptNo;


            // If there is excess payment
            if (Number(data.excessPayment || 0) > 0) {

                successMessage +=
                    "\n\nExcess Payment: ₱" +
                    Number(data.excessPayment)
                        .toLocaleString("en-PH", {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        }) +
                    "\n\nThis amount has been added to the tenant's credit.";
            }


            alert(successMessage);


            // ==========================================
            // CLOSE MODAL
            // ==========================================

            if (paymentModal) {
                paymentModal.hide();
            }


            // ==========================================
            // REFRESH BILLING STATEMENT LIST
            // ==========================================

            window.location.reload();

        }
        catch (error) {

            console.error(
                "Record payment error:",
                error
            );

            alert(
                error.message ||
                "An error occurred while recording the payment."
            );

        }
        finally {

            // ==========================================
            // RESTORE BUTTON
            // ==========================================

            savePaymentBtn.disabled = false;

            savePaymentBtn.innerHTML =
                '<i class="bi bi-check-circle"></i> Record Payment';
        }

    });

}

            // VIEW PAYMENT

            document.querySelectorAll(".viewPaymentBtn")
                .forEach(function(button) {

                    button.addEventListener(
                        "click",
                        async function() {

                            const billingID =
                                this.dataset.billingid;

                            const billingNo =
                                this.dataset.billingno;
                                    

                            if (
                                !billingID ||
                                Number(billingID) <= 0
                            ) {

                                alert(
                                    "Invalid billing statement."
                                );

                                return;
                            }


                            currentPaymentId = 0;


                            setModalText(
                                "ViewPaymentBillingNo",
                                billingNo,
                                "N/A"
                            );


                            try {

                                const response =
                                    await fetch(
                                        "?handler=PaymentDetails&billingStatementId=" +
                                        encodeURIComponent(billingID)
                                    );


                                if (!response.ok) {

                                    throw new Error(
                                        "Unable to load payment details."
                                    );
                                }


                                const data =
                                    await response.json();


                                console.log(
                                    "Payment Details:",
                                    data
                                );


                                if (!data.success) {

                                    throw new Error(
                                        data.message ||
                                        "No payment information found."
                                    );
                                }


                                // SAVE PAYMENT ID

                                currentPaymentId =
                                    Number(
                                        data.paymentID || 0
                                    );


                                // DISPLAY DETAILS

                                setModalText(
                                    "ViewReceiptNo",
                                    data.receiptNo,
                                    "N/A"
                                );

                                setModalText(
                                    "ViewPaymentDate",
                                    data.paymentDate,
                                    "N/A"
                                );

                                setModalText(
                                    "ViewPaymentTenant",
                                    data.tenantName,
                                    "N/A"
                                );

                                setModalText(
                                    "ViewPaymentBillingNo",
                                    data.billingNo || billingNo,
                                    "N/A"
                                );

                                setModalText(
                                    "ViewPaymentBillingMonth",
                                    data.billingMonth,
                                    "N/A"
                                );

                                setModalText(
                                    "ViewPaymentFor",
                                    data.paymentFor,
                                    "N/A"
                                );

                                setModalText(
                                    "ViewAmountPaid",
                                    Number(
                                        data.amountPaid || 0
                                    ).toFixed(2),
                                    "0.00"
                                );

                                setModalText(
                                    "ViewPaymentMethod",
                                    data.paymentMethod,
                                    "N/A"
                                );

                                setModalText(
                                    "ViewPaymentRemarks",
                                    data.remarks,
                                    "None"
                                );


                                // PAYMENT STATUS

                                const statusElement =
                                    document.getElementById(
                                        "ViewPaymentStatus"
                                    );

                                const paymentStatus =
                                    data.paymentStatus ||
                                    "Completed";


                                if (statusElement) {

                                    statusElement.textContent =
                                        paymentStatus;

                                    statusElement.classList.remove(
                                        "bg-success",
                                        "bg-warning",
                                        "bg-danger",
                                        "bg-secondary",
                                        "text-dark",
                                        "text-white"
                                    );


                                    if (
                                        paymentStatus.toLowerCase() ===
                                        "completed"
                                    ) {

                                        statusElement.classList.add(
                                            "bg-success",
                                            "text-white"
                                        );

                                    }
                                    else if (
                                        paymentStatus.toLowerCase() ===
                                        "pending"
                                    ) {

                                        statusElement.classList.add(
                                            "bg-warning",
                                            "text-dark"
                                        );

                                    }
                                    else {

                                        statusElement.classList.add(
                                            "bg-secondary",
                                            "text-white"
                                        );
                                    }

                                }


                                // SHOW VIEW PAYMENT MODAL

                                if (viewPaymentModal) {

                                    viewPaymentModal.show();

                                }
                                else {

                                    console.error(
                                        "View Payment modal was not initialized."
                                    );

                                    alert(
                                        "Unable to open View Payment modal."
                                    );
                                }

                            }
                            catch (error) {

                                console.error(
                                    "View Payment error:",
                                    error
                                );

                                alert(
                                    error.message ||
                                    "An error occurred while loading payment information."
                                );
                            }

                        }
                    );

                });

            // PRINT RECEIPT

            const printReceiptBtn = document.getElementById("printReceiptBtn");

            if (printReceiptBtn)
            {

                printReceiptBtn.addEventListener("click",function() 
                     {
                        if (!currentPaymentId ||currentPaymentId <= 0) 
                            {
                            alert("No payment selected.");
                             return;
                            }

                        window.open("/PaymentPages/RentalPaymentPages/Receipt?paymentid=" +currentPaymentId,"_blank");

                    }
                );

            }

        });
    </script>
}
