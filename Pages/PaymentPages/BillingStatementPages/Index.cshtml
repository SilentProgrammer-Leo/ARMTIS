@page
@model ARMTIS_Capstone_Project.Pages.BillingStatementPages.IndexModel

@{
    ViewData["Title"] = "Billing Statements";
}

<div class="container-fluid px-0">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1" style="color:#0A2D4F;">
                Billing Statements
            </h2>

            <p class="text-muted mb-0">
                Manage tenant billing statements, payments, and balances.
            </p>
        </div>
        <a asp-page="/PaymentPages/BillingStatementPages/Generate"
           class="btn text-white px-3 py-2"
           style="background:#0A2D4F;">

            <i class="bi bi-receipt me-1"></i>
            Generate Billing

        </a>
    </div>

    <!-- BILLING SEARCH & FILTER -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <div class="d-flex align-items-center mb-3">

                <div class="rounded-circle d-flex
                    align-items-center justify-content-center me-3"
                     style="width:40px;
                    height:40px;
                    background:#eaf7f5;
                    color:#17B6A7;">

                    <i class="bi bi-funnel"></i>

                </div>

                <div>
                    <h6 class="fw-bold mb-0" style="color:#0A2D4F;">
                        Search & Filter Billing
                    </h6>

                    <small class="text-muted">
                        Find billing statements by tenant, unit, number, month, or status.
                    </small>
                </div>

            </div>

            <form method="get">

                <div class="row g-3 align-items-end">

                    <!-- SEARCH -->
                    <div class="col-lg-5">

                        <label asp-for="SearchTerm" class="form-label fw-semibold">
                            Search
                        </label>

                        <div class="input-group">

                            <span class="input-group-text bg-white">
                                <i class="bi bi-search text-muted"></i>
                            </span>

                            <input asp-for="SearchTerm"
                                   class="form-control"
                                   placeholder="Tenant, unit, or billing number..." />
                        </div>
                    </div>

                    <!-- STATUS -->
                    <div class="col-lg-3">

                        <label asp-for="StatusFilter"
                               class="form-label fw-semibold">
                            Status
                        </label>

                        <select asp-for="StatusFilter"
                                class="form-select">

                            <option value="All">
                                All Statuses
                            </option>

                            <option value="Paid">
                                Paid
                            </option>

                            <option value="Unpaid">
                                Unpaid
                            </option>

                            <option value="Partially Paid">
                                Partially Paid
                            </option>

                            <option value="Overdue">
                                Overdue
                            </option>

                            <option value="Pending">
                                Pending
                            </option>

                        </select>

                    </div>

                    <!-- MONTH -->
                    <div class="col-lg-2">
                        <label asp-for="BillingMonthFilter"
                               class="form-label fw-semibold">
                            Billing Month
                        </label>

                        <input asp-for="BillingMonthFilter"
                               type="month"
                               class="form-control" />
                    </div>

                    <!-- BUTTONS -->
                    <div class="col-lg-2">

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn text-white flex-grow-1"
                                    style="background:#0A2D4F;">

                                <i class="bi bi-funnel me-1"></i>
                                Apply

                            </button>

                            <a asp-page="./Index"
                               class="btn btn-light border"
                               title="Reset filters">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- ALERT MESSAGES -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm"
             role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm"
             role="alert">

            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <form id="antiForgeryForm" class="d-none">
        @Html.AntiForgeryToken()
    </form>

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <span class="text-muted small">
                Showing
            </span>

            <span class="fw-bold" style="color:#0A2D4F;">
                @Model.BillingStatement.Count
            </span>

            <span class="text-muted small">
                billing record(s)
            </span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) ||
             (!string.IsNullOrWhiteSpace(Model.StatusFilter) &&
              Model.StatusFilter != "All") ||
             !string.IsNullOrWhiteSpace(Model.BillingMonthFilter))
        {
            <span class="badge rounded-pill"
                  style="background:#eaf7f5;color:#087f73;">

                <i class="bi bi-funnel-fill me-1"></i>
                Filters Applied

            </span>
        }
    </div>

    <!-- BILLING TABLE CARD -->
    <div class="card border-0 shadow-sm billing-table-card">
        <div class="card-header bg-white border-0 pt-4 px-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-semibold mb-1"
                        style="color:#0A2D4F;">

                        <i class="bi bi-receipt me-2"
                           style="color:#17B6A7;">
                        </i>
                        Billing Records
                    </h5>

                    <small class="text-muted">
                        Review billing statements and payment activity.
                    </small>
                </div>
            </div>
        </div>

        <div class="card-body px-0 pt-3">
            <div class="table-responsive">
                <table class="table align-middle mb-0 billing-table">
                    <thead>
                        <tr>
                            <th>Unit</th>
                            <th>Tenant</th>
                            <th>Billing Month</th>
                            <th>Due Date</th>
                            <th>Status</th>
                            <th>Billing Statement</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                     <tbody>
                           
                         @if (Model.BillingStatement.Any())
                        {
                            @foreach (var item in Model.BillingStatement)
                            {
                                var utility =
                                    Model.UtilityReadingsByBillingId
                                    .GetValueOrDefault(item.BillingStatementID);

                                <tr class="@(item.BillingStatus == "Overdue" ? "billing-overdue-row": "")">

                                    <!-- UNIT -->
                                    <td class="fw-semibold text-nowrap">

                                        <span class="unit-label">
                                            <i class="bi bi-door-open me-1"></i>
                                            @(item.Unit?.UnitNumber ?? "N/A")
                                        </span>

                                    </td>

                                    <!-- TENANT -->
                                    <td>
                                        @if (item.Tenant != null)
                                        {
                                            <div class="fw-semibold">
                                                @($"{item.Tenant.FirstName} {item.Tenant.LastName}")
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A </span>
                                        }
                                    </td>

                                    <!-- BILLING MONTH -->
                                    <td>

                                        <span class="billing-month-badge">
                                            <i class="bi bi-calendar3 me-1"></i>
                                            @item.BillingMonth.ToString("MMMM yyyy")
                                        </span>

                                    </td>

                                    <!-- DUE DATE -->
                                    <td class="text-nowrap">

                                        <div class="d-flex align-items-center">

                                            <i class="bi bi-calendar-event me-2 text-muted"></i>

                                            <span>
                                                @item.DueDate.ToString("MMMM dd, yyyy")
                                            </span>

                                        </div
                                    </td>

                                    <!-- STATUS -->
                                    <td>
                                        @if (item.BillingStatus == "Paid")
                                        {
                                            <span class="billing-status status-paid">
                                                <i class="bi bi-check-circle me-1"></i>
                                                Paid
                                            </span>
                                        }
                                        else if (item.BillingStatus == "Overdue")
                                        {
                                            <span class="billing-status status-overdue">
                                                <i class="bi bi-exclamation-circle me-1"></i>
                                                Overdue
                                            </span>
                                        }
                                        else if (item.BillingStatus == "Unpaid")
                                        {
                                            <span class="billing-status status-unpaid">
                                                <i class="bi bi-clock me-1"></i>
                                                Unpaid
                                            </span>
                                        }
                                        else if (item.BillingStatus == "Partially Paid")
                                        {
                                            <span class="billing-status status-partial">
                                                <i class="bi bi-hourglass-split me-1"></i>
                                                Partially Paid
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="billing-status status-pending">
                                                <i class="bi bi-hourglass me-1"></i>
                                                Pending
                                            </span>
                                        }
                                    </td>


                                    <!-- VIEW BILLING STATEMENT -->
                                    <td>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-success viewBillingBtn billing-action-btn"
                                                data-billingid="@item.BillingStatementID"
                                                data-billingno="@item.BillingNo"
                                                data-tenant="@(item.Tenant != null ? item.Tenant.FirstName + " " + item.Tenant.LastName : "N/A")"
                                                data-unit="@(item.Unit?.UnitNumber ?? "N/A")"
                                                data-billingmonth="@item.BillingMonth.ToString("MMMM yyyy")"
                                                data-duedate="@item.DueDate.ToString("MMMM dd, yyyy")"
                                                data-monthlyrent="@item.MonthlyRent.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                                data-previouselectric="@(utility?.PreviousElectricReading.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) ?? "0.00")"
                                                data-currentelectric="@(utility?.CurrentElectricReading.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) ?? "0.00")"
                                                data-electricconsumption="@(utility?.ElectricConsumption.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) ?? "0.00")"
                                                data-electricrate="@(utility?.ElectricRate.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) ?? "0.00")"
                                                data-previouswater="@(utility?.PreviousWaterReading.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) ?? "0.00")"
                                                data-currentwater="@(utility?.CurrentWaterReading.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) ?? "0.00")"
                                                data-waterconsumption="@(utility?.WaterConsumption.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) ?? "0.00")"
                                                data-waterrate="@(utility?.WaterRate.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) ?? "0.00")"
                                                data-water="@item.Water.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                                data-electricity="@item.Electricity.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                                data-internet="@item.Internet.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                                data-utilities="@item.UtilityCharges.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                                data-penalty="@item.PenaltyAmount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                                data-total="@item.TotalAmountDue.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                                data-status="@item.BillingStatus"
                                                data-remarks="@(item.Remarks ?? "None")"
                                                data-generated="@item.DateGenerated.ToString("MMMM dd, yyyy")">
                                            <i class="bi bi-receipt me-1"></i>
                                            View
                                        </button>
                                    </td>


                                    <!-- ACTIONS -->
                                    <td>
                                        <div class="d-flex justify-content-center flex-wrap gap-1">

                                            @if (item.BillingStatus != "Paid")
                                            {
                                                <!-- RECORD PAYMENT -->
                                                <button type="button"
                                                        class="btn btn-sm btn-success billing-action-btn paymentBtn"
                                                        data-billingid="@item.BillingStatementID"
                                                        data-billingno="@item.BillingNo"
                                                        data-tenantid="@item.TenantID"
                                                        data-tenant="@(item.Tenant != null ? item.Tenant.FirstName + " " + item.Tenant.LastName : "N/A")"
                                                        data-total="@item.TotalAmountDue.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                                        data-penalty="@item.PenaltyAmount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                                        data-status="@item.BillingStatus">
                                                    <i class="bi bi-cash-stack me-1"></i>
                                                    Payment
                                                </button>
                                            }

                                            @if (item.BillingStatus == "Paid" || item.BillingStatus == "Partially Paid")
                                            {
                                                <!-- VIEW PAYMENT -->
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-primary billing-action-btn viewPaymentBtn"
                                                        data-billingid="@item.BillingStatementID"
                                                        data-billingno="@item.BillingNo">
                                                    <i class="bi bi-eye me-1"></i>
                                                    Payment
                                                </button>
                                            }

                                            <!-- DELETE -->
                                            <a asp-page="./Delete"
                                               asp-route-billingstatementid="@item.BillingStatementID"
                                               class="btn btn-sm btn-outline-danger billing-action-btn">
                                                <i class="bi bi-trash me-1"></i>
                                                Delete
                                            </a>

                                        </div>
                                    </td>


                                </tr>


                            }

                        }
                        else
                        {
                            <tr>

                                <td colspan="7"
                                class="text-center py-5">

                                    <div class="mb-3">

                                        <i class="bi bi-search"
                                        style="font-size:2rem;color:#17B6A7;">
                                        </i>

                                    </div>

                                    <h6 class="fw-bold"
                                    style="color:#0A2D4F;">

                                        No billing statements found

                                    </h6>

                                    <p class="text-muted mb-0">

                                        Try changing your search or filter criteria.

                                    </p>

                                </td>

                            </tr>
                        }
                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- BILLING PAGE UI -->
<style>

    .billing-table-card {
        border-radius: 14px;
        overflow: hidden;
    }

    .billing-table {
        min-width: 1050px;
    }

        .billing-table thead th {
            background: #0A2D4F;
            color: white;
            font-size: 0.82rem;
            font-weight: 600;
            padding: 14px 16px;
            border: none;
            white-space: nowrap;
        }

        .billing-table tbody td {
            padding: 14px 16px;
            border-bottom: 1px solid #edf0f3;
            font-size: 0.9rem;
        }

        .billing-table tbody tr {
            transition: background-color 0.15s ease;
        }

            .billing-table tbody tr:hover {
                background-color: #f7fbfa;
            }

    .billing-overdue-row {
        background-color: #fff8f8;
    }

        .billing-overdue-row:hover {
            background-color: #fff2f2 !important;
        }

    .unit-label {
        color: #0A2D4F;
    }

    .billing-month-badge {
        display: inline-flex;
        align-items: center;
        background: #eaf7f5;
        color: #087f73;
        padding: 6px 9px;
        border-radius: 7px;
        font-size: 0.78rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .billing-status {
        display: inline-flex;
        align-items: center;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 0.76rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .status-paid {
        background: #e9f7ef;
        color: #198754;
    }

    .status-overdue {
        background: #fdecec;
        color: #dc3545;
    }

    .status-unpaid {
        background: #fff4d6;
        color: #9a6700;
    }

    .status-pending {
        background: #eef1f5;
        color: #5f6b78;
    }

    .status-partial {
        background: #e8f7fb;
        color: #087990;
    }

    .billing-action-btn {
        min-height: 32px;
        padding: 4px 9px;
        font-size: 0.76rem;
        font-weight: 500;
        white-space: nowrap;
        border-radius: 6px;
    }

    .billing-table-card .card-header {
        border-bottom: 1px solid #edf0f3 !important;
    }

    /* MODAL HEADER STYLE */
    #billingStatementModal .modal-header,
    #viewPaymentModal .modal-header,
    #paymentModal .modal-header {
        background: #0A2D4F;
        color: white;
    }

    #billingStatementModal .modal-title,
    #viewPaymentModal .modal-title,
    #paymentModal .modal-title {
        font-weight: 600;
    }

    #billingStatementModal .btn-close,
    #viewPaymentModal .btn-close,
    #paymentModal .btn-close {
        filter: brightness(0) invert(1);
    }

    @@media (max-width: 768px) {

        .billing-table-card {
            border-radius: 10px;
        }

        .billing-table tbody td,
        .billing-table thead th {
            padding: 11px 12px;
        }
    }

    .billing-filter-card {
        border-radius: 14px;
    }

        .billing-filter-card .form-control,
        .billing-filter-card .form-select {
            border-color: #dfe5ea;
        }

            .billing-filter-card .form-control:focus,
            .billing-filter-card .form-select:focus {
                border-color: #17B6A7;
                box-shadow: 0 0 0 0.2rem rgba(23, 182, 167, 0.12);
            }

</style>

@* Billing Statement Modal *@

@Html.AntiForgeryToken()

<div class="modal fade"
     id="billingStatementModal"
     tabindex="-1"
     aria-labelledby="billingStatementModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-scrollable">

        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header">

                <h5 class="modal-title"
                    id="billingStatementModalLabel">
                    Billing Statement
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <!-- BODY -->
            <div class="modal-body">

                <div id="billingPrintArea"
                     class="billing-statement">

                    <!-- BUSINESS HEADER -->
                    <div class="text-center mb-4">

                        <h2 class="mb-1">
                            Tressing Residency
                        </h2>

                        <h5 class="mb-1">
                            Apartment Rental Management System
                        </h5>

                        <p class="mb-0">
                            Billing Statement
                        </p>

                    </div>

                    <hr />


                    <!-- BILLING INFORMATION -->
                    <div class="row mb-3">

                        <div class="col-md-6">
                            <strong>Billing Number:</strong>
                            <span id="ModalBillingNo"></span>
                        </div>

                        <div class="col-md-6 text-md-end">
                            <strong>Date Generated:</strong>
                            <span id="ModalDateGenerated"></span>
                        </div>

                    </div>


                    <!-- TENANT INFORMATION -->
                    <div class="row mb-3">

                        <div class="col-md-6">
                            <strong>Tenant:</strong>
                            <span id="ModalTenant"></span>
                        </div>

                        <div class="col-md-6">
                            <strong>Unit:</strong>
                            <span id="ModalUnit"></span>
                        </div>

                    </div>


                    <!-- BILLING PERIOD -->
                    <div class="row mb-4">

                        <div class="col-md-6">
                            <strong>Billing Month:</strong>
                            <span id="ModalBillingMonth"></span>
                        </div>

                        <div class="col-md-6">
                            <strong>Due Date:</strong>
                            <span id="ModalDueDate"></span>
                        </div>

                    </div>

                    @* <!-- UTILITY READING DETAILS --> *@

                    <h5 class="mb-3">
                        Utility Reading Details
                    </h5>


                    <!-- ELECTRICITY -->
                    <div class="card mb-3">

                        <div class="card-header fw-bold">
                            Electricity
                        </div>

                        <div class="card-body">

                            <div class="row mb-2">

                                <div class="col-md-6">

                                    <strong>
                                        Previous Reading:
                                    </strong>

                                    <span id="ModalPreviousElectric">
                                        0.00
                                    </span>

                                    kWh

                                </div>

                                <div class="col-md-6">

                                    <strong>
                                        Current Reading:
                                    </strong>

                                    <span id="ModalCurrentElectric">
                                        0.00
                                    </span>

                                    kWh

                                </div>

                            </div>


                            <div class="row mb-2">

                                <div class="col-md-6">

                                    <strong>
                                        Consumption:
                                    </strong>

                                    <span id="ModalElectricConsumption">
                                        0.00
                                    </span>

                                    kWh

                                </div>

                            <div class="col-md-6">

                                    <strong>
                                        Rate:
                                    </strong>

                                    ₱<span id="ModalElectricRate">
                                    00.00
                                    
                                </span>

                                / kWh

                            </div>

                        </div>


                        <div class="row">

                            <div class="col-md-12">

                                <strong>
                                    Electricity Bill:
                                </strong>

                                ₱<span id="ModalElectricity">
                                0.00
                            </span>

                        </div>

                    </div>

                </div>

            </div>


            @* <!-- WATER --> *@
            <div class="card mb-4">

                <div class="card-header fw-bold">
                    Water
                </div>

                <div class="card-body">

                    <div class="row mb-2">

                        <div class="col-md-6">

                            <strong>
                                Previous Reading:
                            </strong>

                            <span id="ModalPreviousWater">
                                0.00
                            </span>

                            m³

                        </div>

                        <div class="col-md-6">

                            <strong>
                                Current Reading:
                            </strong>

                            <span id="ModalCurrentWater">
                                0.00
                            </span>

                            m³

                        </div>

                    </div>


                    <div class="row mb-2">

                        <div class="col-md-6">

                            <strong>
                                Consumption:
                            </strong>

                            <span id="ModalWaterConsumption">
                                0.00
                            </span>

                            m³

                        </div>

                        <div class="col-md-6">

                            <strong>
                                Rate:
                            </strong>

                            ₱<span id="ModalWaterRate">
                            00.00

                        </span>

                        / m3

                    </div>

                        <div class="col-md-6">

                            <strong>
                                Water Bill:
                            </strong>

                            ₱<span id="ModalWater">
                            0.00
                        </span>

                    </div>

                </div>

            </div>

        </div>


        @* <!-- BILLING SUMMARY --> *@


        <h5 class="mb-3">
            Billing Summary
        </h5>

        <table class="table table-bordered">

            <thead>

                <tr>
                    <th>Description</th>

                    <th class="text-end">
                        Amount
                    </th>
                </tr>

            </thead>

            <tbody>

                <tr>

                    <td>
                        Monthly Rent
                    </td>

                    <td class="text-end fw-bold">
                        ₱<span id="ModalMonthlyRent">
                        0.00
                    </span>
                </td>

            </tr>

            <tr>
                
                <td class="text-center fw-bold">
                    <span>
                    Utilities
                    </span>
                </td>   
                
            </tr>
            <tr>

                <td>
                    Water
                </td>

                <td class="text-end">
                        ₱<span id="ModalWaterSummary">
                        0.00
                    </span>
                </td>

            </tr>


            <tr>

                <td>
                    Electricity
                </td>

                    <td class="text-end">
                        ₱<span id="ModalElectricitySummary">
                        0.00
                    </span>
                </td>

            </tr>


            <tr>

                <td>
                    Internet
                </td>

