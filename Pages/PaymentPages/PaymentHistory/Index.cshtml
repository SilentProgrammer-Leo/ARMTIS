@page
@model ARMTIS_Capstone_Project.Pages.PaymentPages.Payment_History.IndexModel
@{
}
<h1 class="mb-4">Payment History</h1>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>
                Receipt No.
            </th>
          
            <th>
                Tenant
            </th>
            <th>
                Billing Number
            </th>
            <th>
                Amount Paid
            </th>
            <th>
                Payment Method
            </th> 
            <th>
                Payment Date
            </th>
            <th>
                Status
            </th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.Payments)
        {
            <tr>
                <td>
                    @item.ReceiptNo
                </td>
               
                <td>
                    @item.Tenant?.FirstName
                    @item.Tenant?.LastName
                </td>

                <td>
                    @item.PaymentFor
                </td>

                <td>
                    ₱@item.AmountPaid.ToString("N2")
                </td>

                <td>
                    @item.PaymentMethod
                </td>

                <td>
                    @item.PaymentDate.ToString("MMMM dd, yyyy")
                </td>

                <td>
                    @if (item.PaymentStatus == "Paid")
                    {
                        <span class="badge bg-success">
                            @item.PaymentStatus
                        </span>
                    }
                    else if (item.PaymentStatus == "Partial")
                    {
                        <span class="badge bg-warning text-dark">
                            @item.PaymentStatus
                        </span>
                    }
                    else if (item.PaymentStatus == "Overdue")
                    {
                        <span class="badge bg-danger">
                            @item.PaymentStatus
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            @item.PaymentStatus
                        </span>
                    }
                </td>

              @*   <td>
                    <a asp-page="/PaymentPages/Record_Payment/Details"
                       asp-route-id="@item.PaymentID"
                       class="btn btn-sm btn-primary">
                        Details
                    </a>
                </td> *@
            </tr>
        }
    </tbody>
</table>