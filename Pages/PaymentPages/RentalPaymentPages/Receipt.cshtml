@page
@model ARMTIS_Capstone_Project.Pages.PaymentPages.RentalPaymentPages.ReceiptModel

@{
    Layout = "_Layout";
}

<div class="receipt-actions no-print">
    <button type="button"
            class="btn btn-primary"
            onclick="window.print()">
        <i class="bi bi-printer"></i>
        Print Receipt
    </button>

    <a asp-page="/PaymentPages/BillingStatementPages/Index"
       class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i>
        Back to Billing Statements
    </a>
</div>

<div id="receipt" class="receipt-container">

    <!-- HEADER -->
    <div class="receipt-header">

        <h2>TRESSING RESIDENCY</h2>

        <div class="receipt-subtitle">
            Apartment Rental Management System
        </div>

        <div class="receipt-title">
            ACKNOWLEDGEMENT RECEIPT
        </div>

    </div>


    <!-- RECEIPT INFO -->
    <div class="receipt-meta">

        <div>
            <strong>Receipt No.:</strong>
            @Model.RentalPayment.ReceiptNo
        </div>

        <div>
            <strong>Date:</strong>
            @Model.RentalPayment.PaymentDate.ToString("MMMM dd, yyyy")
        </div>

    </div>


    <!-- TENANT INFO -->
    <div class="section-title">
        Payment Information
    </div>

    <table class="receipt-table">

        <tr>
            <td class="label">
                Received From
            </td>

            <td>
                @Model.RentalPayment.Tenant?.FirstName
                @Model.RentalPayment.Tenant?.LastName
            </td>
        </tr>

        <tr>
            <td class="label">
                Billing Number
            </td>

            <td>
                @(Model.RentalPayment.BillingStatement?.BillingNo ?? "N/A")
            </td>
        </tr>

        <tr>
            <td class="label">
                Billing Month
            </td>

            <td>
                @Model.RentalPayment.BillingMonth.ToString("MMMM yyyy")
            </td>
        </tr>

        <tr>
            <td class="label">
                Payment For
            </td>

            <td>
                @Model.RentalPayment.PaymentFor
            </td>
        </tr>

        <tr>
            <td class="label">
                Payment Method
            </td>

            <td>
                @Model.RentalPayment.PaymentMethod
            </td>
        </tr>

        <tr>
            <td class="label">
                Status
            </td>

            <td>
                <span class="status-paid">
                    @Model.RentalPayment.PaymentStatus
                </span>
            </td>
        </tr>

    </table>


    <!-- AMOUNT -->
    <div class="amount-box">

        <div class="amount-label">
            AMOUNT PAID
        </div>

        <div class="amount-value">
            ₱@Model.RentalPayment.AmountPaid.ToString("N2")
        </div>

    </div>


    <!-- REMARKS -->
    <div class="remarks-section">

        <strong>Remarks:</strong>

        <span>
            @(string.IsNullOrWhiteSpace(Model.RentalPayment.Remarks)
                ? "None"
                : Model.RentalPayment.Remarks)
        </span>

    </div>


    <!-- ACKNOWLEDGEMENT -->
    <div class="acknowledgement">

        Payment received in full for the billing period stated above.
        This receipt serves as proof of payment.

    </div>


    <!-- SIGNATURES -->
    <div class="signature-section">

        <div class="signature-box">

            <div class="signature-line"></div>

            <div class="signature-label">
                Tenant / Payer
            </div>

        </div>

        <div class="signature-box">

            <div class="signature-line"></div>

            <div class="signature-label">
                Authorized Representative
            </div>

        </div>

    </div>


    <!-- FOOTER -->
    <div class="receipt-footer">

        Thank you for your payment.

        <br />

        Please keep this receipt for your records.

    </div>

</div>


<style>

    body {
        background: #f5f5f5;
    }

    .receipt-actions {
        max-width: 760px;
        margin: 25px auto 10px auto;
        text-align: right;
    }

    .receipt-container {
        width: 760px;
        max-width: 100%;
        margin: 0 auto 40px auto;
        background: white;
        padding: 45px 50px;
        border: 1px solid #dcdcdc;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        font-family: Arial, Helvetica, sans-serif;
        color: #222;
    }


    /* HEADER */

    .receipt-header {
        text-align: center;
        padding-bottom: 20px;
        border-bottom: 2px solid #222;
        margin-bottom: 25px;
    }

        .receipt-header h2 {
            margin: 0;
            font-size: 27px;
            font-weight: 700;
            letter-spacing: 1px;
        }

    .receipt-subtitle {
        margin-top: 5px;
        font-size: 14px;
        color: #555;
    }

    .receipt-title {
        margin-top: 18px;
        font-size: 19px;
        font-weight: bold;
        letter-spacing: 1.5px;
    }


    /* META */

    .receipt-meta {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
        font-size: 14px;
    }


    /* SECTION */

    .section-title {
        font-weight: bold;
        font-size: 15px;
        text-transform: uppercase;
        padding-bottom: 7px;
        margin-bottom: 10px;
        border-bottom: 1px solid #aaa;
    }


    /* TABLE */

    .receipt-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 25px;
    }

        .receipt-table td {
            padding: 7px 4px;
            vertical-align: top;
            border-bottom: 1px dotted #ddd;
        }

        .receipt-table .label {
            width: 190px;
            font-weight: 600;
            color: #444;
        }


    /* STATUS */

    .status-paid {
        font-weight: bold;
        text-transform: uppercase;
    }


    /* AMOUNT */

    .amount-box {
        border: 2px solid #222;
        padding: 18px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 25px 0;
    }

    .amount-label {
        font-size: 16px;
        font-weight: bold;
    }

    .amount-value {
        font-size: 27px;
        font-weight: bold;
    }


    /* REMARKS */

    .remarks-section {
        margin-top: 20px;
        font-size: 14px;
    }


    /* ACKNOWLEDGEMENT */

    .acknowledgement {
        margin-top: 25px;
        font-size: 13px;
        line-height: 1.6;
        color: #444;
    }


    /* SIGNATURE */

    .signature-section {
        display: flex;
        justify-content: space-between;
        gap: 60px;
        margin-top: 70px;
    }

    .signature-box {
        width: 45%;
        text-align: center;
    }

    .signature-line {
        border-top: 1px solid #222;
        margin-bottom: 7px;
    }

    .signature-label {
        font-size: 13px;
    }


    /* FOOTER */

    .receipt-footer {
        margin-top: 45px;
        padding-top: 15px;
        border-top: 1px solid #ddd;
        text-align: center;
        font-size: 12px;
        color: #666;
    }


    /* PRINT */

    @@media print {

        body {
            background: white !important;
        }

        .no-print,
        header,
        footer,
        nav {
            display: none !important;
        }

        body * {
            visibility: hidden;
        }

        #receipt,
        #receipt * {
            visibility: visible;
        }

        #receipt {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            max-width: none;
            margin: 0;
            padding: 20px 30px;
            border: none;
            box-shadow: none;
        }

        @@page {
            size: A4;
            margin: 12mm;
        }
    }

</style>