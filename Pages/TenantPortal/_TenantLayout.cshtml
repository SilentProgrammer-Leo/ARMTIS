@using ARMTIS_Capstone_Project.Data
@using ARMTIS_Capstone_Project.MVVM.Models.Identity
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore

@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext

@{
    var currentUser = await UserManager.GetUserAsync(User);

    string tenantName = "Tenant";
    int unreadNotificationCount = 0;

    if (currentUser?.TenantID != null)
    {
        var currentTenant = await DbContext.Tenants
            .AsNoTracking()
            .FirstOrDefaultAsync(t => t.TenantID == currentUser.TenantID.Value);

        if (currentTenant != null)
        {
            tenantName = $"{currentTenant.FirstName} {currentTenant.LastName}";
        }

        unreadNotificationCount = await DbContext.Notifications
            .CountAsync(n =>
                n.TenantID == currentUser.TenantID.Value &&
                !n.IsRead);
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Tenant Portal</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/tenant-portal.css" asp-append-version="true" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>

<body>

    <div class="d-flex tenant-portal-layout">

        <!-- TENANT SIDEBAR -->
        <aside class="tenant-sidebar">

            <div class="tenant-sidebar-brand">

                <h4>
                    <i class="bi bi-building"></i>
                    Tenant Portal
                </h4>

            </div>

            <hr />

            <nav class="nav flex-column gap-2">

                <a class="nav-link text-white"
                   href="/TenantPortal/Dashboard">
                    <i class="bi bi-speedometer2 "></i>
                    Dashboard
                </a>

                <a class="nav-link text-white"
                   href="/TenantPortal/Profile">
                    <i class="bi bi-person "></i>
                    My Profile
                </a>

                <a class="nav-link text-white"
                   href="/TenantPortal/TenantUnit">
                    <i class="bi bi-house "></i>
                    My Unit
                </a>

                <a class="nav-link text-white"
                   href="/TenantPortal/Billing">
                    <i class="bi bi-receipt "></i>
                    My Bills
                </a>

                <a class="nav-link text-white"
                   href="/TenantPortal/Payment">
                    <i class="bi bi-credit-card "></i>
                    Payment History
                </a>

                <a class="nav-link text-white"
                   href="/TenantPortal/Utilities">
                    <i class="bi bi-lightning-charge "></i>
                    Utilities
                </a>

                <a class="nav-link text-white"
                   href="/TenantPortal/Maintenance">
                    <i class="bi bi-tools "></i>
                    Maintenance
                </a>

            </nav>

            <hr />

        </aside>


        <!-- MAIN CONTENT -->
        <main class="tenant-main">

            <!-- TOP BAR -->
            <header class="tenant-header">

                <div class="d-flex align-items-center justify-content-end gap-4">

                    <!-- NOTIFICATIONS -->
                    <a asp-page="/TenantPortal/Notifications/Index"
                       class="tenant-notification"
                       title="Notifications">

                        <i class="bi bi-bell-fill"></i>

                        @if (unreadNotificationCount > 0)
                        {
                            <span class="tenant-notification-badge">
                                @unreadNotificationCount
                            </span>
                        }

                    </a>


                    <!-- TENANT NAME -->
                    <div class="tenant-header-user">

                        <i class="bi bi-person-circle"></i>

                        <span>
                            @tenantName
                        </span>

                    </div>


                    <!-- LOGOUT -->
                    <form method="post"
                          action="/Account/Logout"
                          class="mb-0">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="tenant-logout-btn">

                            <i class="bi bi-box-arrow-right me-1"></i>
                            Logout

                        </button>

                    </form>

                </div>

            </header>


            <!-- PAGE CONTENT -->
            <div class="tenant-content">

                @RenderBody()

            </div>

        </main>

    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
