@page
@model ARMTIS_Capstone_Project.Pages.TenantPortal.Maintenance.IndexModel

@{
    Layout = "/Pages/TenantPortal/_TenantLayout.cshtml";
    ViewData["Title"] = "Maintenance Requests";
}

<div class="container-fluid py-4">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-tools me-2"></i>
                Maintenance Requests
            </h2>

            <p class="text-muted mb-0">
                Submit and track your maintenance concerns.
            </p>
        </div>

        <div>
            <a asp-page="./Create"
               class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>
                New Request
            </a>
        </div>

    </div>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-1"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <!-- SUMMARY CARDS -->
    <div class="row g-3 mb-4">

        <!-- TOTAL -->
        <div class="col-md-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="rounded-circle bg-primary bg-opacity-10
                        text-primary p-3 me-3">

                        <i class="bi bi-clipboard-check fs-4"></i>

                    </div>

                    <div>

                        <small class="text-muted">
                            Total Requests
                        </small>

                        <h4 class="fw-bold mb-0">
                            @Model.TotalRequests
                        </h4>

                    </div>

                </div>

            </div>

        </div>


        <!-- PENDING -->
        <div class="col-md-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="rounded-circle bg-warning bg-opacity-10
                        text-warning p-3 me-3">

                        <i class="bi bi-clock-history fs-4"></i>

                    </div>

                    <div>

                        <small class="text-muted">
                            Pending
                        </small>

                        <h4 class="fw-bold mb-0">
                            @Model.PendingRequests
                        </h4>

                    </div>

                </div>

            </div>

        </div>


        <!-- IN PROGRESS -->
        <div class="col-md-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="rounded-circle bg-info bg-opacity-10
                        text-info p-3 me-3">

                        <i class="bi bi-wrench-adjustable fs-4"></i>

                    </div>

                    <div>

                        <small class="text-muted">
                            In Progress
                        </small>

                        <h4 class="fw-bold mb-0">
                            @Model.InProgressRequests
                        </h4>

                    </div>

                </div>

            </div>

        </div>


        <!-- COMPLETED -->
        <div class="col-md-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="rounded-circle bg-success bg-opacity-10
                        text-success p-3 me-3">

                        <i class="bi bi-check-circle fs-4"></i>

                    </div>

                    <div>

                        <small class="text-muted">
                            Completed
                        </small>

                        <h4 class="fw-bold mb-0">
                            @Model.CompletedRequests
                        </h4>

                    </div>

                </div>

            </div>

        </div>

        <!-- CANCELLED -->

        <div class="col">
            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="rounded-circle bg-danger bg-opacity-10
                        text-danger p-3 me-3">

                        <i class="bi bi-x-circle fs-4"></i>

                    </div>

                    <div>

                        <small class="text-muted">
                            Cancelled
                        </small>

                        <h4 class="fw-bold mb-0">
                            @Model.CancelledRequests
                        </h4>

                    </div>

                </div>

            </div>
        </div>

    </div>


    <!-- REQUEST TABLE -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">

            <h5 class="fw-bold mb-0">
                My Maintenance Requests
            </h5>

        </div>


        <div class="card-body">

            @if (Model.MaintenanceRequests.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Request #
                                </th>

                                <th>
                                    Request
                                </th>

                                <th>
                                    Category
                                </th>

                                <th>
                                    Priority
                                </th>

                                <th>
                                    Date Submitted
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Completed
                                </th>
                                <th>
                                    Action
                                </th>
                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in Model.MaintenanceRequests)
                            {
                                <tr>

                                    <!-- REQUEST NUMBER -->
                                    <td>
                                        <span class="fw-semibold">
                                            #@item.MaintenanceRequestID
                                        </span>
                                    </td>


                                    <!-- TITLE -->
                                    <td>
                                        <div class="fw-semibold">
                                            @item.RequestTitle
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <small class="text-muted">
                                                @item.Description
                                            </small>
                                        }
                                    </td>


                                    <!-- CATEGORY -->
                                    <td>
                                        @if (string.IsNullOrWhiteSpace(item.Category))
                                        {
                                            <span class="text-muted">
                                                Not specified
                                            </span>
                                        }
                                        else
                                        {
                                            @item.Category
                                        }
                                    </td>


                                    <!-- PRIORITY -->
                                    <td>

                                        @if (item.Priority == "High")
                                        {
                                            <span class="badge bg-danger">
                                                High
                                            </span>
                                        }
                                        else if (item.Priority == "Medium")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Medium
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Low
                                            </span>
                                        }

                                    </td>


                                    <!-- REQUEST DATE -->
                                    <td>
                                        @item.RequestDate.ToString("MMM dd, yyyy")
                                    </td>


                                    <!-- STATUS -->
                                    <td>

                                        @if (item.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                        else if (item.Status == "In Progress")
                                        {
                                            <span class="badge bg-primary">
                                                In Progress
                                            </span>
                                        }
                                        else if (item.Status == "Completed")
                                        {
                                            <span class="badge bg-success">
                                                Completed
                                            </span>
                                        }
                                        else if (item.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @item.Status
                                            </span>
                                        }

                                    </td>


                                    <!-- COMPLETED DATE -->
                                    <td>

                                        @if (item.CompletedDate.HasValue)
                                        {
                                            @item.CompletedDate.Value.ToString("MMM dd, yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>
                                    <!-- ACTION -->
                                    <td>

                                        @if (string.Equals(item.Status, "Pending", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <form method="post"
                                                  asp-page-handler="Cancel"
                                                  asp-route-id="@item.MaintenanceRequestID"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to cancel this maintenance request?');">

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-x-circle me-1"></i>
                                                    Cancel
                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-tools text-muted"
                       style="font-size: 3rem;"></i>

                    <h5 class="mt-3">
                        No Maintenance Requests
                    </h5>

                    <p class="text-muted">
                        You haven't submitted any maintenance requests yet.
                    </p>

                    <a asp-page="./Create"
                       class="btn btn-primary">

                        <i class="bi bi-plus-circle me-1"></i>
                        Submit a Request

                    </a>

                </div>
            }

        </div>

    </div>

</div>