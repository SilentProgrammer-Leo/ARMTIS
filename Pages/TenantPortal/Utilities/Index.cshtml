@page
@model ARMTIS_Capstone_Project.Pages.TenantPortal.Utilities.IndexModel

@{
    Layout = "/Pages/TenantPortal/_TenantLayout.cshtml";
    ViewData["Title"] = "My Utilities";
}

<div class="container-fluid py-4">

    <!-- PAGE HEADER -->
    <div class="mb-4">
        <h2 class="fw-bold mb-1">
            <i class="bi bi-lightning-charge-fill me-2"></i>
            My Utilities
        </h2>

        <p class="text-muted mb-0">
            View your electricity and water consumption records.
        </p>
    </div>


    <!-- SUMMARY CARDS -->
    <div class="row g-3 mb-4">

        <!-- ELECTRICITY -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="rounded-circle bg-warning bg-opacity-10
                        text-warning p-3 me-3">
                        <i class="bi bi-lightning-charge-fill fs-4"></i>
                    </div>

                    <div>
                        <small class="text-muted">
                            Total Electricity Consumption
                        </small>

                        <h4 class="fw-bold mb-0">
                            @Model.TotalElectricityConsumption.ToString("N2")
                            <small class="fs-6 text-muted">kWh</small>
                        </h4>
                    </div>

                </div>

            </div>
        </div>


        <!-- WATER -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="rounded-circle bg-info bg-opacity-10
                        text-info p-3 me-3">
                        <i class="bi bi-droplet-fill fs-4"></i>
                    </div>

                    <div>
                        <small class="text-muted">
                            Total Water Consumption
                        </small>

                        <h4 class="fw-bold mb-0">
                            @Model.TotalWaterConsumption.ToString("N2")
                            <small class="fs-6 text-muted">m³</small>
                        </h4>
                    </div>

                </div>

            </div>
        </div>


        <!-- RECORDS -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="rounded-circle bg-success bg-opacity-10
                        text-success p-3 me-3">
                        <i class="bi bi-bar-chart-fill fs-4"></i>
                    </div>

                    <div>
                        <small class="text-muted">
                            Utility Records
                        </small>

                        <h4 class="fw-bold mb-0">
                            @Model.TotalRecords
                        </h4>
                    </div>

                </div>

            </div>
        </div>

    </div>


    <!-- UTILITY RECORDS -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">

            <h5 class="fw-bold mb-0">
                <i class="bi bi-clipboard-data me-2"></i>
                Utility Reading History
            </h5>

        </div>


        <div class="card-body">

            @if (Model.UtilityReadings.Count == 0)
            {
                <div class="text-center py-5">

                    <i class="bi bi-bar-chart-line text-muted"
                       style="font-size: 3rem;"></i>

                    <h5 class="mt-3">
                        No Utility Records
                    </h5>

                    <p class="text-muted mb-0">
                        Your electricity and water readings will appear here.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>
                                <th>Billing Month</th>

                                <th colspan="4"
                                    class="text-center">
                                    <i class="bi bi-lightning-charge-fill text-warning"></i>
                                    Electricity
                                </th>

                                <th colspan="4"
                                    class="text-center">
                                    <i class="bi bi-droplet-fill text-info"></i>
                                    Water
                                </th>
                            </tr>

                            <tr>
                                <th></th>

                                <th>Previous</th>
                                <th>Current</th>
                                <th>Consumption</th>
                                <th>Rate</th>

                                <th>Previous</th>
                                <th>Current</th>
                                <th>Consumption</th>
                                <th>Rate</th>
                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var utility in Model.UtilityReadings)
                            {
                                <tr>

                                    <!-- BILLING MONTH -->
                                    <td>
                                        <span class="badge bg-primary">
                                            @utility.BillingMonth.ToString("MMMM yyyy")
                                        </span>
                                    </td>


                                    <!-- ELECTRICITY PREVIOUS -->
                                    <td>
                                        @utility.PreviousElectricReading.ToString("N2")
                                    </td>


                                    <!-- ELECTRICITY CURRENT -->
                                    <td>
                                        @utility.CurrentElectricReading.ToString("N2")
                                    </td>


                                    <!-- ELECTRICITY CONSUMPTION -->
                                    <td>
                                        <span class="fw-semibold">
                                            @utility.ElectricConsumption.ToString("N2")
                                        </span>
                                        <small class="text-muted">
                                            kWh
                                        </small>
                                    </td>


                                    <!-- ELECTRICITY RATE -->
                                    <td>
                                        ₱@utility.ElectricRate.ToString("N2")
                                    </td>


                                    <!-- WATER PREVIOUS -->
                                    <td>
                                        @utility.PreviousWaterReading.ToString("N2")
                                    </td>


                                    <!-- WATER CURRENT -->
                                    <td>
                                        @utility.CurrentWaterReading.ToString("N2")
                                    </td>


                                    <!-- WATER CONSUMPTION -->
                                    <td>
                                        <span class="fw-semibold">
                                            @utility.WaterConsumption.ToString("N2")
                                        </span>
                                        <small class="text-muted">
                                            m³
                                        </small>
                                    </td>


                                    <!-- WATER RATE -->
                                    <td>
                                        ₱@utility.WaterRate.ToString("N2")
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>