@using ARMTIS_Capstone_Project.Data
@using ARMTIS_Capstone_Project.MVVM.Models.Identity
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext

@{
    var currentAdminUser = await UserManager.GetUserAsync(User);
    var adminUnreadNotificationCount = currentAdminUser == null
        ? 0
        : await DbContext.Notifications.CountAsync(n =>
            n.RecipientUserID == currentAdminUser.Id &&
            !n.IsRead);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ARMTIS_Capstone_Project</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/Create.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ARMTIS_Capstone_Project.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <div class="app-shell">

        <button class="mobile-menu-toggle" type="button" aria-label="Open navigation">
            <i class="bi bi-list"></i>
        </button>

        <div class="sidebar-backdrop"></div>

        <nav class="sidebar" aria-label="Main navigation">
            <div class="sidebar-brand">
                <div class="brand-mark"><i class="bi bi-buildings"></i></div>
                <div>
                    <div class="brand-name">Tressing Residency</div>
                    <div class="brand-subtitle">Rental Management</div>
                </div>
            </div>

            <div class="sidebar-section-label">MAIN MENU</div>

            <a asp-page="/Index" class="nav-link">
                <i class="bi bi-grid-1x2-fill"></i><span>Dashboard</span>
            </a>

            <a asp-page="/UnitPages/Index" class="nav-link">
                <i class="bi bi-door-open-fill"></i><span>Units</span>
            </a>

            <div class="nav-group tenant-menu">
                <button type="button" class="nav-link nav-toggle tenant-toggle" aria-expanded="false">
                    <span class="nav-link-label"><i class="bi bi-people-fill"></i><span>Tenant Management</span></span>
                    <i class="bi bi-chevron-down arrow"></i>
                </button>
                <ul class="nav-submenu tenant-submenu">
                    <li><a asp-page="/TenantPages/Index"><i class="bi bi-person-lines-fill"></i><span>Tenants</span></a></li>
                    <li><a asp-page="/TenantPages/Account/Index"><i class="bi bi-person-gear"></i><span>Accounts</span></a></li>
                </ul>
            </div>

            <div class="nav-group payment-menu">
                <button type="button" class="nav-link nav-toggle payment-toggle" aria-expanded="false">
                    <span class="nav-link-label"><i class="bi bi-receipt-cutoff"></i><span>Billing Management</span></span>
                    <i class="bi bi-chevron-down arrow"></i>
                </button>
                <ul class="nav-submenu payment-submenu">
                    <li><a asp-page="/UtilityReadingPages/Index"><i class="bi bi-speedometer2"></i><span>Utility Reading</span></a></li>
                    <li><a asp-page="/PaymentPages/BillingStatementPages/Index"><i class="bi bi-file-earmark-text"></i><span>Billing Statements</span></a></li>
                    <li><a asp-page="/PaymentPages/PaymentHistory/Index"><i class="bi bi-clock-history"></i><span>Payment History</span></a></li>
                </ul>
            </div>

            <a asp-page="/Maintenance/MaintenanceIndex" class="nav-link">
                <i class="bi bi-tools"></i><span>Maintenance</span>
            </a>

            <a asp-page="/Reports/ReportsIndex" class="nav-link">
                <i class="bi bi-bar-chart-line-fill"></i><span>Reports</span>
            </a>

           @*  <a asp-page="/AuditLogs/Index" class="nav-link">
                <i class="bi bi-journal-text"></i><span>Activity Logs</span>
            </a> *@
            <div class="nav-group notification-menu">

                <button type="button"
                        class="nav-link nav-toggle notification-toggle"
                        aria-expanded="false">

                    <span class="nav-link-label">

                        <i class="bi bi-bell-fill"></i>

                        <span>Notification Management</span>

                    </span>

                    <i class="bi bi-chevron-down arrow"></i>

                </button>


                <ul class="nav-submenu notification-submenu">

                    <!-- NOTIFICATION INBOX -->
                    <li>
                        <a asp-page="/Notifications/Index">

                            <i class="bi bi-inbox-fill"></i>

                            <span>Notifications</span>

                        </a>
                    </li>


                    <!-- CREATE REMINDER -->
                    <li>
                        <a asp-page="/Notifications/Create">

                            <i class="bi bi-send-fill"></i>

                            <span>Send Reminder</span>

                        </a>
                    </li>

                </ul>

            </div>
            <!-- Settings Management -->
            <div class="nav-group settings-menu">

                <button type="button"
                        class="nav-link nav-toggle settings-toggle"
                        aria-expanded="false">

                    <span class="nav-link-label">

                        <i class="bi bi-gear-fill"></i>

                        <span>Settings</span>

                    </span>

                    <i class="bi bi-chevron-down arrow"></i>

                </button>


                <ul class="nav-submenu settings-submenu">

                    <!-- APARTMENT INFORMATION -->
                    <li>
                        <a asp-page="/Settings/Index">

                            <i class="bi bi-building"></i>

                            <span>Apartment Information</span>

                        </a>
                    </li>


                    <!-- ACCOUNT & SECURITY -->
                    <li>
                        <a asp-page="/Settings/AccountSecurity/Index">
                            <i class="bi bi-shield-lock"></i>
                            <span>Account & Security</span>
                        </a>
                    </li>

                </ul>

            </div>

            <div class="sidebar-footer">
                <div class="system-status">
                    <span class="status-dot"></span>
                    <span>System Online</span>
                </div>
            </div>
        </nav>

        <div class="main-content">
            <header class="top-header">
                <div class="header-left">
                    @* <div>
                        <div class="header-page-title">@ViewData["Title"]</div>
                        <div class="header-page-subtitle">Apartment Rental Management System</div>
                    </div> *@
                </div>

                <div class="header-right">
                    <a asp-page="/Notifications/Index" class="header-icon" title="Notifications" aria-label="Notifications">
                        <i class="bi bi-bell-fill"></i>
                        @if (adminUnreadNotificationCount > 0)
                        {
                            <span class="notification-badge">@adminUnreadNotificationCount</span>
                        }
                    </a>

                    <div class="user-info">
                        <div class="user-icon"><i class="bi bi-person-fill"></i></div>
                        <div class="user-details">
                            <span class="user-name">Admin</span>
                            <span class="user-role">Administrator</span>
                        </div>
                    </div>

                    <form method="post" asp-page="/Account/Logout" class="d-inline">
                        <button type="submit" class="btn btn-logout">
                            <i class="bi bi-box-arrow-right"></i>
                            <span>Logout</span>
                        </button>
                    </form>
                </div>
            </header>

            <main role="main" class="page-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="app-footer">

        <div class="container-fluid">

            <div class="footer-content">

                <!-- BRAND -->
                <div class="footer-brand">

                    <div class="footer-logo">
                        <i class="bi bi-building"></i>
                    </div>

                    <div>
                        <div class="footer-title">
                            ARMTIS
                        </div>

                      @*   <div class="footer-subtitle">
                            Apartment Rental Management Information System
                        </div> *@
                    </div>

                </div>


                <!-- LINKS / INFO -->
                <div class="footer-info">

                    <a asp-area=""
                       asp-page="/Privacy"
                       class="footer-link">

                        Privacy Policy

                    </a>

                    <span class="footer-divider"></span>

                    <span class="footer-system">

                        <i class="bi bi-shield-check me-1"></i>
                        Secure System

                    </span>

                    <span class="footer-divider"></span>

                    <span class="footer-copy">

                        &copy; 2026 ARMTIS

                    </span>

                </div>

            </div>

        </div>

    </footer>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const toggles = document.querySelectorAll(".nav-toggle");

            toggles.forEach(function (toggle) {
                toggle.addEventListener("click", function () {
                    const group = toggle.closest(".nav-group");
                    const submenu = group.querySelector(".nav-submenu");
                    const isOpen = submenu.classList.toggle("show");

                    toggle.classList.toggle("active", isOpen);
                    toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
                });
            });

            const currentPath = window.location.pathname.toLowerCase();

            document.querySelectorAll(".sidebar a.nav-link, .nav-submenu a").forEach(function (link) {
                const href = (link.getAttribute("href") || "").toLowerCase();
                if (href && href !== "#" && currentPath === href) {
                    link.classList.add("active");

                    const group = link.closest(".nav-group");
                    if (group) {
                        const submenu = group.querySelector(".nav-submenu");
                        const toggle = group.querySelector(".nav-toggle");
                        submenu.classList.add("show");
                        toggle.classList.add("active");
                        toggle.setAttribute("aria-expanded", "true");
                    }
                }
            });

            const menuButton = document.querySelector(".mobile-menu-toggle");
            const sidebar = document.querySelector(".sidebar");
            const backdrop = document.querySelector(".sidebar-backdrop");

            function closeSidebar() {
                sidebar.classList.remove("mobile-open");
                backdrop.classList.remove("show");
            }

            menuButton?.addEventListener("click", function () {
                sidebar.classList.toggle("mobile-open");
                backdrop.classList.toggle("show");
            });

            backdrop?.addEventListener("click", closeSidebar);
        });
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
