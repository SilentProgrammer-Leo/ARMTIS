@page
@model ARMTIS_Capstone_Project.Pages.UtilityReadingPages.UtilityRateIndexModel
@{
    ViewData["Title"] = "Utility Rates";
}

<h1>Utility Rates</h1>

<p>
    <a asp-page="./UtilityRateCreateIndex"
       class="btn btn-success">

        <i class="bi bi-plus-circle"></i>
        Add New Rate

    </a>
</p>

<table class="table table-striped table-hover">

    <thead class="table-dark">
        <tr>
            <th>Utility</th>
            <th>Rate</th>
            <th>Effective From</th>
            <th>Effective To</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model.UtilityRates)
        {
            <tr>

                <td>
                    @item.UtilityType
                </td>

                <td>
                    ₱@item.Rate.ToString("N2")
                </td>

                <td>
                    @item.EffectiveFrom.ToString("MMMM dd, yyyy")
                </td>

                <td>
                    @(item.EffectiveTo.HasValue
                        ? item.EffectiveTo.Value.ToString("MMMM dd, yyyy")
                        : "Current")
                </td>

                <td>
                    @if (item.IsActive)
                    {
                        <span class="badge bg-success">
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            Historical
                        </span>
                    }
                </td>
                <td>
                    <a asp-page="./UtilityRateEditIndex"
                       asp-route-id="@item.UtilityRateID"
                       class="btn btn-outline-primary btn-sm">

                        <i class="bi bi-pencil-square"></i>
                        Edit

                    </a>
                </td>

            </tr>
        }

    </tbody>

</table>
