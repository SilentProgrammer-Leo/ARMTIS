@page
@model ARMTIS_Capstone_Project.Pages.UtilityReadingPages.IndexModel

@{
    ViewData["Title"] = "Utility Reading";
}

<h1>Utility Reading</h1>


<form method="get" class="row mb-4">

    <div class="col-md-3">
        <label class="form-label">Month</label>

        <select asp-for="SelectedMonth"
                class="form-select"
                required>

            <option value="">-- Select Month --</option>

            @for (int month = 1; month <= 12; month++)
            {
                <option value="@month">
                    @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)
                </option>
            }

        </select>
    </div>

    <div class="col-md-3">
        <label class="form-label">Year</label>

        <select asp-for="SelectedYear"
                class="form-select"
                required>

            <option value="">-- Select Year --</option>

            @for (int year = DateTime.Now.Year - 1;
                 year <= DateTime.Now.Year + 3;
                 year++)
            {
                <option value="@year">
                    @year
                </option>
            }

        </select>
    </div>

    <div class="col-md-3 d-flex align-items-end">     

        <button type="submit"
                class="btn btn-primary">

            Load Utility Readings
        </button>
    </div>

   
</form>

<div class="card shadow-sm mb-4">

    <div class="card-body">

        <div class="d-flex justify-content-between
            align-items-center flex-wrap gap-3">

            <div>

                <h6 class="fw-bold mb-2">
                    Current Utility Rates
                </h6>

                <div class="d-flex gap-4 flex-wrap">

                    <!-- ELECTRICITY -->

                    <div>
                        <i class="bi bi-lightning-charge"></i>

                        <strong>Electricity:</strong>

                        @if (Model.CurrentElectricRate != null)
                        {
                            <span>
                                ₱@Model.CurrentElectricRate.Rate.ToString("N2")
                                / kWh
                            </span>
                        }
                        else
                        {
                            <span class="text-danger">
                                No active rate
                            </span>
                        }
                    </div>


                    <!-- WATER -->

                    <div>
                        <i class="bi bi-droplet"></i>

                        <strong>Water:</strong>

                        @if (Model.CurrentWaterRate != null)
                        {
                            <span>
                                ₱@Model.CurrentWaterRate.Rate.ToString("N2")
                                / m³
                            </span>
                        }
                        else
                        {
                            <span class="text-danger">
                                No active rate
                            </span>
                        }
                    </div>

                    <!-- INTERNET -->
                    <div>
                        <i class="bi bi-wifi"></i>

                        <strong>Internet:</strong>

                        @if (Model.CurrentInternetRate != null)
                        {
                            <span>
                                ₱@Model.CurrentInternetRate.Rate.ToString("N2")
                                / month
                            </span>
                        }
                        else
                        {
                            <span class="text-danger">
                                No active rate
                            </span>
                        }
                    </div>
                </div>

            </div>


            <!-- MANAGE RATE BUTTON -->

            <a asp-page="./UtilityRateIndex"
               class="btn btn-outline-primary">

                <i class="bi bi-gear"></i>
                Manage Utility Rates

            </a>

        </div>

    </div>

</div>

<table class="table table-striped table-hover">

    <thead class="table-dark">
        <tr>
            <th>Unit</th>
            <th>Tenant</th>
            <th>Billing Month</th>
            <th>Electricity</th>
            <th>Water</th>
            <th>Internet</th>
            <th>Total Utilities</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>

        @if (!Model.UtilityRows.Any())
        {
            <tr>
                <td colspan="9"
                    class="text-center">

                    Select a month and year,
                    then click
                    <strong>Load Utility Readings</strong>.

                </td>
            </tr>
        }
        else
        {
            foreach (var item in Model.UtilityRows)
            {
                <tr>

                    <td>
                        @item.UnitNumber
                    </td>

                    <td>
                        @item.TenantName
                    </td>

                    <td>
                        @item.BillingMonth.ToString("MMMM yyyy")
                    </td>

                    <td>
                        ₱@item.ElectricityBill.ToString("N2")
                    </td>

                    <td>
                        ₱@item.WaterBill.ToString("N2")
                    </td>

                    <td>
                        ₱@item.InternetBill.ToString("N2")
                    </td>

                    <td class="fw-bold">
                        ₱@item.TotalUtilityCharges.ToString("N2")
                    </td>

                    <td>

                        @if (item.HasReading)
                        {
                            <span class="badge bg-success">
                                Completed
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Not Encoded
                            </span>
                        }

                    </td>

                    <td>

                        <button type="button"
                                class="btn btn-outline-primary btn-sm utilityBtn"
                                data-tenantid="@item.TenantID"
                                data-unitid="@item.UnitID"
                                data-tenant="@item.TenantName"
                                data-unit="@item.UnitNumber">

                            <i class="bi bi-lightning-charge"></i>
                            Utilities
                        </button>

                    </td>

                </tr>
            }
        }

    </tbody>

</table>

@Html.AntiForgeryToken()
<div class="modal fade"
     id="utilityModal"
     tabindex="-1"
     aria-labelledby="utilityModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-scrollable">

        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header">

                <h5 class="modal-title"
                    id="utilityModalLabel">
                    Utility Reading
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <!-- BODY -->
            <div class="modal-body">

                <input type="hidden"
                       id="UtilityTenantID" />

                <input type="hidden"
                       id="UtilityUnitID" />


                <!-- TENANT / UNIT -->
                <div class="row mb-3">

                    <div class="col-md-6">
                        <label class="form-label">
                            Tenant
                        </label>

                        <input id="UtilityTenant"
                               class="form-control"
                               readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            Unit
                        </label>

                        <input id="UtilityUnit"
                               class="form-control"
                               readonly />
                    </div>

                </div>


                <div id="firstReadingNotice"
                     class="alert alert-info d-none">

                    No previous utility reading was found.
                    Please enter the initial meter readings.

                </div>

                <hr />


                <!-- ======================= -->
                <!-- ELECTRICITY -->
                <!-- ======================= -->

                <h6 class="fw-bold mb-3">
                    Electricity
                </h6>

                <div class="row">

                    <div class="col-md-3 mb-3">

                        <label class="form-label">
                            Previous Reading
                        </label>

                        <input id="PreviousElectricReading"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control"
                               readonly />

                    </div>


                    <div class="col-md-3 mb-3">

                        <label class="form-label">
                            Current Reading
                        </label>

                        <input id="CurrentElectricReading"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control" />

                    </div>


                    <div class="col-md-3 mb-3">

                        <label class="form-label">
                            Consumption
                        </label>

                        <input id="ElectricConsumption"
                               type="number"
                               class="form-control"
                               readonly />

                    </div>


                    <div class="col-md-3 mb-3">

                        <label class="form-label">
                            Rate per kWh
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                ₱
                            </span>

                            <input id="ElectricRate"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control" 
                                   readonly/>

                        </div>

                    </div>

                </div>


                <div class="mb-3">

                    <label class="form-label">
                        Electricity Bill
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            ₱
                        </span>

                        <input id="ElectricityBill"
                               type="number"
                               class="form-control"
                               readonly />

                    </div>

                </div>

                <hr />


                <!-- WATER -->

                <h6 class="fw-bold mb-3">
                    Water
                </h6>

                <div class="row">

                    <div class="col-md-3 mb-3">

                        <label class="form-label">
                            Previous Reading
                        </label>

                        <input id="PreviousWaterReading"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control"
                               readonly />

                    </div>


                    <div class="col-md-3 mb-3">

                        <label class="form-label">
                            Current Reading
                        </label>

                        <input id="CurrentWaterReading"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control" />

                    </div>


                    <div class="col-md-3 mb-3">

                        <label class="form-label">
                            Consumption
                        </label>

                        <input id="WaterConsumption"
                               type="number"
                               class="form-control"
                               readonly />

                    </div>


                    <div class="col-md-3 mb-3">

                        <label class="form-label">
                            Rate per m³
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                ₱
                            </span>

                            <input id="WaterRate"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control"
                                   readonly/>

                        </div>

                    </div>

                </div>


                <div class="mb-3">

                    <label class="form-label">
                        Water Bill
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            ₱
                        </span>

                        <input id="WaterBill"
                               type="number"
                               class="form-control"
                               readonly />

                    </div>

                </div>

                <hr />


                <!-- INTERNET -->
                <div class="mb-3">

                    <label class="form-label">
                        Internet
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            ₱
                        </span>

                        <input id="InternetBill"
                               type="number"
                               class="form-control"
                               value="300.00"
                               readonly />

                    </div>

                </div>


                <!-- TOTAL -->
                <div class="mb-3">

                    <label class="form-label fw-bold">
                        Total Utility Charges
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            ₱
                        </span>

                        <input id="TotalUtilityCharges"
                               type="number"
                               class="form-control fw-bold"
                               readonly />

                    </div>

                </div>


                <div id="utilityError"
                     class="alert alert-danger d-none">
                </div>

            </div>


            <!-- FOOTER -->
            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Cancel

                </button>

                <button type="button"
                        id="saveUtilityReading"
                        class="btn btn-success">

                    <i class="bi bi-check-circle"></i>
                    Save Utility Reading

                </button>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {

            
            // MODAL
            

            const modalElement =
                document.getElementById("utilityModal");

            if (!modalElement) {
                console.error("Utility modal was not found.");
                return;
            }

            const utilityModal =
                bootstrap.Modal.getOrCreateInstance(modalElement);


            
            // INPUT ELEMENTS
          

            const previousElectricInput =
                document.getElementById(
                    "PreviousElectricReading"
                );

            const currentElectricInput =
                document.getElementById(
                    "CurrentElectricReading"
                );

            const electricConsumptionInput =
                document.getElementById(
                    "ElectricConsumption"
                );

            const electricRateInput =
                document.getElementById(
                    "ElectricRate"
                );

            const electricityBillInput =
                document.getElementById(
                    "ElectricityBill"
                );


            const previousWaterInput =
                document.getElementById(
                    "PreviousWaterReading"
                );

            const currentWaterInput =
                document.getElementById(
                    "CurrentWaterReading"
                );

            const waterConsumptionInput =
                document.getElementById(
                    "WaterConsumption"
                );

            const waterBillInput =
                document.getElementById(
                    "WaterBill"
                );


            const internetBillInput =
                document.getElementById(
                    "InternetBill"
                );

            const totalUtilityInput =
                document.getElementById(
                    "TotalUtilityCharges"
                );

            const firstReadingNotice =
                document.getElementById(
                    "firstReadingNotice"
                );


           
            // CALCULATE UTILITIES
            

            function calculateUtilities() {

           
                // ELECTRICITY
              

                const previousElectric =
                    parseFloat(
                        previousElectricInput.value
                    ) || 0;

                const currentElectric =
                    parseFloat(
                        currentElectricInput.value
                    ) || 0;

                const electricRate =
                    parseFloat(
                        electricRateInput.value
                    ) || 0;

                let electricConsumption = 0;

                // Only calculate if a current reading was entered.
                if (currentElectricInput.value !== "") {

                    electricConsumption =
                        currentElectric -
                        previousElectric;

                    if (electricConsumption < 0) {
                        electricConsumption = 0;
                    }
                }


                const electricityBill =
                    electricConsumption *
                    electricRate;


                electricConsumptionInput.value =
                    electricConsumption.toFixed(2);

                electricityBillInput.value =
                    electricityBill.toFixed(2);


    
                // WATER
              
                const previousWater =
                    parseFloat(
                        previousWaterInput.value
                    ) || 0;

                const currentWater =
                    parseFloat(
                        currentWaterInput.value
                    ) || 0;

                const waterRate =
                    parseFloat(
                        document.getElementById(
                            "WaterRate"
                        ).value
                    ) || 0;


                let waterConsumption = 0;

                if (currentWaterInput.value !== "") {

                    waterConsumption =
                        currentWater -
                        previousWater;

                    if (waterConsumption < 0) {
                        waterConsumption = 0;
                    }
                }


                const waterBill =
                    waterConsumption *
                    waterRate;


                waterConsumptionInput.value =
                    waterConsumption.toFixed(2);

                waterBillInput.value =
                    waterBill.toFixed(2);
                
                // INTERNET
                

                const internetBill =
                    parseFloat(
                        internetBillInput.value
                    ) || 0;

                internetBillInput.value =
                    internetBill.toFixed(2);


                
                // TOTAL
               

                const totalUtility =
                    electricityBill +
                    waterBill +
                    internetBill;


                totalUtilityInput.value =
                    totalUtility.toFixed(2);
            }


            
            // CALCULATE WHEN USER TYPES
           

            previousElectricInput.addEventListener(
                "input",
                calculateUtilities
            );

            currentElectricInput.addEventListener(
                "input",
                calculateUtilities
            );
            electricRateInput.addEventListener(
                "input",
                calculateUtilities
            );

            previousWaterInput.addEventListener(
                "input",
                calculateUtilities
            );

            currentWaterInput.addEventListener(
                "input",
                calculateUtilities
            );

            document.getElementById("WaterRate")
            .addEventListener(
                "input",
                calculateUtilities
            );
            
            // OPEN UTILITY MODAL
            

            document.querySelectorAll(".utilityBtn")
                .forEach(function(button) {

                    button.addEventListener(
                        "click",
                        async function() {

                            const tenantId =
                                this.dataset.tenantid;

                            const unitId =
                                this.dataset.unitid;


                        
                            // Tenant and Unit
                        

                            document.getElementById(
                                "UtilityTenantID"
                            ).value =
                                tenantId;

                            document.getElementById(
                                "UtilityUnitID"
                            ).value =
                                unitId;

                            document.getElementById(
                                "UtilityTenant"
                            ).value =
                                this.dataset.tenant;

                            document.getElementById(
                                "UtilityUnit"
                            ).value =
                                this.dataset.unit;


                            
                            // Selected billing period
                            

                            const month =
                                        @(Model.SelectedMonth ?? 0);

                            const year =
                                        @(Model.SelectedYear ?? 0);


                            if (month === 0 || year === 0) {
                                alert(
                                    "Please select a month and year first."
                                );
                                return;
                            }
                           
                            // Get previous month's reading                      

                            try {

                                const response =
                                    await fetch(
                                        `?handler=UtilityInfo&tenantId=${tenantId}&unitId=${unitId}&month=${month}&year=${year}`
                                    );


                                if (!response.ok) {
                                    throw new Error(
                                        "Unable to load utility information."
                                    );
                                }


                                const data =
                                    await response.json();

                             
                                // Fixed rates                             

                                electricRateInput.value =
                                    data.electricRate ?? 0;

                                document.getElementById(
                                    "WaterRate"
                                ).value =
                                    data.waterRate ?? 0;

                                internetBillInput.value =
                                    data.internetRate ?? 0;
                                
                                // Previous Reading

                                if (data.hasPreviousReading) {

                                    // Previous month's current reading
                                    // becomes this month's previous reading.

                                    previousElectricInput.value =
                                        data.previousElectricReading;

                                    previousWaterInput.value =
                                        data.previousWaterReading;


                                    previousElectricInput.readOnly =
                                        true;

                                    previousWaterInput.readOnly =
                                        true;


                                    if (firstReadingNotice) {
                                        firstReadingNotice
                                            .classList
                                            .add("d-none");
                                    }

                                }
                                else {

                                    // First utility record.
                                    // Admin enters initial readings manually.

                                    previousElectricInput.value = "";

                                    previousWaterInput.value = "";


                                    previousElectricInput.readOnly =
                                        false;

                                    previousWaterInput.readOnly =
                                        false;


                                    if (firstReadingNotice) {
                                        firstReadingNotice
                                            .classList
                                            .remove("d-none");
                                    }
                                }

                                // Clear current readings                             

                                currentElectricInput.value = "";

                                currentWaterInput.value = "";


                                // Reset calculated fields
                                electricConsumptionInput.value =
                                    "0.00";

                                electricityBillInput.value =
                                    "0.00";

                                waterConsumptionInput.value =
                                    "0.00";

                                waterBillInput.value =
                                    "0.00";

                                totalUtilityInput.value =
                                    Number(
                                        data.internetRate ?? 0
                                    ).toFixed(2);


                                utilityModal.show();

                            }
                            catch (error) { 

                                console.error(
                                    "Utility load error:",
                                    error
                                );

                                alert(
                                    "An error occurred while loading the utility information."
                                );
                            }
                        }
                    );
                });
            const saveUtilityButton =
                document.getElementById(
                    "saveUtilityReading"
                );

            saveUtilityButton.addEventListener(
                "click",
                async function() {

                    const tenantID =
                        parseInt(
                            document.getElementById(
                                "UtilityTenantID"
                            ).value
                        );

                    const unitID =
                        parseInt(
                            document.getElementById(
                                "UtilityUnitID"
                            ).value
                        );

                    const previousElectric =
                        parseFloat(
                            previousElectricInput.value
                        );

                    const currentElectric =
                        parseFloat(
                            currentElectricInput.value
                        );

                    const previousWater =
                        parseFloat(
                            previousWaterInput.value
                        );

                    const currentWater =
                        parseFloat(
                            currentWaterInput.value
                        );
                        
                        const electricRate =
                        parseFloat(
                            electricRateInput.value
                        );

                    const waterRate =
                        parseFloat(
                            document.getElementById(
                                "WaterRate"
                            ).value
                        );

                    const internetRate =
                        parseFloat(
                            internetBillInput.value
                        );
                    // VALIDATION

                    const errorBox =
                        document.getElementById(
                            "utilityError"
                        );

                    errorBox.classList.add(
                        "d-none"
                    );

                    if (
                        isNaN(previousElectric) ||
                        isNaN(currentElectric)
                    ) {
                        errorBox.textContent =
                            "Please enter both electricity readings.";

                        errorBox.classList.remove(
                            "d-none"
                        );

                        return;
                    }

                    if (
                        currentElectric <
                        previousElectric
                    ) {
                        errorBox.textContent =
                            "Current electricity reading cannot be lower than the previous reading.";

                        errorBox.classList.remove(
                            "d-none"
                        );

                        return;
                    }

                    if (
                        isNaN(previousWater) ||
                        isNaN(currentWater)
                    ) {
                        errorBox.textContent =
                            "Please enter both water readings.";

                        errorBox.classList.remove(
                            "d-none"
                        );

                        return;
                    }

                    if (
                        isNaN(electricRate) ||
                        electricRate <= 0
                    ) {
                        errorBox.textContent =
                            "Please enter a valid electricity rate.";

                        errorBox.classList.remove(
                            "d-none"
                        );

                        return;
                    }

                    if (
                        isNaN(waterRate) ||
                        waterRate <= 0
                    ) {
                        errorBox.textContent =
                            "Please enter a valid water rate.";

                        errorBox.classList.remove(
                            "d-none"
                        );

                        return;
                    }

                    if (
                        currentWater <
                        previousWater
                    ) {
                        errorBox.textContent =
                            "Current water reading cannot be lower than the previous reading.";

                        errorBox.classList.remove(
                            "d-none"
                        );

                        return;
                    }


                    const token =
                        document.querySelector(
                            'input[name="__RequestVerificationToken"]'
                        ).value;


                    saveUtilityButton.disabled =
                        true;

                    const originalText =
                        saveUtilityButton.innerHTML;

                    saveUtilityButton.innerHTML =
                        "Saving...";


                    try {

                        const response =
                            await fetch(
                                "?handler=SaveUtilityReading",
                                {
                                    method: "POST",

                                    headers: {
                                        "Content-Type":
                                            "application/json",

                                        "RequestVerificationToken":
                                            token
                                    },

                                   body: JSON.stringify({

                                            tenantID:
                                                tenantID,

                                            unitID:
                                                unitID,

                                            month:
                                                @(Model.SelectedMonth ?? 0),

                                            year:
                                                @(Model.SelectedYear ?? 0),

                                            previousElectricReading:
                                                previousElectric,

                                            currentElectricReading:
                                                currentElectric,

                                            electricRate:
                                                electricRate,

                                            previousWaterReading:
                                                previousWater,

                                            currentWaterReading:
                                                currentWater,

                                            waterRate:
                                               waterRate,

                                            internetRate:
                                               internetRate
                                                
                                        })
                                }
                            );


                        const result =
                            await response.json();


                        if (
                            response.ok &&
                            result.success
                        ) {

                            utilityModal.hide();

                            alert(
                                result.message
                            );

                            window.location.reload();
                        }
                        else {

                            errorBox.textContent =
                                result.message ||
                                "Unable to save utility reading.";

                            errorBox.classList.remove(
                                "d-none"
                            );
                        }

                    }
                    catch (error) {

                        console.error(
                            "Save utility error:",
                            error
                        );

                        errorBox.textContent =
                            "An unexpected error occurred while saving.";

                        errorBox.classList.remove(
                            "d-none"
                        );
                    }
                    finally {

                        saveUtilityButton.disabled =
                            false;

                        saveUtilityButton.innerHTML =
                            originalText;
                    }
                }
            );
        });
    </script>
}

             
             