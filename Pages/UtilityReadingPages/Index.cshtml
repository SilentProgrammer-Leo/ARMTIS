@page
@model ARMTIS_Capstone_Project.Pages.UtilityReadingPages.IndexModel

@{
    ViewData["Title"] = "Utility Readings";
}

<div class="container-fluid px-0">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1" style="color:#0A2D4F;">
                Utility Readings
            </h2>

            <p class="text-muted mb-0">
                Record and monitor electricity, water, and internet charges.
            </p>
        </div>

     @*    <a asp-page="./UtilityRateIndex"
           class="btn btn-outline-primary px-3 py-2">

            <i class="bi bi-gear me-1"></i>
            Manage Utility Rates

        </a> *@

    </div>


    <!-- PERIOD FILTER -->
    <div class="card border-0 shadow-sm mb-4 utility-filter-card">

        <div class="card-body p-4">

            <div class="d-flex align-items-center mb-3">

                <div class="utility-icon-circle me-3">

                    <i class="bi bi-calendar3"></i>

                </div>

                <div>
                    <h6 class="fw-bold mb-1"
                        style="color:#0A2D4F;">

                        Select Billing Period

                    </h6>

                    <small class="text-muted">
                        Choose the month and year you want to manage.
                    </small>
                </div>

            </div>


            <form method="get">

                <div class="row g-3 align-items-end">

                    <!-- MONTH -->
                    <div class="col-md-4 col-lg-3">

                        <label asp-for="SelectedMonth"
                               class="form-label fw-semibold">

                            Month

                        </label>

                        <select asp-for="SelectedMonth"
                                class="form-select">

                            <option value="">
                                -- Select Month --
                            </option>

                            @for (int month = 1; month <= 12; month++)
                            {
                                <option value="@month">
                                    @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)
                                </option>
                            }

                        </select>

                    </div>


                    <!-- YEAR -->
                    <div class="col-md-4 col-lg-3">

                        <label asp-for="SelectedYear"
                               class="form-label fw-semibold">

                            Year

                        </label>

                        <select asp-for="SelectedYear"
                                class="form-select">

                            <option value="">
                                -- Select Year --
                            </option>

                            @for (
                                int year = DateTime.Now.Year - 1;
                                year <= DateTime.Now.Year + 3;
                                year++)
                            {
                                <option value="@year">
                                    @year
                                </option>
                            }

                        </select>

                    </div>


                    <!-- LOAD BUTTON -->
                    <div class="col-md-4 col-lg-3">

                        <button type="submit"
                                class="btn text-white px-4 py-2"
                                style="background:#0A2D4F;">

                            <i class="bi bi-arrow-clockwise me-1"></i>
                            Load Readings

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- CURRENT UTILITY RATES -->
    <div class="card border-0 shadow-sm mb-4 utility-rates-card">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-start
                flex-wrap gap-3">

                <div>

                    <div class="d-flex align-items-center mb-3">

                        <div class="utility-rate-icon me-3">

                            <i class="bi bi-lightning-charge"></i>

                        </div>

                        <div>

                            <h6 class="fw-bold mb-0"
                                style="color:#0A2D4F;">

                                Current Utility Rates

                            </h6>

                            <small class="text-muted">
                                Active rates used for utility calculations.
                            </small>

                        </div>

                    </div>


                    <div class="row g-3">

                        <!-- ELECTRICITY -->
                        <div class="col-md-4">

                            <div class="rate-box">

                                <div class="rate-icon electricity-icon">
                                    <i class="bi bi-lightning-charge-fill"></i>
                                </div>

                                <div>

                                    <small class="text-muted d-block">
                                        Electricity
                                    </small>

                                    @if (Model.CurrentElectricRate != null)
                                    {
                                        <strong class="rate-value">
                                            ₱@Model.CurrentElectricRate.Rate.ToString("N2")
                                        </strong>

                                        <small class="text-muted">
                                            / kWh
                                        </small>
                                    }
                                    else
                                    {
                                        <strong class="text-danger">
                                            No active rate
                                        </strong>
                                    }

                                </div>

                            </div>

                        </div>


                        <!-- WATER -->
                        <div class="col-md-4">

                            <div class="rate-box">

                                <div class="rate-icon water-icon">
                                    <i class="bi bi-droplet-fill"></i>
                                </div>

                                <div>

                                    <small class="text-muted d-block">
                                        Water
                                    </small>

                                    @if (Model.CurrentWaterRate != null)
                                    {
                                        <strong class="rate-value">
                                            ₱@Model.CurrentWaterRate.Rate.ToString("N2")
                                        </strong>

                                        <small class="text-muted">
                                            / m³
                                        </small>
                                    }
                                    else
                                    {
                                        <strong class="text-danger">
                                            No active rate
                                        </strong>
                                    }

                                </div>

                            </div>

                        </div>


                        <!-- INTERNET -->
                        <div class="col-md-4">

                            <div class="rate-box">

                                <div class="rate-icon internet-icon">
                                    <i class="bi bi-wifi"></i>
                                </div>

                                <div>

                                    <small class="text-muted d-block">
                                        Internet
                                    </small>

                                    @if (Model.CurrentInternetRate != null)
                                    {
                                        <strong class="rate-value">
                                            ₱@Model.CurrentInternetRate.Rate.ToString("N2")
                                        </strong>

                                        <small class="text-muted">
                                            / month
                                        </small>
                                    }
                                    else
                                    {
                                        <strong class="text-danger">
                                            No active rate
                                        </strong>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <a asp-page="./UtilityRateIndex"
                   class="btn btn-outline-primary px-3 py-2">

                    <i class="bi bi-gear me-1"></i>
                    Manage Utility Rates

                </a>

            </div>

        </div>

    </div>


    <!-- UTILITY RECORDS HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>

            <h5 class="fw-bold mb-1"
                style="color:#0A2D4F;">

                <i class="bi bi-speedometer2 me-2"
                   style="color:#17B6A7;">
                </i>

                Utility Records

            </h5>

            <small class="text-muted">
                @if (Model.SelectedMonth.HasValue &&
                     Model.SelectedYear.HasValue)
                {
                    <span>
                        Showing utility records for
                        @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.SelectedMonth.Value)
                        @Model.SelectedYear
                    </span>
                }
                else
                {
                    <span>
                        Select a billing period to load utility records.
                    </span>
                }
            </small>

        </div>

        @if (Model.UtilityRows.Any())
        {
            <span class="badge rounded-pill utility-count-badge">

                <i class="bi bi-list-check me-1"></i>

                @Model.UtilityRows.Count Record(s)

            </span>
        }

    </div>


    <!-- UTILITY TABLE -->
    <div class="card border-0 shadow-sm utility-table-card">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table align-middle mb-0 utility-table">

                    <thead>

                        <tr>

                            <th>Unit</th>

                            <th>Tenant</th>

                            <th>Billing Month</th>

                            <th>Electricity</th>

                            <th>Water</th>

                            <th>Internet</th>

                            <th>Total Utilities</th>

                            <th>Status</th>

                            <th class="text-center">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (!Model.UtilityRows.Any())
                        {
                            <tr>

                                <td colspan="9"
                                    class="text-center py-5">

                                    <div class="empty-state-icon mb-3">

                                        <i class="bi bi-speedometer2"></i>

                                    </div>

                                    <h6 class="fw-bold"
                                        style="color:#0A2D4F;">

                                        No utility records loaded

                                    </h6>

                                    <p class="text-muted mb-0">

                                        Select a month and year above,
                                        then click
                                        <strong>Load Readings</strong>.

                                    </p>

                                </td>

                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model.UtilityRows)
                            {
                                <tr>

                                    <!-- UNIT -->
                                    <td>

                                        <span class="fw-semibold unit-label">

                                            <i class="bi bi-door-open me-1"></i>

                                            @item.UnitNumber

                                        </span>

                                    </td>


                                    <!-- TENANT -->
                                    <td>

                                        <span class="fw-semibold">
                                            @item.TenantName
                                        </span>

                                    </td>


                                    <!-- BILLING MONTH -->
                                    <td>

                                        <span class="billing-month-badge">

                                            <i class="bi bi-calendar3 me-1"></i>

                                            @item.BillingMonth.ToString("MMMM yyyy")

                                        </span>

                                    </td>


                                    <!-- ELECTRICITY -->
                                    <td class="text-nowrap">

                                        <span class="utility-amount electricity-text">
                                            ₱@item.ElectricityBill.ToString("N2")
                                        </span>

                                    </td>


                                    <!-- WATER -->
                                    <td class="text-nowrap">

                                        <span class="utility-amount water-text">
                                            ₱@item.WaterBill.ToString("N2")
                                        </span>

                                    </td>


                                    <!-- INTERNET -->
                                    <td class="text-nowrap">

                                        <span class="utility-amount internet-text">
                                            ₱@item.InternetBill.ToString("N2")
                                        </span>

                                    </td>


                                    <!-- TOTAL -->
                                    <td class="text-nowrap">

                                        <strong class="total-utility">

                                            ₱@item.TotalUtilityCharges.ToString("N2")

                                        </strong>

                                    </td>


                                    <!-- STATUS -->
                                    <td>

                                        @if (item.HasReading)
                                        {
                                            <span class="utility-status status-completed">

                                                <i class="bi bi-check-circle me-1"></i>
                                                Completed

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="utility-status status-not-encoded">

                                                <i class="bi bi-exclamation-circle me-1"></i>
                                                Not Encoded

                                            </span>
                                        }

                                    </td>


                                    <!-- ACTION -->
                                    <td>

                                        <div class="text-center">

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary utility-action-btn utilityBtn"
                                                    data-tenantid="@item.TenantID"
                                                    data-unitid="@item.UnitID"
                                                    data-tenant="@item.TenantName"
                                                    data-unit="@item.UnitNumber">

                                                <i class="bi bi-lightning-charge me-1"></i>
                                                Utilities

                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- UTILITY PAGE UI -->
<style>

    .utility-filter-card,
    .utility-rates-card,
    .utility-table-card {
        border-radius: 14px;
    }

    .utility-icon-circle {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eaf7f5;
        color: #17B6A7;
        font-size: 1.1rem;
    }

    .utility-rate-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eaf7f5;
        color: #17B6A7;
        font-size: 1.1rem;
    }

    .rate-box {
        height: 100%;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px 15px;
        border: 1px solid #e7ebef;
        border-radius: 10px;
        background: #fafcfc;
    }

    .rate-icon {
        width: 38px;
        height: 38px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .electricity-icon {
        background: #fff4d6;
        color: #9a6700;
    }

    .water-icon {
        background: #e7f4ff;
        color: #1473a3;
    }

    .internet-icon {
        background: #efeafd;
        color: #6750a4;
    }

    .rate-value {
        color: #0A2D4F;
        font-size: 1rem;
    }

    .utility-count-badge {
        background: #eaf7f5;
        color: #087f73;
        padding: 7px 11px;
    }

    .utility-table {
        min-width: 1100px;
    }

        .utility-table thead th {
            background: #0A2D4F;
            color: white;
            border: none;
            padding: 14px 15px;
            font-size: 0.82rem;
            font-weight: 600;
            white-space: nowrap;
        }

        .utility-table tbody td {
            padding: 14px 15px;
            border-bottom: 1px solid #edf0f3;
            font-size: 0.88rem;
        }

        .utility-table tbody tr {
            transition: background-color 0.15s ease;
        }

            .utility-table tbody tr:hover {
                background: #f7fbfa;
            }

    .unit-label {
        color: #0A2D4F;
    }

    .billing-month-badge {
        display: inline-flex;
        align-items: center;
        background: #eaf7f5;
        color: #087f73;
        padding: 6px 9px;
        border-radius: 7px;
        font-size: 0.76rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .utility-amount {
        font-weight: 600;
    }

    .electricity-text {
        color: #8a6500;
    }

    .water-text {
        color: #1473a3;
    }

    .internet-text {
        color: #6750a4;
    }

    .total-utility {
        color: #0A2D4F;
        font-size: 0.92rem;
    }

    .utility-status {
        display: inline-flex;
        align-items: center;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 0.74rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .status-completed {
        background: #e9f7ef;
        color: #198754;
    }

    .status-not-encoded {
        background: #fdecec;
        color: #dc3545;
    }

    .utility-action-btn {
        min-height: 32px;
        padding: 4px 10px;
        font-size: 0.76rem;
        border-radius: 6px;
    }

    .empty-state-icon {
        width: 52px;
        height: 52px;
        margin: 0 auto;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eaf7f5;
        color: #17B6A7;
        font-size: 1.4rem;
    }

    /* FILTER INPUT FOCUS */
    .utility-filter-card .form-select:focus {
        border-color: #17B6A7;
        box-shadow: 0 0 0 0.2rem rgba(23, 182, 167, 0.12);
    }

    /* MODAL HEADER */
    #utilityModal .modal-header {
        background: #0A2D4F;
        color: white;
    }

    #utilityModal .modal-title {
        font-weight: 600;
    }

    #utilityModal .btn-close {
        filter: brightness(0) invert(1);
    }

    @@media (max-width: 768px) {

        .utility-table {
            min-width: 1100px;
        }

        .utility-filter-card,
        .utility-rates-card,
        .utility-table-card {
            border-radius: 10px;
        }
    }

</style>

@Html.AntiForgeryToken()

<div class="modal fade"
     id="utilityModal"
     tabindex="-1"
     aria-labelledby="utilityModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-scrollable">

        <div class="modal-content utility-modal-content">

            <!-- HEADER -->
            <div class="modal-header utility-modal-header">

                <div class="d-flex align-items-center">

                    <div class="utility-modal-icon me-3">
                        <i class="bi bi-speedometer2"></i>
                    </div>

                    <div>

                        <h5 class="modal-title mb-1"
                            id="utilityModalLabel">

                            Utility Reading

                        </h5>

                        <small class="text-white-50">
                            Record electricity, water, and internet charges.
                        </small>

                    </div>

                </div>

                <button type="button"
                        class="btn-close utility-close-btn"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <!-- BODY -->
            <div class="modal-body p-4">

                <input type="hidden"
                       id="UtilityTenantID" />

                <input type="hidden"
                       id="UtilityUnitID" />


                <!-- TENANT / UNIT -->
                <div class="utility-info-card mb-4">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Tenant
                            </label>

                            <div class="input-group">

                                <span class="input-group-text utility-input-icon">
                                    <i class="bi bi-person"></i>
                                </span>

                                <input id="UtilityTenant"
                                       class="form-control"
                                       readonly />

                            </div>

                        </div>


                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Unit
                            </label>

                            <div class="input-group">

                                <span class="input-group-text utility-input-icon">
                                    <i class="bi bi-door-open"></i>
                                </span>

                                <input id="UtilityUnit"
                                       class="form-control"
                                       readonly />

                            </div>

                        </div>

                    </div>

                </div>


                <!-- FIRST READING NOTICE -->
                <div id="firstReadingNotice"
                     class="alert alert-info d-none mb-4">

                    <div class="d-flex align-items-center">

                        <i class="bi bi-info-circle-fill me-2"></i>

                        <div>
                            No previous utility reading was found.
                            Please enter the initial meter readings.
                        </div>

                    </div>

                </div>


                <!-- ELECTRICITY -->
                <div class="utility-section mb-4">

                    <div class="utility-section-header">

                        <div class="d-flex align-items-center">

                            <div class="utility-service-icon electricity-modal-icon me-3">
                                <i class="bi bi-lightning-charge-fill"></i>
                            </div>

                            <div>

                                <h6 class="fw-bold mb-1">
                                    Electricity
                                </h6>

                                <small class="text-muted">
                                    Electricity meter reading and charge.
                                </small>

                            </div>

                        </div>

                    </div>


                    <div class="row g-3 mt-1">

                        <!-- PREVIOUS -->
                        <div class="col-md-6 col-lg-3">

                            <label class="form-label fw-semibold">
                                Previous Reading
                            </label>

                            <div class="input-group">

                                <input id="PreviousElectricReading"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       class="form-control"
                                       readonly />

                                <span class="input-group-text">
                                    kWh
                                </span>

                            </div>

                        </div>


                        <!-- CURRENT -->
                        <div class="col-md-6 col-lg-3">

                            <label class="form-label fw-semibold">
                                Current Reading
                            </label>

                            <div class="input-group">

                                <input id="CurrentElectricReading"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       class="form-control" />

                                <span class="input-group-text">
                                    kWh
                                </span>

                            </div>

                        </div>


                        <!-- CONSUMPTION -->
                        <div class="col-md-6 col-lg-3">

                            <label class="form-label fw-semibold">
                                Consumption
                            </label>

                            <div class="input-group">

                                <input id="ElectricConsumption"
                                       type="number"
                                       class="form-control bg-light"
                                       readonly />

                                <span class="input-group-text">
                                    kWh
                                </span>

                            </div>

                        </div>


                        <!-- RATE -->
                        <div class="col-md-6 col-lg-3">

                            <label class="form-label fw-semibold">
                                Rate
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    ₱
                                </span>

                                <input id="ElectricRate"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       class="form-control bg-light"
                                       readonly />

                                <span class="input-group-text">
                                    / kWh
                                </span>

                            </div>

                        </div>


                        <!-- ELECTRICITY BILL -->
                        <div class="col-12">

                            <div class="utility-total-box electricity-total">

                                <div>
                                    <small class="text-muted d-block">
                                        Electricity Bill
                                    </small>

                                    <strong>
                                        ₱<span id="ElectricityBill">
                                        0.00
                                    </span>
                                </strong>
                            </div>

                            <i class="bi bi-lightning-charge-fill"></i>

                        </div>

                    </div>

                </div>

            </div>


            <!-- WATER -->
            <div class="utility-section mb-4">

                <div class="utility-section-header">

                    <div class="d-flex align-items-center">

                        <div class="utility-service-icon water-modal-icon me-3">
                            <i class="bi bi-droplet-fill"></i>
                        </div>

                        <div>

                            <h6 class="fw-bold mb-1">
                                Water
                            </h6>

                            <small class="text-muted">
                                Water meter reading and charge.
                            </small>

                        </div>

                    </div>

                </div>


                <div class="row g-3 mt-1">

                    <!-- PREVIOUS -->
                    <div class="col-md-6 col-lg-3">

                        <label class="form-label fw-semibold">
                            Previous Reading
                        </label>

                        <div class="input-group">

                            <input id="PreviousWaterReading"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control"
                                   readonly />

                            <span class="input-group-text">
                                m³
                            </span>

                        </div>

                    </div>


                    <!-- CURRENT -->
                    <div class="col-md-6 col-lg-3">

                        <label class="form-label fw-semibold">
                            Current Reading
                        </label>

                        <div class="input-group">

                            <input id="CurrentWaterReading"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control" />

                            <span class="input-group-text">
                                m³
                            </span>

                        </div>

                    </div>


                    <!-- CONSUMPTION -->
                    <div class="col-md-6 col-lg-3">

                        <label class="form-label fw-semibold">
                            Consumption
                        </label>

                        <div class="input-group">

                            <input id="WaterConsumption"
                                   type="number"
                                   class="form-control bg-light"
                                   readonly />

                            <span class="input-group-text">
                                m³
                            </span>

                        </div>

                    </div>


                    <!-- RATE -->
                    <div class="col-md-6 col-lg-3">

                        <label class="form-label fw-semibold">
                            Rate
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                ₱
                            </span>

                            <input id="WaterRate"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control bg-light"
                                   readonly />

                            <span class="input-group-text">
                                / m³
                            </span>

                        </div>

                    </div>


                    <!-- WATER BILL -->
                    <div class="col-12">

                        <div class="utility-total-box water-total">

                            <div>
                                <small class="text-muted d-block">
                                    Water Bill
                                </small>

                                <strong>
                                    ₱<span id="WaterBill">
                                    0.00
                                </span>
                            </strong>
                        </div>

                        <i class="bi bi-droplet-fill"></i>

                    </div>

                </div>

            </div>

        </div>


        <!-- OTHER CHARGES -->
        <div class="utility-section">

            <div class="utility-section-header">

                <div class="d-flex align-items-center">

                    <div class="utility-service-icon internet-modal-icon me-3">
                        <i class="bi bi-wifi"></i>
                    </div>

                    <div>

                        <h6 class="fw-bold mb-1">
                            Other Charges
                        </h6>

                        <small class="text-muted">
                            Internet and total utility charges.
                        </small>

                    </div>

                </div>

            </div>


            <div class="row g-3 mt-1">

                <!-- INTERNET -->
                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        Internet
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            ₱
                        </span>

                        <input id="InternetBill"
                               type="number"
                               class="form-control bg-light"
                               value="300.00"
                               readonly />

                        <span class="input-group-text">
                            / month
                        </span>

                    </div>

                </div>


                <!-- TOTAL -->
                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        Total Utility Charges
                    </label>

                    <div class="total-charge-box">

                        <span class="total-currency">
                            ₱
                        </span>

                        <span id="TotalUtilityCharges">
                            0.00
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- ERROR -->
        <div id="utilityError"
             class="alert alert-danger d-none mt-4">
        </div>

    </div>


    <!-- FOOTER -->
    <div class="modal-footer utility-modal-footer">

        <button type="button"
                class="btn btn-light border px-4"
                data-bs-dismiss="modal">

            <i class="bi bi-x-circle me-1"></i>
            Cancel

        </button>

        <button type="button"
                id="saveUtilityReading"
                class="btn text-white px-4"
                style="background:#0A2D4F;">

            <i class="bi bi-check-circle me-1"></i>
            Save Utility Reading

        </button>

    </div>

</div>

</div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {

            
            // MODAL
            

            const modalElement =
                document.getElementById("utilityModal");

            if (!modalElement) {
                console.error("Utility modal was not found.");
                return;
            }

            const utilityModal =
                bootstrap.Modal.getOrCreateInstance(modalElement);


            
            // INPUT ELEMENTS
          

            const previousElectricInput =
                document.getElementById(
                    "PreviousElectricReading"
                );

            const currentElectricInput =
                document.getElementById(
                    "CurrentElectricReading"
                );

            const electricConsumptionInput =
                document.getElementById(
                    "ElectricConsumption"
                );

            const electricRateInput =
                document.getElementById(
                    "ElectricRate"
                );

            const electricityBillInput =
                document.getElementById(
                    "ElectricityBill"
                );


            const previousWaterInput =
                document.getElementById(
                    "PreviousWaterReading"
                );

            const currentWaterInput =
                document.getElementById(
                    "CurrentWaterReading"
                );

            const waterConsumptionInput =
                document.getElementById(
                    "WaterConsumption"
                );

            const waterBillInput =
                document.getElementById(
                    "WaterBill"
                );


            const internetBillInput =
                document.getElementById(
                    "InternetBill"
                );

            const totalUtilityInput =
                document.getElementById(
                    "TotalUtilityCharges"
                );

            const firstReadingNotice =
                document.getElementById(
                    "firstReadingNotice"
                );


           
            // CALCULATE UTILITIES
            

            function calculateUtilities() {

           
                // ELECTRICITY
              

                const previousElectric =
                    parseFloat(
                        previousElectricInput.value
                    ) || 0;

                const currentElectric =
                    parseFloat(
                        currentElectricInput.value
                    ) || 0;

                const electricRate =
                    parseFloat(
                        electricRateInput.value
                    ) || 0;

                let electricConsumption = 0;

                // Only calculate if a current reading was entered.
                if (currentElectricInput.value !== "") {

                    electricConsumption =
                        currentElectric -
                        previousElectric;

                    if (electricConsumption < 0) {
                        electricConsumption = 0;
                    }
                }


                const electricityBill =
                    electricConsumption *
                    electricRate;


                electricConsumptionInput.value =
                    electricConsumption.toFixed(2);

                electricityBillInput.value =
                    electricityBill.toFixed(2);


    
                // WATER
              
                const previousWater =
                    parseFloat(
                        previousWaterInput.value
                    ) || 0;

                const currentWater =
                    parseFloat(
                        currentWaterInput.value
                    ) || 0;

                const waterRate =
                    parseFloat(
                        document.getElementById(
                            "WaterRate"
                        ).value
                    ) || 0;


                let waterConsumption = 0;

                if (currentWaterInput.value !== "") {

                    waterConsumption =
                        currentWater -
                        previousWater;

                    if (waterConsumption < 0) {
                        waterConsumption = 0;
                    }
                }


                const waterBill =
                    waterConsumption *
                    waterRate;


                waterConsumptionInput.value =
                    waterConsumption.toFixed(2);

                waterBillInput.value =
                    waterBill.toFixed(2);
                
                // INTERNET
                

                const internetBill =
                    parseFloat(
                        internetBillInput.value
                    ) || 0;

                internetBillInput.value =
                    internetBill.toFixed(2);


                
                // TOTAL
               

                const totalUtility =
                    electricityBill +
                    waterBill +
                    internetBill;


                totalUtilityInput.value =
                    totalUtility.toFixed(2);
            }


            
            // CALCULATE WHEN USER TYPES
           

            previousElectricInput.addEventListener(
                "input",
                calculateUtilities
            );

            currentElectricInput.addEventListener(
                "input",
                calculateUtilities
            );
            electricRateInput.addEventListener(
                "input",
                calculateUtilities
            );

            previousWaterInput.addEventListener(
                "input",
                calculateUtilities
            );

            currentWaterInput.addEventListener(
                "input",
                calculateUtilities
            );

            document.getElementById("WaterRate")
            .addEventListener(
                "input",
                calculateUtilities
            );
            
            // OPEN UTILITY MODAL
            

            document.querySelectorAll(".utilityBtn")
                .forEach(function(button) {

                    button.addEventListener(
                        "click",
                        async function() {

                            const tenantId =
                                this.dataset.tenantid;

                            const unitId =
                                this.dataset.unitid;


                        
                            // Tenant and Unit
                        

                            document.getElementById(
                                "UtilityTenantID"
                            ).value =
                                tenantId;

                            document.getElementById(
                                "UtilityUnitID"
                            ).value =
                                unitId;

                            document.getElementById(
                                "UtilityTenant"
                            ).value =
                                this.dataset.tenant;

                            document.getElementById(
                                "UtilityUnit"
                            ).value =
                                this.dataset.unit;


                            
                            // Selected billing period
                            

                            const month =
                                        @(Model.SelectedMonth ?? 0);

                            const year =
                                        @(Model.SelectedYear ?? 0);


                            if (month === 0 || year === 0) {
                                alert(
                                    "Please select a month and year first."
                                );
                                return;
                            }
                           
                            // Get previous month's reading                      

                            try {

                                const response =
                                    await fetch(
                                        `?handler=UtilityInfo&tenantId=${tenantId}&unitId=${unitId}&month=${month}&year=${year}`
                                    );


                                if (!response.ok) {
                                    throw new Error(
                                        "Unable to load utility information."
                                    );
                                }


                                const data =
                                    await response.json();

                             
                                // Fixed rates                             

                                electricRateInput.value =
                                    data.electricRate ?? 0;

                                document.getElementById(
                                    "WaterRate"
                                ).value =
                                    data.waterRate ?? 0;

                                internetBillInput.value =
                                    data.internetRate ?? 0;
                                
                                // Previous Reading

                                if (data.hasPreviousReading) {

                                    // Previous month's current reading
                                    // becomes this month's previous reading.

                                    previousElectricInput.value =
                                        data.previousElectricReading;

                                    previousWaterInput.value =
                                        data.previousWaterReading;


                                    previousElectricInput.readOnly =
                                        true;

                                    previousWaterInput.readOnly =
                                        true;


                                    if (firstReadingNotice) {
                                        firstReadingNotice
                                            .classList
                                            .add("d-none");
                                    }

                                }
                                else {

                                    // First utility record.
                                    // Admin enters initial readings manually.

                                    previousElectricInput.value = "";

                                    previousWaterInput.value = "";


                                    previousElectricInput.readOnly =
                                        false;

                                    previousWaterInput.readOnly =
                                        false;


                                    if (firstReadingNotice) {
                                        firstReadingNotice
                                            .classList
                                            .remove("d-none");
                                    }
                                }

                                // Clear current readings                             

                                currentElectricInput.value = "";

                                currentWaterInput.value = "";


                                // Reset calculated fields
                                electricConsumptionInput.value =
                                    "0.00";

                                electricityBillInput.value =
                                    "0.00";

                                waterConsumptionInput.value =
                                    "0.00";

                                waterBillInput.value =
                                    "0.00";

                                totalUtilityInput.value =
                                    Number(
                                        data.internetRate ?? 0
                                    ).toFixed(2);


                                utilityModal.show();

                            }
                            catch (error) { 

                                console.error(
                                    "Utility load error:",
                                    error
                                );

                                alert(
                                    "An error occurred while loading the utility information."
                                );
                            }
                        }
                    );
                });
            const saveUtilityButton =
                document.getElementById(
                    "saveUtilityReading"
                );

            saveUtilityButton.addEventListener(
                "click",
                async function() {

                    const tenantID =
                        parseInt(
                            document.getElementById(
                                "UtilityTenantID"
                            ).value
                        );

                    const unitID =
                        parseInt(
                            document.getElementById(
                                "UtilityUnitID"
                            ).value
                        );

                    const previousElectric =
                        parseFloat(
                            previousElectricInput.value
                        );

                    const currentElectric =
                        parseFloat(
                            currentElectricInput.value
                        );

                    const previousWater =
                        parseFloat(
                            previousWaterInput.value
                        );

                    const currentWater =
                        parseFloat(
                            currentWaterInput.value
                        );
                        
                        const electricRate =
                        parseFloat(
                            electricRateInput.value
                        );

                    const waterRate =
                        parseFloat(
                            document.getElementById(
                                "WaterRate"
                            ).value
                        );

                    const internetRate =
                        parseFloat(
                            internetBillInput.value
                        );
                    // VALIDATION

                    const errorBox =
                        document.getElementById(
                            "utilityError"
                        );

                    errorBox.classList.add(
                        "d-none"
                    );

                    if (
                        isNaN(previousElectric) ||
                        isNaN(currentElectric)
                    ) {
                        errorBox.textContent =
                            "Please enter both electricity readings.";

                        errorBox.classList.remove(
                            "d-none"
                        );

                        return;
                    }

                    if (
                        currentElectric <
                        previousElectric
                    ) {
                        errorBox.textContent =
                            "Current electricity reading cannot be lower than the previous reading.";

                        errorBox.classList.remove(
                            "d-none"
                        );

                        return;
                    }

                    if (
                        isNaN(previousWater) ||
                        isNaN(currentWater)
                    ) {
                        errorBox.textContent =
                            "Please enter both water readings.";

                        errorBox.classList.remove(
                            "d-none"
                        );

                        return;
                    }

                    if (
                        isNaN(electricRate) ||
                        electricRate <= 0
                    ) {
                        errorBox.textContent =
                            "Please enter a valid electricity rate.";

                        errorBox.classList.remove(
                            "d-none"
                        );

                        return;
                    }

                    if (
                        isNaN(waterRate) ||
                        waterRate <= 0
                    ) {
                        errorBox.textContent =
                            "Please enter a valid water rate.";

                        errorBox.classList.remove(
                            "d-none"
                        );

                        return;
                    }

                    if (
                        currentWater <
                        previousWater
                    ) {
                        errorBox.textContent =
                            "Current water reading cannot be lower than the previous reading.";

                        errorBox.classList.remove(
                            "d-none"
                        );

                        return;
                    }


                    const token =
                        document.querySelector(
                            'input[name="__RequestVerificationToken"]'
                        ).value;


                    saveUtilityButton.disabled =
                        true;

                    const originalText =
                        saveUtilityButton.innerHTML;

                    saveUtilityButton.innerHTML =
                        "Saving...";


                    try {

                        const response =
                            await fetch(
                                "?handler=SaveUtilityReading",
                                {
                                    method: "POST",

                                    headers: {
                                        "Content-Type":
                                            "application/json",

                                        "RequestVerificationToken":
                                            token
                                    },

                                   body: JSON.stringify({

                                            tenantID:
                                                tenantID,

                                            unitID:
                                                unitID,

                                            month:
                                                @(Model.SelectedMonth ?? 0),

                                            year:
                                                @(Model.SelectedYear ?? 0),

                                            previousElectricReading:
                                                previousElectric,

                                            currentElectricReading:
                                                currentElectric,

                                            electricRate:
                                                electricRate,

                                            previousWaterReading:
                                                previousWater,

                                            currentWaterReading:
                                                currentWater,

                                            waterRate:
                                               waterRate,

                                            internetRate:
                                               internetRate
                                                
                                        })
                                }
                            );


                        const result =
                            await response.json();


                        if (
                            response.ok &&
                            result.success
                        ) {

                            utilityModal.hide();

                            alert(
                                result.message
                            );

                            window.location.reload();
                        }
                        else {

                            errorBox.textContent =
                                result.message ||
                                "Unable to save utility reading.";

                            errorBox.classList.remove(
                                "d-none"
                            );
                        }

                    }
                    catch (error) {

                        console.error(
                            "Save utility error:",
                            error
                        );

                        errorBox.textContent =
                            "An unexpected error occurred while saving.";

                        errorBox.classList.remove(
                            "d-none"
                        );
                    }
                    finally {

                        saveUtilityButton.disabled =
                            false;

                        saveUtilityButton.innerHTML =
                            originalText;
                    }
                }
            );
        });
    </script>
}

             
             