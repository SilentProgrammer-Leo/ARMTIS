@page
@model ARMTIS_Capstone_Project.Pages.UtilityReadingPages.UtilityRateCreateIndexModel
@{
    ViewData["Title"] = "Add Utility Rate";
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-header">
            <h4 class="mb-0">
                Add New Utility Rate
            </h4>
        </div>

        <div class="card-body">

            <form method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">

                    <label asp-for="UtilityRate.UtilityType"
                           class="form-label">
                        Utility Type
                    </label>

                    <select asp-for="UtilityRate.UtilityType"
                            class="form-select">

                        <option value="">
                            -- Select Utility --
                        </option>

                        <option value="Electricity">
                            Electricity
                        </option>

                        <option value="Water">
                            Water
                        </option>

                        <option value="Internet">
                            Internet
                        </option>

                    </select>

                    <span asp-validation-for="UtilityRate.UtilityType"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-3">

                    <label asp-for="UtilityRate.Rate"
                           class="form-label">
                        Rate
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            ₱
                        </span>

                        <input asp-for="UtilityRate.Rate"
                               type="number"
                               step="0.01"
                               min="0.01"
                               class="form-control" />

                    </div>

                    <span asp-validation-for="UtilityRate.Rate"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-3">

                    <label asp-for="UtilityRate.EffectiveFrom"
                           class="form-label">
                        Effective From
                    </label>

                    <input asp-for="UtilityRate.EffectiveFrom"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="UtilityRate.EffectiveFrom"
                          class="text-danger">
                    </span>

                </div>


                <button type="submit"
                        class="btn btn-success">

                    <i class="bi bi-check-circle"></i>
                    Save Rate

                </button>

                <a asp-page="./UtilityRateIndex"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}