@page
@model ARMTIS_Capstone_Project.Pages.TenantPages.RentalProfileModel

@{
    ViewData["Title"] = "Rental Profile";

    var fullName = $"{Model.Tenant.FirstName} {Model.Tenant.LastName}";

    var initials = "";

    if (!string.IsNullOrWhiteSpace(Model.Tenant.FirstName))
    {
        initials += Model.Tenant.FirstName.Substring(0, 1).ToUpper();
    }

    if (!string.IsNullOrWhiteSpace(Model.Tenant.LastName))
    {
        initials += Model.Tenant.LastName.Substring(0, 1).ToUpper();
    }
}

<div class="rental-profile-page">

    <!-- =========================================================
         PAGE HEADER
         ========================================================= -->

    <div class="profile-page-header">

        <div>
            <h2 class="profile-title">
                <i class="bi bi-person-vcard me-2"></i>
                Rental Profile
            </h2>

            <p class="profile-subtitle">
                Tenant personal, rental, and assigned unit information
            </p>
        </div>

        <div class="profile-header-actions">

            <a asp-page="./Edit"
               asp-route-id="@Model.Tenant.TenantID"
               class="btn profile-edit-btn">

                <i class="bi bi-pencil-square me-1"></i>
                Edit Profile

            </a>

            <a asp-page="./Index"
               class="btn profile-back-btn">

                <i class="bi bi-arrow-left me-1"></i>
                Back

            </a>

        </div>

    </div>


    <!-- =========================================================
         PROFILE HERO
         ========================================================= -->

    <div class="profile-main-card">

        <!-- PROFILE PHOTO -->

        <div class="profile-avatar-wrapper">

            <div class="profile-avatar">

                @if (!string.IsNullOrWhiteSpace(Model.Tenant.ProfileImagePath))
                {
                    <img src="@Model.Tenant.ProfileImagePath"
                         alt="@fullName"
                         class="profile-avatar-image" />
                }
                else
                {
                    <span class="profile-initials">
                        @initials
                    </span>
                }

            </div>

        </div>


        <!-- PROFILE INFORMATION -->

        <div class="profile-main-info">

            <div class="profile-eyebrow">
                TENANT PROFILE
            </div>

            <div class="profile-name-row">

                <h3>
                    @fullName
                </h3>

                @if (Model.Tenant.Status?.Equals(
                    "Active",
                    StringComparison.OrdinalIgnoreCase) == true)
                {
                    <span class="profile-status active">
                        <i class="bi bi-check-circle-fill me-1"></i>
                        Active
                    </span>
                }
                else
                {
                    <span class="profile-status inactive">
                        @Model.Tenant.Status
                    </span>
                }

            </div>


            <p class="profile-role">

                Tenant ID:
                <strong>
                    @Model.Tenant.TenantID
                </strong>

                <span class="profile-separator">•</span>

                Unit
                <strong>
                    @(Model.Tenant.Unit?.UnitNumber ?? "N/A")
                </strong>

            </p>


            <!-- CONTACT INFORMATION -->

            <div class="profile-contact-row">

                <div class="profile-contact-item">

                    <i class="bi bi-telephone-fill"></i>

                    <span>
                        @(string.IsNullOrWhiteSpace(Model.Tenant.ContactNo)
                            ? "No contact number"
                            : Model.Tenant.ContactNo)
                    </span>

                </div>


                <div class="profile-contact-item">

                    <i class="bi bi-envelope-fill"></i>

                    <span>
                        @(string.IsNullOrWhiteSpace(Model.Tenant.Email)
                            ? "No email address"
                            : Model.Tenant.Email)
                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         PERSONAL INFORMATION
         ========================================================= -->

    <div class="profile-card">

        <div class="profile-card-header">

            <div>
                <h5>
                    <i class="bi bi-person me-2"></i>
                    Personal Information
                </h5>

                <small>
                    Basic tenant information
                </small>
            </div>

        </div>


        <div class="profile-card-body">

            <div class="info-grid">

                <!-- FIRST NAME -->

                <div class="info-item">

                    <span class="info-label">
                        First Name
                    </span>

                    <span class="info-value">
                        @Model.Tenant.FirstName
                    </span>

                </div>


                <!-- LAST NAME -->

                <div class="info-item">

                    <span class="info-label">
                        Last Name
                    </span>

                    <span class="info-value">
                        @Model.Tenant.LastName
                    </span>

                </div>


                <!-- CONTACT -->

                <div class="info-item">

                    <span class="info-label">
                        Contact Number
                    </span>

                    <span class="info-value">

                        @(string.IsNullOrWhiteSpace(Model.Tenant.ContactNo)
                            ? "N/A"
                            : Model.Tenant.ContactNo)

                    </span>

                </div>


                <!-- EMAIL -->

                <div class="info-item">

                    <span class="info-label">
                        Email Address
                    </span>

                    <span class="info-value">

                        @(string.IsNullOrWhiteSpace(Model.Tenant.Email)
                            ? "N/A"
                            : Model.Tenant.Email)

                    </span>

                </div>


                <!-- ADDRESS -->

                <div class="info-item info-full">

                    <span class="info-label">
                        Current Address
                    </span>

                    <span class="info-value">

                        @(string.IsNullOrWhiteSpace(Model.Tenant.Address)
                            ? "N/A"
                            : Model.Tenant.Address)

                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         RENTAL INFORMATION
         ========================================================= -->

    <div class="profile-card">

        <div class="profile-card-header">

            <div>
                <h5>
                    <i class="bi bi-house-door me-2"></i>
                    Rental Information
                </h5>

                <small>
                    Lease and rental details
                </small>
            </div>

            <span class="readonly-badge">
                <i class="bi bi-lock-fill me-1"></i>
                Admin Record
            </span>

        </div>


        <div class="profile-card-body">

            <div class="rental-summary-grid">

                <!-- UNIT -->

                <div class="rental-summary-item">

                    <div class="rental-icon">

                        <i class="bi bi-house"></i>

                    </div>

                    <div>

                        <span class="info-label">
                            Unit
                        </span>

                        <strong>
                            @(Model.Tenant.Unit?.UnitNumber ?? "N/A")
                        </strong>

                    </div>

                </div>


                <!-- MONTHLY RENT -->

                <div class="rental-summary-item">

                    <div class="rental-icon">

                        <i class="bi bi-cash-stack"></i>

                    </div>

                    <div>

                        <span class="info-label">
                            Monthly Rent
                        </span>

                        <strong class="rent-value">

                            @if (Model.Tenant.Unit != null)
                            {
                                @($"₱{Model.Tenant.Unit.MonthlyRent:N2}")
                            }
                            else
                            {
                                @("N/A")
                            }

                        </strong>

                    </div>

                </div>


                <!-- LEASE START -->

                <div class="rental-summary-item">

                    <div class="rental-icon">

                        <i class="bi bi-calendar-check"></i>

                    </div>

                    <div>

                        <span class="info-label">
                            Lease Start
                        </span>

                        <strong>

                            @Model.Tenant.LeaseStartDate.ToString(
                                "MMM dd, yyyy")

                        </strong>

                    </div>

                </div>


                <!-- LEASE END -->

                <div class="rental-summary-item">

                    <div class="rental-icon">

                        <i class="bi bi-calendar-x"></i>

                    </div>

                    <div>

                        <span class="info-label">
                            Lease End
                        </span>

                        <strong>

                            @Model.Tenant.LeaseEndDate.ToString(
                                "MMM dd, yyyy")

                        </strong>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         ASSIGNED UNIT
         ========================================================= -->
    @if (Model.Tenant.Unit != null)
    {
        <div class="profile-card">

            <div class="profile-card-header">

                <div>

                    <h5>
                        <i class="bi bi-building me-2"></i>
                        Assigned Unit
                    </h5>

                    <small>
                        Information about the tenant's assigned unit
                    </small>

                </div>

            </div>


            <div class="profile-card-body">

                <div class="unit-details-grid">

                    <!-- UNIT NUMBER -->

                    <div class="info-item">

                        <span class="info-label">
                            Unit Number
                        </span>

                        <span class="unit-number">
                            @Model.Tenant.Unit.UnitNumber
                        </span>

                    </div>


                    <!-- UNIT STATUS -->

                    <div class="info-item">

                        <span class="info-label">
                            Unit Status
                        </span>

                        @if (Model.Tenant.Unit.UnitStatus?.Equals(
                            "Occupied",
                            StringComparison.OrdinalIgnoreCase) == true)
                        {
                            <span class="unit-status occupied">
                                <i class="bi bi-check-circle-fill me-1"></i>
                                Occupied
                            </span>
                        }
                        else
                        {
                            <span class="unit-status other">
                                @Model.Tenant.Unit.UnitStatus
                            </span>
                        }

                    </div>


                    <!-- CAPACITY -->

                    <div class="info-item">

                        <span class="info-label">
                            Capacity
                        </span>

                        <span class="info-value">
                            @Model.Tenant.Unit.Capacity person(s)
                        </span>

                    </div>


                    <!-- DESCRIPTION -->

                    <div class="info-item info-full">

                        <span class="info-label">
                            Unit Description
                        </span>

                        <span class="info-value">

                            @(string.IsNullOrWhiteSpace(
                                Model.Tenant.Unit.Description)

                                ? "No description available."

                                : Model.Tenant.Unit.Description)

                        </span>

                    </div>

                </div>

            </div>

        </div>
    }

    <!-- =========================================================
     RENTAL AGREEMENT
     ========================================================= -->

    <div class="profile-card">

        <div class="profile-card-header">

            <div>
                <h5>
                    <i class="bi bi-file-earmark-text me-2"></i>
                    Rental Agreement
                </h5>

                <small>
                    Upload and view the tenant's rental agreement
                </small>
            </div>

            <!-- UPLOAD / REPLACE -->
            <form method="post"
                  enctype="multipart/form-data"
                  asp-page-handler="UploadAgreement"
                  asp-route-id="@Model.Tenant.TenantID">

                <label class="rental-agreement-upload-btn">

                    <i class="bi bi-upload me-1"></i>
                    Upload Agreement Pages

                    <input type="file"
                           asp-for="RentalAgreementImages"
                           accept=".jpg,.jpeg,.png"
                           multiple
                           onchange="this.form.submit();"
                           hidden />

                </label>

            </form>

        </div>


        <div class="profile-card-body">

            @if (Model.Tenant.RentalAgreementImages.Any())
            {
                <div class="rental-agreement-gallery">

                    @foreach (var image in Model.Tenant.RentalAgreementImages
                        .OrderBy(x => x.UploadDate))
                    {
                        <div class="rental-agreement-item">

                            <img src="@image.ImagePath"
                                 alt="Rental Agreement"
                                 class="rental-agreement-image" />

                            <div class="rental-agreement-page-label">
                                @image.FileName
                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="rental-agreement-empty">

                    <div class="rental-agreement-empty-icon">
                        <i class="bi bi-file-earmark-x"></i>
                    </div>

                    <h6>No Rental Agreement Uploaded</h6>

                    <p>
                        Upload one or more agreement pages.
                    </p>

                </div>
            }

        </div>

    </div>

    <!-- =========================================================
         PROFILE INFORMATION NOTE
         ========================================================= -->

    <div class="profile-note">

        <div class="profile-note-icon">

            <i class="bi bi-info-circle-fill"></i>

        </div>

        <div>

            <strong>
                Rental Profile
            </strong>

            <p>
                This profile reflects the tenant's current personal,
                rental, lease, and assigned unit information recorded
                in the ARMTIS system.
            </p>

        </div>

    </div>

</div>


<style>

    :root {
        --armtis-primary: #0A2D4F;
        --armtis-primary-light: #123F68;
        --armtis-accent: #17B6A7;
        --armtis-accent-light: #E7F7F5;
        --armtis-bg: #F5F7FA;
        --armtis-card: #FFFFFF;
        --armtis-border: #E1E8EE;
        --armtis-text: #1F2937;
        --armtis-muted: #6B7280;
    }


    /* =========================================================
           PAGE
           ========================================================= */

    .rental-profile-page {
        background: var(--armtis-bg);
        min-height: calc(100vh - 80px);
        padding: 10px 4px 35px;
    }


    /* =========================================================
           PAGE HEADER
           ========================================================= */

    .profile-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 24px;
    }


    .profile-title {
        color: var(--armtis-primary);
        font-weight: 700;
        margin-bottom: 4px;
    }


        .profile-title i {
            color: var(--armtis-accent);
        }


    .profile-subtitle {
        color: var(--armtis-muted);
        margin: 0;
        font-size: .9rem;
    }


    .profile-header-actions {
        display: flex;
        gap: 8px;
    }


    /* =========================================================
           BUTTONS
           ========================================================= */

    .profile-edit-btn {
        background: var(--armtis-primary);
        border: 1px solid var(--armtis-primary);
        color: white;
        border-radius: 8px;
        padding: 8px 14px;
        font-size: .82rem;
        font-weight: 600;
    }


        .profile-edit-btn:hover {
            background: var(--armtis-primary-light);
            border-color: var(--armtis-primary-light);
            color: white;
        }


    .profile-back-btn {
        background: white;
        border: 1px solid #CBD5DE;
        color: var(--armtis-primary);
        border-radius: 8px;
        padding: 8px 14px;
        font-size: .82rem;
        font-weight: 600;
    }


        .profile-back-btn:hover {
            background: #F3F7FA;
            color: var(--armtis-primary);
        }


    /* =========================================================
           MAIN PROFILE HERO
           ========================================================= */

    .profile-main-card {
        background: var(--armtis-primary);
        color: white;
        border-radius: 16px;
        padding: 28px 30px;
        display: flex;
        align-items: center;
        gap: 22px;
        margin-bottom: 18px;
        border-left: 4px solid var(--armtis-accent);
        box-shadow: 0 6px 18px rgba(10,45,79,.12);
    }


    /* =========================================================
           PROFILE PHOTO
           ========================================================= */

    .profile-avatar-wrapper {
        flex-shrink: 0;
    }


    .profile-avatar {
        width: 110px;
        height: 110px;
        border-radius: 50%;
        background: var(--armtis-accent);
        border: 4px solid rgba(255,255,255,.88);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,.12);
    }


    .profile-avatar-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }


    .profile-initials {
        color: white;
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: 1px;
    }


    /* =========================================================
           PROFILE INFORMATION
           ========================================================= */

    .profile-main-info {
        min-width: 0;
        flex: 1;
    }


    .profile-eyebrow {
        color: var(--armtis-accent);
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: 1.3px;
        margin-bottom: 5px;
    }


    .profile-name-row {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }


        .profile-name-row h3 {
            margin: 0;
            color: white;
            font-size: 1.7rem;
            font-weight: 700;
        }


    .profile-role {
        margin: 6px 0 13px;
        color: rgba(255,255,255,.75);
        font-size: .86rem;
    }


        .profile-role strong {
            color: white;
            font-weight: 600;
        }


    .profile-separator {
        margin: 0 6px;
    }


    /* =========================================================
           STATUS
           ========================================================= */

    .profile-status {
        display: inline-flex;
        align-items: center;
        padding: 5px 11px;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 600;
    }


        .profile-status.active {
            background: rgba(23,182,167,.18);
            color: #BFF7F1;
            border: 1px solid rgba(23,182,167,.20);
        }


        .profile-status.inactive {
            background: rgba(255,255,255,.10);
            color: white;
            border: 1px solid rgba(255,255,255,.12);
        }


    /* =========================================================
           CONTACT
           ========================================================= */

    .profile-contact-row {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
    }


    .profile-contact-item {
        display: flex;
        align-items: center;
        gap: 7px;
        color: rgba(255,255,255,.84);
        font-size: .82rem;
    }


        .profile-contact-item i {
            color: var(--armtis-accent);
        }


    /* =========================================================
           STANDARD CARD
           ========================================================= */

    .profile-card {
        background: var(--armtis-card);
        border: 1px solid var(--armtis-border);
        border-radius: 14px;
        overflow: hidden;
        margin-bottom: 18px;
        box-shadow: 0 3px 10px rgba(10,45,79,.045);
    }


    .profile-card-header {
        padding: 16px 20px;
        background: #F7F9FB;
        border-bottom: 1px solid var(--armtis-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }


        .profile-card-header h5 {
            color: var(--armtis-primary);
            font-weight: 700;
            margin: 0 0 3px;
        }


            .profile-card-header h5 i {
                color: var(--armtis-accent);
            }


        .profile-card-header small {
            color: var(--armtis-muted);
            font-size: .76rem;
        }


    .profile-card-body {
        padding: 21px;
    }


    /* =========================================================
           READ ONLY BADGE
           ========================================================= */

    .readonly-badge {
        display: inline-flex;
        align-items: center;
        background: #EAF1F7;
        color: var(--armtis-primary);
        border: 1px solid #D3E0EA;
        border-radius: 20px;
        padding: 5px 9px;
        font-size: .68rem;
        font-weight: 600;
        white-space: nowrap;
    }


    /* =========================================================
           INFORMATION GRID
           ========================================================= */

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px 28px;
    }


    .info-item {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }


    .info-full {
        grid-column: 1 / -1;
    }


    .info-label {
        color: var(--armtis-muted);
        font-size: .74rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .3px;
    }


    .info-value {
        color: var(--armtis-text);
        font-size: .91rem;
        font-weight: 600;
        word-break: break-word;
    }


    /* =========================================================
           RENTAL SUMMARY
           ========================================================= */

    .rental-summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
    }


    .rental-summary-item {
        background: #F8FAFC;
        border: 1px solid var(--armtis-border);
        border-radius: 11px;
        padding: 14px;
        display: flex;
        align-items: center;
        gap: 11px;
    }


    .rental-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: var(--armtis-accent-light);
        color: var(--armtis-accent);
        display: grid;
        place-items: center;
        flex-shrink: 0;
    }


    .rental-summary-item strong {
        color: var(--armtis-primary);
        display: block;
        font-size: .9rem;
    }


    .rent-value {
        color: var(--armtis-accent) !important;
    }


    /* =========================================================
           UNIT
           ========================================================= */

    .unit-details-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px 28px;
    }


    .unit-number {
        color: var(--armtis-primary);
        font-weight: 700;
        font-size: 1rem;
    }


    .unit-status {
        display: inline-flex;
        align-items: center;
        width: fit-content;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 600;
    }


        .unit-status.occupied {
            color: #137A49;
            background: #E8F6EF;
        }


        .unit-status.other {
            color: #52606D;
            background: #EEF1F4;
        }


    /* =========================================================
           NOTE
           ========================================================= */

    .profile-note {
        background: var(--armtis-accent-light);
        border: 1px solid #BFE8E2;
        border-left: 4px solid var(--armtis-accent);
        border-radius: 10px;
        padding: 14px 16px;
        display: flex;
        align-items: flex-start;
        gap: 11px;
        color: #155E58;
    }


    .profile-note-icon {
        color: var(--armtis-accent);
        font-size: 1.1rem;
        margin-top: 1px;
    }


    .profile-note strong {
        font-size: .84rem;
    }


    .profile-note p {
        margin: 2px 0 0;
        font-size: .77rem;
    }
    /* =========================================================
       RENTAL AGREEMENT
       ========================================================= */

    .rental-agreement-upload-form {
        margin: 0;
    }

    .rental-agreement-upload-btn {
        display: inline-flex;
        align-items: center;
        padding: 7px 12px;
        background: var(--armtis-primary);
        color: white;
        border: 1px solid var(--armtis-primary);
        border-radius: 7px;
        font-size: .76rem;
        font-weight: 600;
        cursor: pointer;
        transition: all .18s ease;
    }

        .rental-agreement-upload-btn:hover {
            background: var(--armtis-primary-light);
            border-color: var(--armtis-primary-light);
        }

    .rental-agreement-preview {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 18px;
        background: #F5F7FA;
        border: 1px solid var(--armtis-border);
        border-radius: 12px;
        min-height: 220px;
    }

    /* =========================================================
       RENTAL AGREEMENT GALLERY
       ========================================================= */

    .rental-agreement-gallery {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
    }

    .rental-agreement-item {
        background: #F8FAFC;
        border: 1px solid var(--armtis-border);
        border-radius: 10px;
        padding: 10px;
        overflow: hidden;
    }


    /* FIXED IMAGE SIZE */

    .rental-agreement-image {
        display: block;
        width: 100%;
        height: 420px;
        object-fit: contain;
        background: #FFFFFF;
        border-radius: 7px;
        box-shadow: 0 3px 10px rgba(10,45,79,.08);
    }


    /* FILE NAME */

    .rental-agreement-page-label {
        padding: 8px 4px 2px;
        color: var(--armtis-muted);
        font-size: .72rem;
        text-align: center;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }


    /* RESPONSIVE */

    @@media (max-width: 991.98px) {

        .rental-agreement-gallery {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

