@page
@model ARMTIS_Capstone_Project.Pages.TenantPages.RentalProfileModel

@{
    ViewData["Title"] = "Rental Profile";

    var fullName = $"{Model.Tenant.FirstName} {Model.Tenant.LastName}";
}

<div class="rental-profile-page">

    <!-- ========================================= -->
    <!-- PAGE HEADER -->
    <!-- ========================================= -->

    <div class="profile-page-header">

        <div>
            <h2 class="profile-title">
                <i class="bi bi-person-vcard me-2"></i>
                Rental Profile
            </h2>

            <p class="profile-subtitle">
                Tenant rental and personal information
            </p>
        </div>

        <div class="profile-header-actions">

            <a asp-page="./Edit"
               asp-route-id="@Model.Tenant.TenantID"
               class="btn btn-primary">

                <i class="bi bi-pencil-square me-1"></i>
                Edit Profile

            </a>

            <a asp-page="./Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>
                Back

            </a>

        </div>

    </div>


    <!-- ========================================= -->
    <!-- TENANT PROFILE CARD -->
    <!-- ========================================= -->

    <div class="profile-main-card">

        <div class="profile-avatar">
            <i class="bi bi-person-fill"></i>
        </div>

        <div class="profile-main-info">

            <div class="profile-name-row">

                <h3>
                    @fullName
                </h3>

                @if (Model.Tenant.Status?.Equals(
                    "Active",
                    StringComparison.OrdinalIgnoreCase) == true)
                {
                    <span class="profile-status active">
                        <i class="bi bi-check-circle-fill me-1"></i>
                        Active
                    </span>
                }
                else
                {
                    <span class="profile-status inactive">
                        @Model.Tenant.Status
                    </span>
                }

            </div>

            <p class="profile-role">
                Tenant
                <span class="profile-separator">•</span>

                Unit @(Model.Tenant.Unit?.UnitNumber ?? "N/A")
            </p>

            <div class="profile-contact-row">

                <div class="profile-contact-item">

                    <i class="bi bi-telephone"></i>

                    <span>
                        @(string.IsNullOrWhiteSpace(Model.Tenant.ContactNo)
                            ? "No contact number"
                            : Model.Tenant.ContactNo)
                    </span>

                </div>


                <div class="profile-contact-item">

                    <i class="bi bi-envelope"></i>

                    <span>
                        @(string.IsNullOrWhiteSpace(Model.Tenant.Email)
                            ? "No email address"
                            : Model.Tenant.Email)
                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================= -->
    <!-- PERSONAL INFORMATION -->
    <!-- ========================================= -->

    <div class="profile-card">

        <div class="profile-card-header">

            <div>
                <h5>
                    <i class="bi bi-person me-2"></i>
                    Personal Information
                </h5>

                <small>
                    Basic tenant information
                </small>
            </div>

        </div>

        <div class="profile-card-body">

            <div class="info-grid">

                <div class="info-item">

                    <span class="info-label">
                        First Name
                    </span>

                    <span class="info-value">
                        @Model.Tenant.FirstName
                    </span>

                </div>


                <div class="info-item">

                    <span class="info-label">
                        Last Name
                    </span>

                    <span class="info-value">
                        @Model.Tenant.LastName
                    </span>

                </div>


                <div class="info-item">

                    <span class="info-label">
                        Contact Number
                    </span>

                    <span class="info-value">

                        @(string.IsNullOrWhiteSpace(Model.Tenant.ContactNo)
                            ? "N/A"
                            : Model.Tenant.ContactNo)

                    </span>

                </div>


                <div class="info-item">

                    <span class="info-label">
                        Email Address
                    </span>

                    <span class="info-value">

                        @(string.IsNullOrWhiteSpace(Model.Tenant.Email)
                            ? "N/A"
                            : Model.Tenant.Email)

                    </span>

                </div>


                <div class="info-item info-full">

                    <span class="info-label">
                        Current Address
                    </span>

                    <span class="info-value">

                        @(string.IsNullOrWhiteSpace(Model.Tenant.Address)
                            ? "N/A"
                            : Model.Tenant.Address)

                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================= -->
    <!-- RENTAL INFORMATION -->
    <!-- ========================================= -->

    <div class="profile-card">

        <div class="profile-card-header">

            <div>
                <h5>
                    <i class="bi bi-house-door me-2"></i>
                    Rental Information
                </h5>

                <small>
                    Lease and rental details
                </small>
            </div>

        </div>


        <div class="profile-card-body">

            <div class="rental-summary-grid">

                <!-- UNIT -->
                <div class="rental-summary-item">

                    <div class="rental-icon">
                        <i class="bi bi-house"></i>
                    </div>

                    <div>

                        <span class="info-label">
                            Unit
                        </span>

                        <strong>
                            @(Model.Tenant.Unit?.UnitNumber ?? "N/A")
                        </strong>

                    </div>

                </div>


                <!-- MONTHLY RENT -->
                <div class="rental-summary-item">

                    <div class="rental-icon">
                        <i class="bi bi-cash-stack"></i>
                    </div>

                    <div>

                        <span class="info-label">
                            Monthly Rent
                        </span>

                        <strong class="rent-value">

                            @if (Model.Tenant.Unit != null)
                            {
                                @($"₱{Model.Tenant.Unit.MonthlyRent:N2}")
                            }
                            else
                            {
                                @("N/A")
                            }

                        </strong>

                    </div>

                </div>


                <!-- LEASE START -->
                <div class="rental-summary-item">

                    <div class="rental-icon">
                        <i class="bi bi-calendar-check"></i>
                    </div>

                    <div>

                        <span class="info-label">
                            Lease Start
                        </span>

                        <strong>
                            @Model.Tenant.LeaseStartDate.ToString(
                                "MMM dd, yyyy")
                        </strong>

                    </div>

                </div>


                <!-- LEASE END -->
                <div class="rental-summary-item">

                    <div class="rental-icon">
                        <i class="bi bi-calendar-x"></i>
                    </div>

                    <div>

                        <span class="info-label">
                            Lease End
                        </span>

                        <strong>
                            @Model.Tenant.LeaseEndDate.ToString(
                                "MMM dd, yyyy")
                        </strong>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================= -->
    <!-- ASSIGNED UNIT -->
    <!-- ========================================= -->
    @if (Model.Tenant.Unit != null)
    {
        <div class="profile-card">

            <div class="profile-card-header">

                <div>
                    <h5>
                        <i class="bi bi-building me-2"></i>
                        Assigned Unit
                    </h5>

                    <small>
                        Information about the tenant's assigned unit
                    </small>
                </div>

            </div>


            <div class="profile-card-body">

                <div class="unit-details-grid">

                    <div class="info-item">

                        <span class="info-label">
                            Unit Number
                        </span>

                        <span class="unit-number">
                            @Model.Tenant.Unit.UnitNumber
                        </span>

                    </div>


                    <div class="info-item">

                        <span class="info-label">
                            Unit Status
                        </span>

                        @if (Model.Tenant.Unit.UnitStatus?.Equals(
                            "Occupied",
                            StringComparison.OrdinalIgnoreCase) == true)
                        {
                            <span class="unit-status occupied">
                                <i class="bi bi-check-circle-fill me-1"></i>
                                Occupied
                            </span>
                        }
                        else
                        {
                            <span class="unit-status other">
                                @Model.Tenant.Unit.UnitStatus
                            </span>
                        }

                    </div>


                    <div class="info-item">

                        <span class="info-label">
                            Capacity
                        </span>

                        <span class="info-value">
                            @Model.Tenant.Unit.Capacity person(s)
                        </span>

                    </div>


                    <div class="info-item info-full">

                        <span class="info-label">
                            Unit Description
                        </span>

                        <span class="info-value">

                            @(string.IsNullOrWhiteSpace(
                                Model.Tenant.Unit.Description)
                                ? "No description available."
                                : Model.Tenant.Unit.Description)

                        </span>

                    </div>

                </div>

            </div>

        </div>
    }


    <!-- ========================================= -->
    <!-- INFORMATION NOTE -->
    <!-- ========================================= -->

    <div class="profile-note">

        <div class="profile-note-icon">
            <i class="bi bi-info-circle-fill"></i>
        </div>

        <div>

            <strong>
                Rental Profile
            </strong>

            <p>
                This page displays the tenant's personal information,
                assigned unit, rental information, and lease details
                currently recorded in the system.
            </p>

        </div>

    </div>

</div>


<style>

    :root {
        --armtis-primary: #0A2D4F;
        --armtis-accent: #17B6A7;
        --armtis-bg: #F5F7FA;
        --armtis-border: #E3E8EE;
        --armtis-text: #1F2937;
        --armtis-muted: #6B7280;
    }


    /* ========================================= */
    /* PAGE */
    /* ========================================= */

    .rental-profile-page {
        background: var(--armtis-bg);
        min-height: calc(100vh - 80px);
        padding: 10px 4px 35px;
    }


    /* ========================================= */
    /* HEADER */
    /* ========================================= */

    .profile-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 24px;
    }


    .profile-title {
        color: var(--armtis-primary);
        font-weight: 700;
        margin-bottom: 4px;
    }


    .profile-subtitle {
        color: var(--armtis-muted);
        margin: 0;
        font-size: .9rem;
    }


    .profile-header-actions {
        display: flex;
        gap: 8px;
    }


    /* ========================================= */
    /* MAIN PROFILE */
    /* ========================================= */

    .profile-main-card {
        background: var(--armtis-primary);
        color: white;
        border-radius: 16px;
        padding: 24px;
        display: flex;
        align-items: center;
        gap: 18px;
        margin-bottom: 18px;
        box-shadow: 0 5px 15px rgba(10,45,79,.12);
    }


    .profile-avatar {
        width: 72px;
        height: 72px;
        min-width: 72px;
        border-radius: 50%;
        background: rgba(255,255,255,.13);
        border: 1px solid rgba(255,255,255,.25);
        display: grid;
        place-items: center;
        font-size: 2rem;
    }


    .profile-main-info {
        min-width: 0;
    }


    .profile-name-row {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }


        .profile-name-row h3 {
            margin: 0;
            font-weight: 700;
        }


    .profile-role {
        margin: 4px 0 12px;
        opacity: .78;
        font-size: .9rem;
    }


    .profile-separator {
        margin: 0 5px;
    }


    .profile-status {
        display: inline-flex;
        align-items: center;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 600;
    }


        .profile-status.active {
            background: rgba(23,182,167,.2);
            color: #BDF7F0;
        }


        .profile-status.inactive {
            background: rgba(255,255,255,.14);
            color: white;
        }


    .profile-contact-row {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
    }


    .profile-contact-item {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: .82rem;
        opacity: .9;
    }


    /* ========================================= */
    /* STANDARD CARDS */
    /* ========================================= */

    .profile-card {
        background: white;
        border: 1px solid var(--armtis-border);
        border-radius: 14px;
        overflow: hidden;
        margin-bottom: 18px;
        box-shadow: 0 2px 8px rgba(10,45,79,.04);
    }


    .profile-card-header {
        padding: 16px 20px;
        border-bottom: 1px solid var(--armtis-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }


        .profile-card-header h5 {
            color: var(--armtis-primary);
            font-weight: 700;
            margin: 0 0 3px;
        }


        .profile-card-header small {
            color: var(--armtis-muted);
            font-size: .78rem;
        }


    .profile-card-body {
        padding: 20px;
    }


    /* ========================================= */
    /* PERSONAL INFORMATION */
    /* ========================================= */

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px 28px;
    }


    .info-item {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }


    .info-full {
        grid-column: 1 / -1;
    }


    .info-label {
        color: var(--armtis-muted);
        font-size: .75rem;
        font-weight: 500;
    }


    .info-value {
        color: var(--armtis-text);
        font-size: .92rem;
        font-weight: 600;
        word-break: break-word;
    }


    /* ========================================= */
    /* RENTAL SUMMARY */
    /* ========================================= */

    .rental-summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
    }


    .rental-summary-item {
        background: #F8FAFC;
        border: 1px solid var(--armtis-border);
        border-radius: 11px;
        padding: 14px;
        display: flex;
        align-items: center;
        gap: 11px;
    }


    .rental-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: #EAF7F5;
        color: var(--armtis-accent);
        display: grid;
        place-items: center;
        flex-shrink: 0;
    }


    .rental-summary-item strong {
        color: var(--armtis-primary);
        display: block;
        font-size: .9rem;
    }


    .rent-value {
        color: #137A49 !important;
    }


    /* ========================================= */
    /* UNIT DETAILS */
    /* ========================================= */

    .unit-details-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px 28px;
    }


    .unit-number {
        color: var(--armtis-primary);
        font-weight: 700;
        font-size: 1rem;
    }


    .unit-status {
        display: inline-flex;
        align-items: center;
        width: fit-content;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 600;
    }


        .unit-status.occupied {
            color: #137A49;
            background: #E8F6EF;
        }


        .unit-status.other {
            color: #52606D;
            background: #EEF1F4;
        }


    /* ========================================= */
    /* INFORMATION NOTE */
    /* ========================================= */

    .profile-note {
        background: #EAF7F5;
        border: 1px solid #BEE8E3;
        border-radius: 12px;
        padding: 14px 16px;
        display: flex;
        align-items: flex-start;
        gap: 11px;
        color: #155E58;
    }


    .profile-note-icon {
        font-size: 1.1rem;
        margin-top: 1px;
    }


    .profile-note strong {
        font-size: .85rem;
    }


    .profile-note p {
        margin: 2px 0 0;
        font-size: .78rem;
    }


    /* ========================================= */
    /* BUTTONS */
    /* ========================================= */

    .profile-header-actions .btn-primary {
        background: var(--armtis-primary);
        border-color: var(--armtis-primary);
    }


        .profile-header-actions .btn-primary:hover {
            background: #071F36;
            border-color: #071F36;
        }


    /* ========================================= */
    /* RESPONSIVE */
    /* ========================================= */

    @@media (max-width: 991.98px) {

        .rental-summary-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .unit-details-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }


    @@media (max-width: 767.98px) {

        .profile-page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .profile-header-actions {
            width: 100%;
        }

            .profile-header-actions .btn {
                flex: 1;
            }

        .profile-main-card {
            align-items: flex-start;
        }

        .info-grid {
            grid-template-columns: 1fr;
        }

        .info-full {
            grid-column: auto;
        }
    }


    @@media (max-width: 575.98px) {

        .rental-profile-page {
            padding-left: 0;
            padding-right: 0;
        }

        .profile-main-card {
            padding: 18px;
        }

        .profile-avatar {
            width: 58px;
            height: 58px;
            min-width: 58px;
            font-size: 1.6rem;
        }

        .profile-name-row h3 {
            font-size: 1.25rem;
        }

        .rental-summary-grid {
            grid-template-columns: 1fr;
        }

        .unit-details-grid {
            grid-template-columns: 1fr;
        }
    }

</style>