@page
@model ARMTIS_Capstone_Project.Pages.TenantPages.Account.CreateModel

@{
    ViewData["Title"] = "Create Tenant Account";
}

<div class="tenant-account-page">

    
    <!-- PAGE HEADER -->
   

    <div class="account-page-header">

        <div>
            <h2 class="account-title">
                <i class="bi bi-person-plus-fill me-2"></i>
                Create Tenant Account
            </h2>

            <p class="account-subtitle">
                Create login credentials for an existing tenant.
            </p>
        </div>

        <a asp-page="/TenantPages/Account/Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Accounts

        </a>

    </div>


    
    <!-- MAIN CARD -->


    <div class="account-card">

        <!-- CARD HEADER -->

        <div class="account-card-header">

            <div class="header-icon">
                <i class="bi bi-shield-lock-fill"></i>
            </div>

            <div>

                <h5>
                    Tenant Login Account
                </h5>

                <small>
                    Link an existing tenant to a secure login account.
                </small>

            </div>

        </div>


        <!-- CARD BODY -->

        <div class="account-card-body">

            <form method="post">

               
                <!-- VALIDATION -->
           

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger validation-summary">
                </div>


      
                <!-- TENANT ACCOUNT SECTION -->
             

                <div class="form-section">

                    <div class="section-heading">

                        <div class="section-icon">
                            <i class="bi bi-person-vcard-fill"></i>
                        </div>

                        <div>
                            <h5>
                                Tenant Information
                            </h5>

                            <small>
                                Select the tenant who will receive this account.
                            </small>
                        </div>

                    </div>


                    <!-- TENANT -->

                    <div class="mb-4">

                        <label asp-for="Input.TenantID"
                               class="form-label custom-label">

                            Select Tenant
                            <span class="required-mark">*</span>

                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-person-check input-icon"></i>

                            <select asp-for="Input.TenantID"
                                    asp-items="Model.TenantList"
                                    class="form-select custom-input tenant-select">

                                <option value="">
                                    -- Select Tenant --
                                </option>

                            </select>

                        </div>

                        <span asp-validation-for="Input.TenantID"
                              class="text-danger">
                        </span>

                        <div class="form-help">
                            Select an existing tenant from the list.
                        </div>

                    </div>

                </div>


          
                <!-- LOGIN CREDENTIALS -->
               

                <div class="form-section credentials-section">

                    <div class="section-heading">

                        <div class="section-icon">
                            <i class="bi bi-key-fill"></i>
                        </div>

                        <div>
                            <h5>
                                Login Credentials
                            </h5>

                            <small>
                                Set the username and password for the tenant account.
                            </small>
                        </div>

                    </div>


                    <div class="row g-4">


                        <!-- USERNAME -->

                        <div class="col-12">

                            <label asp-for="Input.Username"
                                   class="form-label custom-label">

                                Username
                                <span class="required-mark">*</span>

                            </label>

                            <div class="input-wrapper">

                                <i class="bi bi-person input-icon"></i>

                                <input asp-for="Input.Username"
                                       class="form-control custom-input input-with-icon"
                                       placeholder="Enter username"
                                       autocomplete="username" />

                            </div>

                            <span asp-validation-for="Input.Username"
                                  class="text-danger">
                            </span>

                            <div class="form-help">
                                The tenant will use this username to sign in.
                            </div>

                        </div>


                        <!-- PASSWORD -->

                        <div class="col-md-6">

                            <label asp-for="Input.Password"
                                   class="form-label custom-label">

                                Password
                                <span class="required-mark">*</span>

                            </label>

                            <div class="input-wrapper">

                                <i class="bi bi-lock input-icon"></i>

                                <input asp-for="Input.Password"
                                       id="passwordInput"
                                       type="password"
                                       class="form-control custom-input input-with-icon"
                                       placeholder="Enter password"
                                       autocomplete="new-password" />

                                <button type="button"
                                        class="password-toggle"
                                        id="togglePassword"
                                        aria-label="Show password">

                                    <i class="bi bi-eye"
                                       id="passwordIcon">
                                    </i>

                                </button>

                            </div>

                            <span asp-validation-for="Input.Password"
                                  class="text-danger">
                            </span>

                            <div class="form-help">
                                Password must satisfy the system password requirements.
                            </div>

                        </div>


                        <!-- CONFIRM PASSWORD -->

                        <div class="col-md-6">

                            <label asp-for="Input.ConfirmPassword"
                                   class="form-label custom-label">

                                Confirm Password
                                <span class="required-mark">*</span>

                            </label>

                            <div class="input-wrapper">

                                <i class="bi bi-lock-fill input-icon"></i>

                                <input asp-for="Input.ConfirmPassword"
                                       id="confirmPasswordInput"
                                       type="password"
                                       class="form-control custom-input input-with-icon"
                                       placeholder="Confirm password"
                                       autocomplete="new-password" />

                                <button type="button"
                                        class="password-toggle"
                                        id="toggleConfirmPassword"
                                        aria-label="Show confirm password">

                                    <i class="bi bi-eye"
                                       id="confirmPasswordIcon">
                                    </i>

                                </button>

                            </div>

                            <span asp-validation-for="Input.ConfirmPassword"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </div>


           
                <!-- SECURITY NOTE -->
            

                <div class="security-note">

                    <div class="security-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>

                    <div>

                        <strong>
                            Account Security
                        </strong>

                        <p>
                            The tenant account will be associated with the selected
                            tenant and used to access the Tenant Portal.
                        </p>

                    </div>

                </div>


           
                <!-- FORM ACTIONS -->
          

                <div class="form-actions">

                    <a asp-page="/TenantPages/Account"
                       class="btn cancel-btn">

                        Cancel

                    </a>


                    <button type="submit"
                            class="btn create-account-btn">

                        <i class="bi bi-person-plus-fill me-1"></i>
                        Create Account

                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- ================================= -->
    <!-- REQUIRED NOTE -->
    <!-- ================================= -->

    <div class="account-note">

        <i class="bi bi-info-circle-fill"></i>

        <span>
            Fields marked with <strong>*</strong> are required.
        </span>

    </div>

</div>


<style>

    :root {
        --armtis-primary: #0A2D4F;
        --armtis-accent: #17B6A7;
        --armtis-bg: #F5F7FA;
        --armtis-border: #E3E8EE;
        --armtis-text: #1F2937;
        --armtis-muted: #6B7280;
    }


    /* ========================================= */
    /* PAGE */
    /* ========================================= */

    .tenant-account-page {
        background: var(--armtis-bg);
        min-height: calc(100vh - 80px);
        padding: 10px 4px 35px;
    }


    /* ========================================= */
    /* HEADER */
    /* ========================================= */

    .account-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 24px;
    }


    .account-title {
        color: var(--armtis-primary);
        font-weight: 700;
        margin-bottom: 4px;
    }


    .account-subtitle {
        color: var(--armtis-muted);
        margin: 0;
        font-size: .9rem;
    }


    /* ========================================= */
    /* MAIN CARD */
    /* ========================================= */

    .account-card {
        background: white;
        border: 1px solid var(--armtis-border);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 3px 10px rgba(10,45,79,.05);
    }


    .account-card-header {
        background: var(--armtis-primary);
        color: white;
        padding: 18px 22px;
        display: flex;
        align-items: center;
        gap: 14px;
    }


    .header-icon {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        background: rgba(23,182,167,.18);
        color: #72E0D5;
        display: grid;
        place-items: center;
        font-size: 1.3rem;
        flex-shrink: 0;
    }


    .account-card-header h5 {
        margin: 0 0 3px;
        font-weight: 700;
    }


    .account-card-header small {
        opacity: .75;
        font-size: .78rem;
    }


    .account-card-body {
        padding: 26px;
    }


    /* ========================================= */
    /* VALIDATION */
    /* ========================================= */

    .validation-summary:empty {
        display: none;
    }


    /* ========================================= */
    /* FORM SECTIONS */
    /* ========================================= */

    .form-section {
        padding-bottom: 26px;
    }


    .credentials-section {
        padding-top: 26px;
        border-top: 1px solid var(--armtis-border);
    }


    .section-heading {
        display: flex;
        align-items: center;
        gap: 11px;
        margin-bottom: 20px;
    }


    .section-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: #EAF7F5;
        color: var(--armtis-accent);
        display: grid;
        place-items: center;
        flex-shrink: 0;
    }


    .section-heading h5 {
        color: var(--armtis-primary);
        margin: 0 0 2px;
        font-weight: 700;
        font-size: 1rem;
    }


    .section-heading small {
        color: var(--armtis-muted);
        font-size: .77rem;
    }


    /* ========================================= */
    /* FORM LABELS */
    /* ========================================= */

    .custom-label {
        color: var(--armtis-text);
        font-size: .82rem;
        font-weight: 600;
        margin-bottom: 7px;
    }


    .required-mark {
        color: #DC3545;
        margin-left: 2px;
    }


    /* ========================================= */
    /* INPUTS */
    /* ========================================= */

    .input-wrapper {
        position: relative;
    }


    .input-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--armtis-muted);
        z-index: 2;
        pointer-events: none;
    }


    .custom-input {
        min-height: 43px;
        border: 1px solid #D6DDE5;
        border-radius: 9px;
        font-size: .88rem;
        box-shadow: none;
    }


    .input-with-icon {
        padding-left: 42px;
        padding-right: 42px;
    }


    .tenant-select {
        padding-left: 42px;
    }


    .custom-input:focus {
        border-color: var(--armtis-accent);
        box-shadow: 0 0 0 .2rem rgba(23,182,167,.12);
    }


    /* ========================================= */
    /* PASSWORD TOGGLE */
    /* ========================================= */

    .password-toggle {
        position: absolute;
        right: 9px;
        top: 50%;
        transform: translateY(-50%);
        border: 0;
        background: transparent;
        color: var(--armtis-muted);
        padding: 5px 7px;
        cursor: pointer;
        z-index: 3;
    }


        .password-toggle:hover {
            color: var(--armtis-primary);
        }


    /* ========================================= */
    /* HELP TEXT */
    /* ========================================= */

    .form-help {
        color: var(--armtis-muted);
        font-size: .72rem;
        margin-top: 5px;
    }


    .text-danger {
        font-size: .76rem;
    }


    /* ========================================= */
    /* SECURITY NOTE */
    /* ========================================= */

    .security-note {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        margin-top: 6px;
        padding: 13px 15px;
        border-radius: 10px;
        background: #EAF7F5;
        border: 1px solid #C8EBE7;
        color: #155E58;
    }


    .security-icon {
        color: var(--armtis-accent);
        font-size: 1.15rem;
        margin-top: 1px;
    }


    .security-note strong {
        display: block;
        font-size: .82rem;
        margin-bottom: 2px;
    }


    .security-note p {
        margin: 0;
        font-size: .75rem;
    }


    /* ========================================= */
    /* ACTIONS */
    /* ========================================= */

    .form-actions {
        border-top: 1px solid var(--armtis-border);
        margin-top: 24px;
        padding-top: 20px;
        display: flex;
        justify-content: flex-end;
        gap: 9px;
    }


    .create-account-btn {
        background: var(--armtis-primary);
        border: 1px solid var(--armtis-primary);
        color: white;
        border-radius: 8px;
        padding: 9px 18px;
        font-weight: 600;
    }


        .create-account-btn:hover {
            background: #071F36;
            border-color: #071F36;
            color: white;
        }


    .cancel-btn {
        background: white;
        color: var(--armtis-text);
        border: 1px solid #D6DDE5;
        border-radius: 8px;
        padding: 9px 18px;
    }


        .cancel-btn:hover {
            background: #F3F5F7;
        }


    /* ========================================= */
    /* INFO NOTE */
    /* ========================================= */

    .account-note {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-top: 14px;
        padding: 11px 14px;
        border-radius: 10px;
        background: #EAF7F5;
        border: 1px solid #C8EBE7;
        color: #155E58;
        font-size: .78rem;
    }


        .account-note i {
            color: var(--armtis-accent);
        }


    /* ========================================= */
    /* RESPONSIVE */
    /* ========================================= */

    @@media (max-width: 767.98px) {

        .tenant-account-page {
            padding-left: 0;
            padding-right: 0;
        }

        .account-page-header {
            flex-direction: column;
            align-items: flex-start;
        }

            .account-page-header .btn {
                width: 100%;
            }

        .account-card-body {
            padding: 20px;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

            .form-actions .btn {
                width: 100%;
            }
    }

</style>


<script>

    // =========================================
    // PASSWORD TOGGLE
    // =========================================

    const passwordInput =
        document.getElementById("passwordInput");

    const togglePassword =
        document.getElementById("togglePassword");

    const passwordIcon =
        document.getElementById("passwordIcon");


    if (
        passwordInput &&
        togglePassword &&
        passwordIcon
    ) {

        togglePassword.addEventListener(
            "click",
            function() {

                const isPassword =
                    passwordInput.type === "password";

                passwordInput.type =
                    isPassword
                        ? "text"
                        : "password";

                passwordIcon.className =
                    isPassword
                        ? "bi bi-eye-slash"
                        : "bi bi-eye";

                togglePassword.setAttribute(
                    "aria-label",
                    isPassword
                        ? "Hide password"
                        : "Show password"
                );

            }
        );

    }


    // =========================================
    // CONFIRM PASSWORD TOGGLE
    // =========================================

    const confirmPasswordInput =
        document.getElementById(
            "confirmPasswordInput"
        );

    const toggleConfirmPassword =
        document.getElementById(
            "toggleConfirmPassword"
        );

    const confirmPasswordIcon =
        document.getElementById(
            "confirmPasswordIcon"
        );


    if (
        confirmPasswordInput &&
        toggleConfirmPassword &&
        confirmPasswordIcon
    ) {

        toggleConfirmPassword.addEventListener(
            "click",
            function() {

                const isPassword =
                    confirmPasswordInput.type === "password";

                confirmPasswordInput.type =
                    isPassword
                        ? "text"
                        : "password";

                confirmPasswordIcon.className =
                    isPassword
                        ? "bi bi-eye-slash"
                        : "bi bi-eye";

                toggleConfirmPassword.setAttribute(
                    "aria-label",
                    isPassword
                        ? "Hide confirm password"
                        : "Show confirm password"
                );

            }
        );

    }

</script>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}