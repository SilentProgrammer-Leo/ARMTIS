@page
@model ARMTIS_Capstone_Project.Pages.TenantPages.EditModel

@{
    ViewData["Title"] = "Edit Tenant";
}

<div class="tenant-edit-page">

    <!-- ========================================= -->
    <!-- PAGE HEADER -->
    <!-- ========================================= -->

    <div class="edit-header">

        <div>
            <h2 class="edit-title">
                <i class="bi bi-person-gear me-2"></i>
                Edit Tenant
            </h2>

            <p class="edit-subtitle">
                Update the tenant's personal and rental information.
            </p>
        </div>

        <a asp-page="./Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Tenants

        </a>

    </div>


    <!-- ========================================= -->
    <!-- MAIN CARD -->
    <!-- ========================================= -->

    <div class="edit-card">

        <!-- CARD HEADER -->

        <div class="edit-card-header">

            <div class="header-icon">
                <i class="bi bi-person-vcard-fill"></i>
            </div>

            <div>

                <h5>
                    Tenant Information
                </h5>

                <small>
                    Make the necessary changes and save the updated information.
                </small>

            </div>

        </div>


        <!-- CARD BODY -->

        <div class="edit-card-body">

            <form method="post">

                <!-- TENANT ID -->

                <input type="hidden"
                       asp-for="Tenant.TenantID" />


                <!-- VALIDATION -->

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger validation-summary">
                </div>


                <!-- ===================================== -->
                <!-- PERSONAL INFORMATION -->
                <!-- ===================================== -->

                <div class="form-section">

                    <div class="section-heading">

                        <div class="section-icon">
                            <i class="bi bi-person-fill"></i>
                        </div>

                        <div>

                            <h5>
                                Personal Information
                            </h5>

                            <small>
                                Update the tenant's basic information.
                            </small>

                        </div>

                    </div>


                    <div class="row g-4">

                        <!-- FIRST NAME -->

                        <div class="col-md-6">

                            <label asp-for="Tenant.FirstName"
                                   class="form-label custom-label">

                                First Name
                                <span class="required-mark">*</span>

                            </label>

                            <input asp-for="Tenant.FirstName"
                                   class="form-control custom-input"
                                   aria-required="true" />

                            <span asp-validation-for="Tenant.FirstName"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- LAST NAME -->

                        <div class="col-md-6">

                            <label asp-for="Tenant.LastName"
                                   class="form-label custom-label">

                                Last Name
                                <span class="required-mark">*</span>

                            </label>

                            <input asp-for="Tenant.LastName"
                                   class="form-control custom-input"
                                   aria-required="true" />

                            <span asp-validation-for="Tenant.LastName"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ADDRESS -->

                        <div class="col-12">

                            <label asp-for="Tenant.Address"
                                   class="form-label custom-label">

                                Current Address

                            </label>

                            <textarea asp-for="Tenant.Address"
                                      class="form-control custom-input"
                                      rows="3">
                            </textarea>

                            <span asp-validation-for="Tenant.Address"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- CONTACT -->

                        <div class="col-md-6">

                            <label asp-for="Tenant.ContactNo"
                                   class="form-label custom-label">

                                Contact Number

                            </label>

                            <input asp-for="Tenant.ContactNo"
                                   class="form-control custom-input" />

                            <span asp-validation-for="Tenant.ContactNo"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- EMAIL -->

                        <div class="col-md-6">

                            <label asp-for="Tenant.Email"
                                   class="form-label custom-label">

                                Email Address

                            </label>

                            <input asp-for="Tenant.Email"
                                   type="email"
                                   class="form-control custom-input" />

                            <span asp-validation-for="Tenant.Email"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- STATUS -->

                        <div class="col-md-6">

                            <label asp-for="Tenant.Status"
                                   class="form-label custom-label">

                                Tenant Status

                            </label>

                            <select asp-for="Tenant.Status"
                                    class="form-select custom-input">

                                <option value="">
                                    -- Select Status --
                                </option>

                                <option value="Active">
                                    Active
                                </option>

                                <option value="Inactive">
                                    Inactive
                                </option>

                            </select>

                            <span asp-validation-for="Tenant.Status"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </div>


                <!-- ===================================== -->
                <!-- LEASE INFORMATION -->
                <!-- ===================================== -->

                <div class="form-section lease-section">

                    <div class="section-heading">

                        <div class="section-icon">
                            <i class="bi bi-calendar-range-fill"></i>
                        </div>

                        <div>

                            <h5>
                                Lease Information
                            </h5>

                            <small>
                                Update the tenant's lease period and assigned unit.
                            </small>

                        </div>

                    </div>


                    <div class="row g-4">

                        <!-- LEASE START -->

                        <div class="col-md-6">

                            <label asp-for="Tenant.LeaseStartDate"
                                   class="form-label custom-label">

                                Lease Start Date
                                <span class="required-mark">*</span>

                            </label>

                            <input asp-for="Tenant.LeaseStartDate"
                                   type="date"
                                   class="form-control custom-input" />

                            <span asp-validation-for="Tenant.LeaseStartDate"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- LEASE END -->

                        <div class="col-md-6">

                            <label asp-for="Tenant.LeaseEndDate"
                                   class="form-label custom-label">

                                Lease End Date
                                <span class="required-mark">*</span>

                            </label>

                            <input asp-for="Tenant.LeaseEndDate"
                                   type="date"
                                   class="form-control custom-input" />

                            <span asp-validation-for="Tenant.LeaseEndDate"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- UNIT ID -->

                        <div class="col-md-6">

                            <label asp-for="Tenant.UnitID"
                                   class="form-label custom-label">

                                Assigned Unit
                                <span class="required-mark">*</span>

                            </label>

                            <div class="input-group">

                                <span class="input-group-text unit-addon">
                                    <i class="bi bi-house-door"></i>
                                </span>

                                <input asp-for="Tenant.UnitID"
                                       type="number"
                                       min="1"
                                       class="form-control custom-input unit-input" />

                            </div>

                            <span asp-validation-for="Tenant.UnitID"
                                  class="text-danger">
                            </span>

                            <div class="form-help">
                                Enter the Unit ID assigned to this tenant.
                            </div>

                        </div>

                    </div>

                </div>


                <!-- ===================================== -->
                <!-- UPDATE NOTE -->
                <!-- ===================================== -->

                <div class="update-note">

                    <div class="note-icon">
                        <i class="bi bi-info-circle-fill"></i>
                    </div>

                    <div>

                        <strong>
                            Updating Tenant Information
                        </strong>

                        <p>
                            Changes made here will update the tenant's
                            current information and rental record.
                        </p>

                    </div>

                </div>


                <!-- ===================================== -->
                <!-- FORM ACTIONS -->
                <!-- ===================================== -->

                <div class="form-actions">

                    <a asp-page="./Index"
                       class="btn cancel-btn">

                        Cancel

                    </a>


                    <button type="submit"
                            class="btn save-btn">

                        <i class="bi bi-check2-circle me-1"></i>
                        Save Changes

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<style>

    :root {
        --armtis-primary: #0A2D4F;
        --armtis-accent: #17B6A7;
        --armtis-bg: #F5F7FA;
        --armtis-border: #E3E8EE;
        --armtis-text: #1F2937;
        --armtis-muted: #6B7280;
    }


    /* ========================================= */
    /* PAGE */
    /* ========================================= */

    .tenant-edit-page {
        background: var(--armtis-bg);
        min-height: calc(100vh - 80px);
        padding: 10px 4px 35px;
    }


    /* ========================================= */
    /* HEADER */
    /* ========================================= */

    .edit-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 24px;
    }


    .edit-title {
        color: var(--armtis-primary);
        font-weight: 700;
        margin-bottom: 4px;
    }


    .edit-subtitle {
        color: var(--armtis-muted);
        margin: 0;
        font-size: .9rem;
    }


    /* ========================================= */
    /* MAIN CARD */
    /* ========================================= */

    .edit-card {
        background: white;
        border: 1px solid var(--armtis-border);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 3px 10px rgba(10,45,79,.05);
    }


    /* ========================================= */
    /* CARD HEADER */
    /* ========================================= */

    .edit-card-header {
        background: var(--armtis-primary);
        color: white;
        padding: 18px 22px;
        display: flex;
        align-items: center;
        gap: 14px;
    }


    .header-icon {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        background: rgba(23,182,167,.18);
        color: #72E0D5;
        display: grid;
        place-items: center;
        font-size: 1.3rem;
        flex-shrink: 0;
    }


    .edit-card-header h5 {
        margin: 0 0 3px;
        font-weight: 700;
    }


    .edit-card-header small {
        opacity: .75;
        font-size: .78rem;
    }


    /* ========================================= */
    /* CARD BODY */
    /* ========================================= */

    .edit-card-body {
        padding: 26px;
    }


    /* ========================================= */
    /* VALIDATION */
    /* ========================================= */

    .validation-summary:empty {
        display: none;
    }


    /* ========================================= */
    /* FORM SECTION */
    /* ========================================= */

    .form-section {
        padding-bottom: 26px;
    }


    .lease-section {
        padding-top: 26px;
        border-top: 1px solid var(--armtis-border);
    }


    .section-heading {
        display: flex;
        align-items: center;
        gap: 11px;
        margin-bottom: 20px;
    }


    .section-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: #EAF7F5;
        color: var(--armtis-accent);
        display: grid;
        place-items: center;
        flex-shrink: 0;
    }


    .section-heading h5 {
        color: var(--armtis-primary);
        margin: 0 0 2px;
        font-weight: 700;
        font-size: 1rem;
    }


    .section-heading small {
        color: var(--armtis-muted);
        font-size: .77rem;
    }


    /* ========================================= */
    /* LABELS */
    /* ========================================= */

    .custom-label {
        color: var(--armtis-text);
        font-size: .82rem;
        font-weight: 600;
        margin-bottom: 7px;
    }


    .required-mark {
        color: #DC3545;
        margin-left: 2px;
    }


    /* ========================================= */
    /* INPUTS */
    /* ========================================= */

    .custom-input {
        border: 1px solid #D6DDE5;
        border-radius: 9px;
        min-height: 43px;
        font-size: .88rem;
        box-shadow: none;
    }


    textarea.custom-input {
        min-height: 90px;
        resize: vertical;
    }


    .custom-input:focus {
        border-color: var(--armtis-accent);
        box-shadow: 0 0 0 .2rem rgba(23,182,167,.12);
    }


    /* ========================================= */
    /* UNIT */
    /* ========================================= */

    .unit-addon {
        background: #F8FAFC;
        border-color: #D6DDE5;
        color: var(--armtis-accent);
        border-radius: 9px 0 0 9px;
    }


    .unit-input {
        border-radius: 0 9px 9px 0;
    }


    /* ========================================= */
    /* HELP */
    /* ========================================= */

    .form-help {
        color: var(--armtis-muted);
        font-size: .72rem;
        margin-top: 5px;
    }


    .text-danger {
        font-size: .76rem;
    }


    /* ========================================= */
    /* UPDATE NOTE */
    /* ========================================= */

    .update-note {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        padding: 13px 15px;
        border-radius: 10px;
        background: #EAF7F5;
        border: 1px solid #C8EBE7;
        color: #155E58;
    }


    .note-icon {
        color: var(--armtis-accent);
        font-size: 1.1rem;
        margin-top: 1px;
    }


    .update-note strong {
        display: block;
        font-size: .82rem;
        margin-bottom: 2px;
    }


    .update-note p {
        margin: 0;
        font-size: .75rem;
    }


    /* ========================================= */
    /* ACTIONS */
    /* ========================================= */

    .form-actions {
        border-top: 1px solid var(--armtis-border);
        margin-top: 24px;
        padding-top: 20px;
        display: flex;
        justify-content: flex-end;
        gap: 9px;
    }


    .save-btn {
        background: var(--armtis-primary);
        color: white;
        border: 1px solid var(--armtis-primary);
        border-radius: 8px;
        padding: 9px 18px;
        font-weight: 600;
    }


        .save-btn:hover {
            background: #071F36;
            border-color: #071F36;
            color: white;
        }


    .cancel-btn {
        background: white;
        color: var(--armtis-text);
        border: 1px solid #D6DDE5;
        border-radius: 8px;
        padding: 9px 18px;
    }


        .cancel-btn:hover {
            background: #F3F5F7;
            color: var(--armtis-text);
        }


    /* ========================================= */
    /* RESPONSIVE */
    /* ========================================= */

    @@media (max-width: 767.98px) {

        .tenant-edit-page {
            padding-left: 0;
            padding-right: 0;
        }

        .edit-header {
            flex-direction: column;
            align-items: flex-start;
        }

            .edit-header .btn {
                width: 100%;
            }

        .edit-card-body {
            padding: 20px;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

            .form-actions .btn {
                width: 100%;
            }
    }

</style>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}