@page
@model ARMTIS_Capstone_Project.Pages.Settings.IndexModel

@{
    ViewData["Title"] = "Apartment Information";
}

<div class="container-fluid px-0">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1"
                style="color:#0A2D4F;">

                <i class="bi bi-building me-2"
                   style="color:#17B6A7;">
                </i>

                Apartment Information

            </h2>

            <p class="text-muted mb-0">
                Manage the basic information and contact details of your apartment property.
            </p>
        </div>

    </div>


    <!-- SUCCESS MESSAGE -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- INFORMATION CARD -->
    <div class="card border-0 shadow-sm apartment-info-card">

        <!-- CARD HEADER -->
        <div class="card-header text-white apartment-info-header">

            <div class="d-flex align-items-center">

                <div class="apartment-header-icon me-3">

                    <i class="bi bi-buildings"></i>

                </div>

                <div>

                    <h5 class="mb-1 fw-semibold" style="color:white">
                        Property Information
                    </h5>

                    <small class="text-white-50">
                        Keep your apartment information up to date.
                    </small>

                </div>

            </div>

        </div>


        <!-- CARD BODY -->
        <div class="card-body p-4">

            <form method="post">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert">
                </div>


                <!-- BASIC INFORMATION -->
                <div class="section-heading">

                    <div class="d-flex align-items-center">

                        <div class="section-icon">
                            <i class="bi bi-building"></i>
                        </div>

                        <div>
                            <h6 class="fw-bold mb-1"
                                style="color:#0A2D4F;">

                                Basic Information

                            </h6>

                            <small class="text-muted">
                                General information about your apartment property.
                            </small>
                        </div>

                    </div>

                </div>


                <div class="row g-4 mb-4">

                    <!-- PROPERTY NAME -->
                    <div class="col-md-6">

                        <label asp-for="SystemSetting.PropertyName"
                               class="form-label fw-semibold">

                            Property Name

                        </label>

                        <div class="input-group">

                            <span class="input-group-text apartment-input-icon">
                                <i class="bi bi-buildings"></i>
                            </span>

                            <input asp-for="SystemSetting.PropertyName"
                                   class="form-control"
                                   placeholder="Enter property name" />

                        </div>

                        <span asp-validation-for="SystemSetting.PropertyName"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- CONTACT NUMBER -->
                    <div class="col-md-6">

                        <label asp-for="SystemSetting.ContactNumber"
                               class="form-label fw-semibold">

                            Contact Number

                        </label>

                        <div class="input-group">

                            <span class="input-group-text apartment-input-icon">
                                <i class="bi bi-telephone"></i>
                            </span>

                            <input asp-for="SystemSetting.ContactNumber"
                                   class="form-control"
                                   placeholder="Enter contact number" />

                        </div>

                        <span asp-validation-for="SystemSetting.ContactNumber"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- ADDRESS -->
                    <div class="col-12">

                        <label asp-for="SystemSetting.PropertyAddress"
                               class="form-label fw-semibold">

                            Property Address

                        </label>

                        <div class="input-group">

                            <span class="input-group-text apartment-input-icon align-items-start pt-2">
                                <i class="bi bi-geo-alt"></i>
                            </span>

                            <textarea asp-for="SystemSetting.PropertyAddress"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Enter complete property address"></textarea>

                        </div>

                        <span asp-validation-for="SystemSetting.PropertyAddress"
                              class="text-danger small">
                        </span>

                    </div>

                </div>


                <!-- CONTACT INFORMATION -->
                <div class="section-heading">

                    <div class="d-flex align-items-center">

                        <div class="section-icon contact-section-icon">
                            <i class="bi bi-headset"></i>
                        </div>

                        <div>
                            <h6 class="fw-bold mb-1"
                                style="color:#0A2D4F;">

                                Contact Information

                            </h6>

                            <small class="text-muted">
                                Information tenants can use to contact the property.
                            </small>
                        </div>

                    </div>

                </div>


                <div class="row g-4 mb-4">

                    <!-- EMAIL -->
                    <div class="col-md-6">

                        <label asp-for="SystemSetting.Email"
                               class="form-label fw-semibold">

                            Email Address

                        </label>

                        <div class="input-group">

                            <span class="input-group-text apartment-input-icon">
                                <i class="bi bi-envelope"></i>
                            </span>

                            <input asp-for="SystemSetting.Email"
                                   type="email"
                                   class="form-control"
                                   placeholder="Enter email address" />

                        </div>

                        <span asp-validation-for="SystemSetting.Email"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- CONTACT DISPLAY -->
                    <div class="col-md-6">

                        <div class="information-note h-100">

                            <div class="d-flex align-items-start">

                                <i class="bi bi-info-circle-fill me-2 mt-1"></i>

                                <div>

                                    <strong>
                                        Keep information current
                                    </strong>

                                    <p class="small mb-0 mt-1">
                                        Updated contact information helps tenants
                                        reach the property administrator when needed.
                                    </p>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- DESCRIPTION -->
                <div class="section-heading">

                    <div class="d-flex align-items-center">

                        <div class="section-icon description-section-icon">
                            <i class="bi bi-card-text"></i>
                        </div>

                        <div>
                            <h6 class="fw-bold mb-1"
                                style="color:#0A2D4F;">

                                Property Description

                            </h6>

                            <small class="text-muted">
                                Add a short description of the apartment property.
                            </small>
                        </div>

                    </div>

                </div>


                <div class="mb-4">

                    <label asp-for="SystemSetting.Description"
                           class="form-label fw-semibold">

                        Description

                    </label>

                    <textarea asp-for="SystemSetting.Description"
                              class="form-control"
                              rows="5"
                              placeholder="Enter a short description about the property"></textarea>

                    <span asp-validation-for="SystemSetting.Description"
                          class="text-danger small">
                    </span>

                </div>


                <!-- ACTIONS -->
                <div class="d-flex justify-content-end pt-4 border-top">

                    <button type="submit"
                            class="btn text-white px-4"
                            style="background:#0A2D4F;">

                        <i class="bi bi-check-circle me-1"></i>
                        Save Changes

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<style>

    .apartment-info-card {
        border-radius: 14px;
        overflow: hidden;
    }

    .apartment-info-header {
        background: #0A2D4F;
        border-bottom: 3px solid #17B6A7;
        padding: 16px 20px;
    }

    .apartment-header-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(23, 182, 167, 0.16);
        color: #17B6A7;
        font-size: 1.1rem;
    }

    .section-heading {
        padding-bottom: 12px;
        margin-bottom: 22px;
        border-bottom: 1px solid #edf0f3;
    }

    .section-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eaf7f5;
        color: #17B6A7;
        margin-right: 12px;
    }

    .contact-section-icon {
        background: #e7f4ff;
        color: #1473a3;
    }

    .description-section-icon {
        background: #efeafd;
        color: #6750a4;
    }

    .apartment-input-icon {
        background: #f8fafb;
        color: #17B6A7;
        border-color: #dfe5ea;
    }

    .information-note {
        padding: 14px 16px;
        border-radius: 10px;
        background: #f3f9ff;
        border: 1px solid #d7e9f7;
        color: #315d77;
        display: flex;
        align-items: center;
    }

        .information-note i {
            color: #1473a3;
        }

    .form-control,
    .form-select,
    .input-group-text {
        border-color: #dfe5ea;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #17B6A7;
            box-shadow: 0 0 0 0.2rem rgba(23, 182, 167, 0.12);
        }

    @@media (max-width: 768px) {

        .apartment-info-card {
            border-radius: 10px;
        }
    }

</style>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}