@page
@model ARMTIS_Capstone_Project.Pages.Settings.IndexModel

@{
    ViewData["Title"] = "System Settings";
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">
                <i class="bi bi-gear-fill me-2"></i>
                System Settings
            </h1>

            <p class="text-muted mb-0">
                Manage the basic information of your apartment rental system.
            </p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <div class="card shadow-sm border-0">

        <div class="card-header bg-dark text-white py-3">
            <h5 class="mb-0">
                <i class="bi bi-building me-2"></i>
                Property Information
            </h5>
        </div>

        <div class="card-body p-4">

            <form method="post">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <div class="row g-4">

                    <!-- PROPERTY NAME -->
                    <div class="col-md-6">
                        <label asp-for="SystemSetting.PropertyName"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="SystemSetting.PropertyName"
                               class="form-control"
                               placeholder="Enter property name" />

                        <span asp-validation-for="SystemSetting.PropertyName"
                              class="text-danger">
                        </span>
                    </div>

                    <!-- CONTACT NUMBER -->
                    <div class="col-md-6">
                        <label asp-for="SystemSetting.ContactNumber"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="SystemSetting.ContactNumber"
                               class="form-control"
                               placeholder="Enter contact number" />

                        <span asp-validation-for="SystemSetting.ContactNumber"
                              class="text-danger">
                        </span>
                    </div>

                    <!-- ADDRESS -->
                    <div class="col-12">
                        <label asp-for="SystemSetting.PropertyAddress"
                               class="form-label fw-semibold">
                        </label>

                        <textarea asp-for="SystemSetting.PropertyAddress"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Enter complete property address">
                        </textarea>

                        <span asp-validation-for="SystemSetting.PropertyAddress"
                              class="text-danger">
                        </span>
                    </div>

                    <!-- EMAIL -->
                    <div class="col-md-6">
                        <label asp-for="SystemSetting.Email"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="SystemSetting.Email"
                               type="email"
                               class="form-control"
                               placeholder="Enter email address" />

                        <span asp-validation-for="SystemSetting.Email"
                              class="text-danger">
                        </span>
                    </div>

                    <!-- DESCRIPTION -->
                    <div class="col-12">
                        <label asp-for="SystemSetting.Description"
                               class="form-label fw-semibold">
                        </label>

                        <textarea asp-for="SystemSetting.Description"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Enter a short description about the property">
                        </textarea>

                        <span asp-validation-for="SystemSetting.Description"
                              class="text-danger">
                        </span>
                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end">

                    <button type="submit"
                            class="btn btn-primary px-4">
                        <i class="bi bi-save me-2"></i>
                        Save Changes
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}