@page
@model ARMTIS_Capstone_Project.Pages.UnitPages.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Unit</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Unit.UnitID" />
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Unit.UnitNumber" class="control-label"></label>
                <input asp-for="Unit.UnitNumber" class="form-control" aria-required="true"/>
                <span asp-validation-for="Unit.UnitNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Unit.Description" class="control-label"></label>
                <input asp-for="Unit.Description" class="form-control" />
                <span asp-validation-for="Unit.Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Unit.MonthlyRent" class="control-label"></label>
                <input asp-for="Unit.MonthlyRent" class="form-control" />
                <span asp-validation-for="Unit.MonthlyRent" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Unit.UnitStatus" class="control-label"></label>
                <input asp-for="Unit.UnitStatus" class="form-control" />
                <span asp-validation-for="Unit.UnitStatus" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Unit.Capacity" class="control-label"></label>
                <input asp-for="Unit.Capacity" class="form-control" />
                <span asp-validation-for="Unit.Capacity" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Unit.Tenants" class="control-label"></label>
                <input asp-for="Unit.Tenants" class="form-control" />
                <span asp-validation-for="Unit.Tenants" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
