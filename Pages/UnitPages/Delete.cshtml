@page
@model ARMTIS_Capstone_Project.Pages.UnitPages.DeleteModel

@{
    ViewData["Title"] = "Delete Unit";
}

<div class="unit-delete-page">

    <!-- PAGE HEADER -->
    <div class="page-header">

        <div class="page-header-left">

            <div class="page-icon">
                <i class="bi bi-trash3-fill"></i>
            </div>

            <div>
                <h2 class="page-title">
                    Delete Unit
                </h2>

                <p class="page-subtitle">
                    Review the unit information before confirming deletion.
                </p>
            </div>

        </div>

        <a asp-page="./Index"
           class="btn btn-back">

            <i class="bi bi-arrow-left"></i>
            Back to Units

        </a>

    </div>


    <!-- WARNING -->
    <div class="delete-warning">

        <div class="warning-icon">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>

        <div>
            <div class="warning-title">
                Confirm Unit Deletion
            </div>

            <div class="warning-text">
                Are you sure you want to delete this unit? This action may affect
                associated records and cannot be easily undone.
            </div>
        </div>

    </div>


    <!-- UNIT DETAILS CARD -->
    <div class="unit-card">

        <div class="unit-card-header">

            <div class="header-icon">
                <i class="bi bi-building-fill"></i>
            </div>

            <div>
                <h5 class="header-title">
                    Unit Information
                </h5>

                <p class="header-description">
                    Details of the unit selected for deletion.
                </p>
            </div>

        </div>


        <div class="unit-card-body">

            <div class="unit-details">

                <!-- UNIT NUMBER -->
                <div class="detail-item">

                    <div class="detail-icon">
                        <i class="bi bi-door-open-fill"></i>
                    </div>

                    <div class="detail-content">

                        <span class="detail-label">
                            Unit Number
                        </span>

                        <span class="detail-value">
                            @Html.DisplayFor(model => model.Unit.UnitNumber)
                        </span>

                    </div>

                </div>


                <!-- DESCRIPTION -->
                <div class="detail-item">

                    <div class="detail-icon">
                        <i class="bi bi-card-text"></i>
                    </div>

                    <div class="detail-content">

                        <span class="detail-label">
                            Description
                        </span>

                        <span class="detail-value">
                            @(string.IsNullOrWhiteSpace(Model.Unit.Description)
                                ? "No description provided"
                                : Model.Unit.Description)
                        </span>

                    </div>

                </div>


                <!-- MONTHLY RENT -->
                <div class="detail-item">

                    <div class="detail-icon">
                        <i class="bi bi-cash-stack"></i>
                    </div>

                    <div class="detail-content">

                        <span class="detail-label">
                            Monthly Rent
                        </span>

                        <span class="detail-value rent-value">
                            @Model.Unit.MonthlyRent.ToString("N2")
                        </span>

                    </div>

                </div>


                <!-- STATUS -->
                <div class="detail-item">

                    <div class="detail-icon">
                        <i class="bi bi-circle-fill"></i>
                    </div>

                    <div class="detail-content">

                        <span class="detail-label">
                            Unit Status
                        </span>

                        <span class="status-badge
                            @(Model.Unit.UnitStatus?.ToLower() == "occupied"
                                ? "status-occupied"
                                : "status-vacant")">

                            <i class="bi bi-circle-fill"></i>

                            @Model.Unit.UnitStatus

                        </span>

                    </div>

                </div>


                <!-- CAPACITY -->
                <div class="detail-item">

                    <div class="detail-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>

                    <div class="detail-content">

                        <span class="detail-label">
                            Capacity
                        </span>

                        <span class="detail-value">
                            @Model.Unit.Capacity tenant(s)
                        </span>

                    </div>

                </div>


                <!-- TENANTS -->
                <div class="detail-item">

                    <div class="detail-icon">
                        <i class="bi bi-person-vcard-fill"></i>
                    </div>

                    <div class="detail-content">

                        <span class="detail-label">
                            Assigned Tenants
                        </span>

                        <span class="detail-value">
                            @(Model.Unit.Tenants?.Count() ?? 0) tenant(s)
                        </span>

                    </div>

                </div>

            </div>


            <!-- DELETE FORM -->
            <form method="post"
                  class="delete-form">

                <input type="hidden"
                       asp-for="Unit.UnitID" />

                <div class="delete-divider"></div>

                <div class="delete-actions">

                    <a asp-page="./Index"
                       class="btn btn-cancel-delete">

                        <i class="bi bi-x-circle"></i>
                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-delete-unit">

                        <i class="bi bi-trash3-fill"></i>
                        Delete Unit

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<style>

    /* =========================================
       PAGE
       ========================================= */

    .unit-delete-page {
        padding: 4px 0 30px;
    }


    /* =========================================
       HEADER
       ========================================= */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 24px;
    }

    .page-header-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .page-icon {
        width: 52px;
        height: 52px;
        border-radius: 12px;
        background: #EAF1F7;
        color: #0A2D4F;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }

    .page-title {
        margin: 0 0 3px;
        color: #0A2D4F;
        font-size: 25px;
        font-weight: 700;
    }

    .page-subtitle {
        margin: 0;
        color: #718096;
        font-size: 14px;
    }

    .btn-back {
        background: #fff;
        color: #0A2D4F;
        border: 1px solid #D7E0E8;
        border-radius: 8px;
        padding: 9px 15px;
        font-size: 14px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        transition: all .2s ease;
    }

    .btn-back:hover {
        background: #F4F7FA;
        color: #0A2D4F;
        border-color: #C2CDD7;
    }


    /* =========================================
       WARNING
       ========================================= */

    .delete-warning {
        display: flex;
        align-items: flex-start;
        gap: 13px;
        padding: 16px 18px;
        margin-bottom: 20px;
        background: #FFF8E8;
        border: 1px solid #F1D58A;
        border-radius: 10px;
    }

    .warning-icon {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        background: #FFF0C7;
        color: #A56A00;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 16px;
    }

    .warning-title {
        color: #7A5200;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 3px;
    }

    .warning-text {
        color: #866B30;
        font-size: 13px;
        line-height: 1.5;
    }


    /* =========================================
       MAIN CARD
       ========================================= */

    .unit-card {
        background: #fff;
        border: 1px solid #E1E8EE;
        border-radius: 13px;
        overflow: hidden;
        box-shadow: 0 4px 14px rgba(10, 45, 79, .06);
    }

    .unit-card-header {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 20px 24px;
        background: #FBFCFD;
        border-bottom: 1px solid #E7EDF2;
    }

    .header-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: #E7F7F5;
        color: #17B6A7;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
    }

    .header-title {
        margin: 0;
        color: #0A2D4F;
        font-size: 16px;
        font-weight: 700;
    }

    .header-description {
        margin: 3px 0 0;
        color: #7A8794;
        font-size: 13px;
    }

    .unit-card-body {
        padding: 24px;
    }


    /* =========================================
       DETAILS
       ========================================= */

    .unit-details {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 15px;
    }

    .detail-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 16px;
        background: #F8FAFC;
        border: 1px solid #E5EBF0;
        border-radius: 9px;
        min-height: 78px;
    }

    .detail-icon {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        background: #EAF1F7;
        color: #0A2D4F;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 15px;
    }

    .detail-content {
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 0;
    }

    .detail-label {
        color: #7B8794;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .3px;
    }

    .detail-value {
        color: #243B53;
        font-size: 14px;
        font-weight: 600;
        word-break: break-word;
    }

    .rent-value {
        color: #0A2D4F;
        font-size: 15px;
    }


    /* =========================================
       STATUS
       ========================================= */

    .status-badge {
        width: fit-content;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .status-badge i {
        font-size: 7px;
    }

    .status-occupied {
        background: #FFF2F2;
        color: #C0392B;
    }

    .status-vacant {
        background: #E7F7F5;
        color: #168F83;
    }


    /* =========================================
       ACTIONS
       ========================================= */

    .delete-divider {
        height: 1px;
        background: #E7EDF2;
        margin: 24px 0 18px;
    }

    .delete-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
    }

    .btn-cancel-delete,
    .btn-delete-unit {
        min-height: 42px;
        padding: 9px 17px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        transition: all .2s ease;
    }

    .btn-cancel-delete {
        background: #fff;
        color: #52616F;
        border: 1px solid #D5DEE6;
    }

    .btn-cancel-delete:hover {
        background: #F5F7F9;
        color: #243B53;
        border-color: #C5D0D9;
    }

    .btn-delete-unit {
        background: #C0392B;
        color: #fff;
        border: 1px solid #C0392B;
    }

    .btn-delete-unit:hover {
        background: #A93226;
        color: #fff;
        border-color: #A93226;
    }


    /* =========================================
       RESPONSIVE
       ========================================= */

    @@media (max-width: 768px) {

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .btn-back {
            width: 100%;
            justify-content: center;
        }

        .unit-card-header {
            padding: 18px;
        }

        .unit-card-body {
            padding: 18px;
        }

        .unit-details {
            grid-template-columns: 1fr;
        }

    }


    @@media (max-width: 576px) {

        .page-title {
            font-size: 21px;
        }

        .page-subtitle {
            font-size: 13px;
        }

        .page-icon {
            width: 46px;
            height: 46px;
            font-size: 19px;
        }

        .delete-actions {
            flex-direction: column-reverse;
        }

        .btn-cancel-delete,
        .btn-delete-unit {
            width: 100%;
        }

    }

</style>